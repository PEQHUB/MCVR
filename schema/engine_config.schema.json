{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radser.dev/schema/engine_config.schema.json",
  "title": "RadSER Engine Configuration",
  "description": "Single source of truth for all engine options. Generates C++ structs, Java classes, and JNI bridge code.",
  "type": "object",
  "x-version": 23,
  "x-properties-file": "options.properties",

  "properties": {

    "display": {
      "type": "object",
      "x-category": "options.video.category.window",
      "x-order": 0,
      "properties": {
        "vsync": {
          "type": "boolean",
          "default": true,
          "x-ui-control": "toggle",
          "x-restart-scope": "pipeline",
          "x-runtime-scope": "frame",
          "x-doc": "Vertical sync - caps framerate to display refresh rate",
          "x-cpp-side-effect": "needRecreate = true"
        },
        "maxFps": {
          "type": "integer",
          "default": 260,
          "minimum": 10,
          "maximum": 1000,
          "x-ui-control": "slider",
          "x-step": 10,
          "x-restart-scope": "none",
          "x-runtime-scope": "frame",
          "x-doc": "Maximum framerate limit",
          "x-cpp-side-effect": "reflexDirty = true"
        },
        "inactivityFpsLimit": {
          "type": "integer",
          "default": 260,
          "minimum": 10,
          "maximum": 1000,
          "x-ui-control": "slider",
          "x-step": 10,
          "x-restart-scope": "none",
          "x-runtime-scope": "frame",
          "x-doc": "Framerate limit when window is unfocused"
        },
        "outputScale2x": {
          "type": "boolean",
          "default": false,
          "x-ui-control": "toggle",
          "x-restart-scope": "pipeline",
          "x-runtime-scope": "session",
          "x-doc": "Render at 2x display resolution (screenshot mode)",
          "x-cpp-side-effect": "needRecreate = true"
        }
      }
    },

    "upscaler": {
      "type": "object",
      "x-category": "options.video.category.upscaler",
      "x-order": 1,
      "properties": {
        "upscalerMode": {
          "type": "integer",
          "default": 0,
          "x-enum": {
            "0": "DLSS-RR",
            "1": "FSR3",
            "2": "Off"
          },
          "x-ui-control": "dropdown",
          "x-restart-scope": "pipeline",
          "x-runtime-scope": "session",
          "x-doc": "Upscaler / denoiser backend",
          "x-cpp-side-effect": "needRecreate = true"
        },
        "upscalerQuality": {
          "type": "integer",
          "default": 2,
          "x-enum": {
            "0": "Performance",
            "1": "Balanced",
            "2": "Quality",
            "3": "Native / DLAA",
            "4": "Custom"
          },
          "x-ui-control": "dropdown",
          "x-restart-scope": "pipeline",
          "x-runtime-scope": "session",
          "x-doc": "Upscaler quality preset (affects internal resolution)",
          "x-cpp-side-effect": "needRecreate = true"
        },
        "upscalerResOverride": {
          "type": "integer",
          "default": 99,
          "minimum": 33,
          "maximum": 100,
          "x-ui-control": "slider",
          "x-step": 1,
          "x-unit": "%",
          "x-restart-scope": "pipeline",
          "x-runtime-scope": "session",
          "x-doc": "Manual resolution scale override (only when quality = Custom)",
          "x-cpp-side-effect": "needRecreate = true"
        },
        "dlssQuality": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 4,
          "x-enum": {
            "0": "DLAA",
            "1": "Quality",
            "2": "Balanced",
            "3": "Performance",
            "4": "Ultra Performance"
          },
          "x-ui-control": "dropdown",
          "x-restart-scope": "pipeline",
          "x-runtime-scope": "session",
          "x-doc": "DLSS quality mode (affects render resolution)",
          "x-cpp-side-effect": "needRecreate = true"
        }
      }
