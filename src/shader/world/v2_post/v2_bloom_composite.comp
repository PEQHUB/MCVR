#version 450

// Composite: reads half-res bloom + full-res original, applies Gaussian blur on
// the bloom during upsample, then additively blends with the original.
// Each thread handles one output pixel.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D r_original;
layout(set = 0, binding = 1) uniform sampler2D r_bloom;
layout(set = 0, binding = 2, rgba16) uniform writeonly image2D rw_output;

layout(push_constant) uniform BloomPushConstant {
    float threshold;
    float intensity;
    vec2 bloomTexelSize;   // 1.0 / bloomResolution
} pc;

void main() {
    ivec2 outPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(rw_output);
    if (outPos.x >= outSize.x || outPos.y >= outSize.y) return;

    vec2 uv = (vec2(outPos) + 0.5) / vec2(outSize);

    // Read original
    vec3 original = texture(r_original, uv).rgb;

    // 9-tap tent filter for smooth upsampling of bloom
    // This provides a nice Gaussian-like blur during the upsample
    vec2 bloomUV = uv;  // same UV since sampler does bilinear
    vec2 t = pc.bloomTexelSize;

    vec3 bloom = vec3(0.0);
    bloom += texture(r_bloom, bloomUV + vec2(-t.x, -t.y)).rgb * 1.0;
    bloom += texture(r_bloom, bloomUV + vec2( 0.0, -t.y)).rgb * 2.0;
    bloom += texture(r_bloom, bloomUV + vec2( t.x, -t.y)).rgb * 1.0;
    bloom += texture(r_bloom, bloomUV + vec2(-t.x,  0.0)).rgb * 2.0;
    bloom += texture(r_bloom, bloomUV + vec2( 0.0,  0.0)).rgb * 4.0;
    bloom += texture(r_bloom, bloomUV + vec2( t.x,  0.0)).rgb * 2.0;
    bloom += texture(r_bloom, bloomUV + vec2(-t.x,  t.y)).rgb * 1.0;
    bloom += texture(r_bloom, bloomUV + vec2( 0.0,  t.y)).rgb * 2.0;
    bloom += texture(r_bloom, bloomUV + vec2( t.x,  t.y)).rgb * 1.0;
    bloom /= 16.0;

    // Additive blend
    vec3 result = original + bloom * pc.intensity;
    result = clamp(result, 0.0, 1.0);

    imageStore(rw_output, outPos, vec4(result, 1.0));
}
