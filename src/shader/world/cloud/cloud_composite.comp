#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D uRadiance;
layout(set = 0, binding = 1, r32f)    uniform readonly image2D uLinearDepth;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D uCloudRadiance;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D uCloudColor;

#include "cloud_common.glsl"

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= int(pc.renderWidth) || texel.y >= int(pc.renderHeight)) return;

    vec4 scene = imageLoad(uRadiance, texel);

    // Nearest-neighbor sample from cloud resolution to render resolution
    ivec2 cloudTexel = clamp(
        ivec2(vec2(texel) * vec2(pc.cloudWidth, pc.cloudHeight) / vec2(pc.renderWidth, pc.renderHeight)),
        ivec2(0), ivec2(pc.cloudWidth - 1, pc.cloudHeight - 1));
    vec4 cloud = imageLoad(uCloudColor, cloudTexel);

    // cloud.rgb = scattered light, cloud.a = transmittance
    // Front-to-back compositing: result = cloud_color + scene * transmittance.
    // Guard: when transmittance ≈ 0 (fully opaque cloud), skip scene multiply
    // to avoid NaN from INF * 0 (sky pixels store extreme radiance values).
    vec3 result;
    if (cloud.a > 0.001) {
        result = cloud.rgb + scene.rgb * cloud.a;
    } else {
        result = cloud.rgb;
    }

    imageStore(uCloudRadiance, texel, vec4(result, 1.0));
}
