#version 460
#extension GL_GOOGLE_include_directive : require

// Cloud weather map generator.
// Generates a 256x256 RGBA8 weather map each frame.
// R: coverage (Voronoi cell-based isolated patches)
// G: cloud type [0,1] mapped to 4 types (see cloud_density.glsl cloudHeightGradient):
//    0.0=stratus, 0.33=stratocumulus, 0.67=cumulus, 1.0=cumulonimbus
// B: precipitation (for future use)
// A: reserved
//
// Architecture: Each Voronoi cell represents one convective thermal / updraft.
// Coverage is high at cell centers, fading to zero at cell edges.
// The coverage push constant controls what fraction of cells produce clouds:
//   0.0 = clear sky (no cells active)
//   0.3 = scattered fair-weather cumulus (isolated puffs)
//   0.5 = half-sky coverage as distinct towers
//   0.8 = broken overcast (cells nearly touching)
//   1.0 = total overcast

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 5, rgba8) uniform writeonly image2D uWeatherMap;

#include "cloud_common.glsl"

// --- Noise primitives ---

vec3 hash33w(vec3 p) {
    p = vec3(dot(p, vec3(127.1, 311.7, 74.7)),
             dot(p, vec3(269.5, 183.3, 246.1)),
             dot(p, vec3(113.5, 271.9, 124.6)));
    return fract(sin(p) * 43758.5453123);
}

vec2 hash22w(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(.1031, .1030, .0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.xx + p3.yz) * p3.zy);
}

float hash12w(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float gradNoise2D(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);

    float a = dot(hash33w(vec3(i, 0.0)).xy * 2.0 - 1.0, f);
    float b = dot(hash33w(vec3(i + vec2(1, 0), 0.0)).xy * 2.0 - 1.0, f - vec2(1, 0));
    float c = dot(hash33w(vec3(i + vec2(0, 1), 0.0)).xy * 2.0 - 1.0, f - vec2(0, 1));
    float d = dot(hash33w(vec3(i + vec2(1, 1), 0.0)).xy * 2.0 - 1.0, f - vec2(1, 1));

    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 0.5 + 0.5;
}

float fbm2D(vec2 p, int octaves) {
    float value = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < octaves; i++) {
        value += amp * gradNoise2D(p * freq);
        amp *= 0.5;
        freq *= 2.0;
    }
    return value;
}

// --- Voronoi with cell ID + distance ---
// Returns: x = distance to nearest cell center (normalized ~[0,1])
//          y = distance to second-nearest center
//          zw = cell ID (integer coords of the owning cell)
vec4 voronoi2D(vec2 p) {
    vec2 cell = floor(p);
    vec2 frac_ = fract(p);

    float d1 = 8.0;  // nearest distance
    float d2 = 8.0;  // second nearest
    vec2 cellID = vec2(0.0);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 neighbor = vec2(float(x), float(y));
            vec2 point = hash22w(cell + neighbor);
            vec2 diff = neighbor + point - frac_;
            float d = dot(diff, diff);
            if (d < d1) {
                d2 = d1;
                d1 = d;
                cellID = cell + neighbor;
            } else if (d < d2) {
                d2 = d;
            }
        }
    }

    return vec4(sqrt(d1), sqrt(d2), cellID);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(256)))) return;

    vec2 uv = (vec2(texel) + 0.5) / 256.0;

    // Convert texel to absolute world position (weather map is camera-centered, 1024 blocks)
    vec3 eyePos = getEyePos();
    vec2 worldXZ = eyePos.xz + (uv - 0.5) * 1024.0;

    // World-space UV for noise: NO wind drift. Weather map defines WHERE clouds form
    // (semi-permanent like a satellite photo). Wind only moves 3D noise shapes.
    // Slow evolution via time-varying domain warp gives natural forming/dissipating.
    vec2 worldUV = worldXZ / 1024.0;

    // --- Domain warping: breaks Voronoi grid regularity into organic shapes ---
    float evolveTime = pc.windTime * 0.0001; // Very slow evolution (minutes)
    vec2 warp1 = vec2(
        gradNoise2D(worldUV * 2.0 + vec2(evolveTime, 3.7)),
        gradNoise2D(worldUV * 2.0 + vec2(5.2, evolveTime + 1.3))
    );
    // Second octave of warp for finer distortion
    vec2 warp2 = vec2(
        gradNoise2D(worldUV * 5.0 + warp1 * 2.0 + vec2(11.1, 7.3)),
        gradNoise2D(worldUV * 5.0 + warp1 * 2.0 + vec2(3.9, 13.7))
    );
    vec2 warpedUV = worldUV + warp1 * 0.3 + warp2 * 0.1;

    // --- Voronoi cellular placement ---
    // Frequency ~4 cells across the 1024-block weather map = ~256 blocks per cell.
    // Each cell is one convective thermal / cloud tower.
    float cellFreq = pc.cellFrequency;
    vec4 vor = voronoi2D(warpedUV * cellFreq);
    float distToCenter = vor.x;   // [0, ~0.7] distance to nearest cell center
    vec2 cellID = vor.zw;         // Integer cell ID for per-cell randomness

    // Per-cell random value: determines if this cell "has a cloud"
    // This gives each cell an independent probability, so coverage controls
    // the fraction of cells that are active, not a global threshold.
    float cellRand = hash12w(cellID * 17.31 + vec2(7.19, 13.37));

    // --- Minecraft weather integration ---
    float rain = smoothstep(0.0, 1.0, skyUBO.rainGradient);
    float thunder = smoothstep(0.0, 1.0, skyUBO.thunderGradient);

    // Effective coverage: clear → overcast (rain), near-total (thunder)
    float rainCoverage = mix(pc.coverage, 0.85, rain);
    float baseCoverage = mix(rainCoverage, 0.95, thunder);

    // --- Cell activation ---
    // A cell is "active" (has a cloud) if its random value < coverage.
    // At coverage=0.5, ~half the cells produce clouds → isolated towers.
    // At coverage=1.0, all cells are active → continuous overcast.
    // We use a soft transition instead of a hard cutoff for smooth weather changes.
    //
    // The activation ramp maps cellRand vs baseCoverage:
    //   cellRand << baseCoverage → fully active (1.0)
    //   cellRand ~= baseCoverage → partially active (fading edge)
    //   cellRand >> baseCoverage → inactive (0.0)
    float activationEdge = 0.15; // Width of the soft transition band
    float cellActive = smoothstep(baseCoverage + activationEdge, baseCoverage - activationEdge, cellRand);

    // Smooth cell boundaries: fade coverage to zero near Voronoi edges
    float edgeProximity = smoothstep(0.0, 0.12, vor.y - vor.x);
    cellActive *= edgeProximity;

    // --- Radial falloff within each cell ---
    // Coverage is highest at cell center, fading toward cell edges.
    // This is what creates the "isolated tower" shape in the weather map.
    //
    // The falloff radius controls how much of each cell is filled:
    //   Small radius → tight isolated puffs
    //   Large radius → cells nearly fill their Voronoi region
    // Scale with coverage so high coverage makes fatter clouds that merge.
    float cellRadius = mix(0.25, 0.50, baseCoverage);

    // Normalized distance: 0 at center, 1 at the falloff edge
    float radialFalloff = 1.0 - smoothstep(0.0, cellRadius, distToCenter);

    // Add organic irregularity to the cell shape using small-scale FBM.
    // This breaks the circular symmetry into cauliflower-like irregular edges.
    float edgeNoise = fbm2D(warpedUV * cellFreq * 3.0 + cellID * 5.3, 3);
    // Modulate the falloff edge: push it in or out by up to 30%
    float noisyRadius = cellRadius * (0.7 + edgeNoise * 0.6);
    float noisyFalloff = 1.0 - smoothstep(0.0, noisyRadius, distToCenter);

    // Blend: mostly noisy shape, with a guaranteed core from the clean radial
    float cellShape = mix(noisyFalloff, radialFalloff, 0.3);

    // Final coverage for this texel: cell must be active AND within falloff radius
    float coverage = cellActive * cellShape;

    // During rain/thunder, fill gaps between cells for overcast effect
    // Use second-nearest distance to create inter-cell fill
    float gapFill = rain * 0.6 + thunder * 0.3;
    if (gapFill > 0.0) {
        float fillNoise = fbm2D(warpedUV * 6.0, 2);
        float fill = fillNoise * gapFill;
        coverage = max(coverage, fill);
    }

    coverage = clamp(coverage, 0.0, 1.0);

    // --- Cloud type ---
    // Per-cell FBM noise gives ±0.33 variation around pc.cloudType.
    // At default 0.67, produces types spanning ~0.34-1.0 (stratocumulus→cumulonimbus).
    // Coverage-dependent bias: isolated cells → taller (cumulus/cb),
    // merged overcast → flatter (stratus/sc). Meteorologically accurate.
    float typeNoise = fbm2D(worldUV * 1.5 + vec2(7.31, 13.17), 2);
    float typeVariation = (typeNoise - 0.5) * 0.66; // ±0.33 range
    float coverageBias = mix(0.1, -0.15, coverage); // Isolated→tall, merged→flat
    float clearType = clamp(pc.cloudType + typeVariation + coverageBias, 0.0, 1.0);

    // Rain: push toward stratus (flat overcast). Thunder: push toward cumulonimbus.
    float rainType = mix(clearType, 0.0, rain);
    float type = mix(rainType, 1.0, thunder);
    type = clamp(type, 0.0, 1.0);

    // Precipitation intensity
    float precipitation = rain * coverage;

    imageStore(uWeatherMap, texel, vec4(coverage, type, precipitation, 1.0));
}
