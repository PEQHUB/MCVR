#version 460
#extension GL_GOOGLE_include_directive : require

// Cloud weather map generator.
// Generates a 256x256 RGBA8 weather map each frame.
// R: coverage (modulated by rainGradient + cellular Worley placement)
// G: cloud type [0,1] mapped to 4 types (see cloud_density.glsl cloudHeightGradient):
//    0.0=stratus, 0.33=stratocumulus, 0.67=cumulus, 1.0=cumulonimbus
// B: precipitation (for future use)
// A: reserved

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 5, rgba8) uniform writeonly image2D uWeatherMap;

#include "cloud_common.glsl"

// Simple hash-based noise for weather map
vec3 hash33w(vec3 p) {
    p = vec3(dot(p, vec3(127.1, 311.7, 74.7)),
             dot(p, vec3(269.5, 183.3, 246.1)),
             dot(p, vec3(113.5, 271.9, 124.6)));
    return fract(sin(p) * 43758.5453123);
}

vec2 hash22w(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(.1031, .1030, .0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.xx + p3.yz) * p3.zy);
}

float gradNoise2D(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);

    float a = dot(hash33w(vec3(i, 0.0)).xy * 2.0 - 1.0, f);
    float b = dot(hash33w(vec3(i + vec2(1, 0), 0.0)).xy * 2.0 - 1.0, f - vec2(1, 0));
    float c = dot(hash33w(vec3(i + vec2(0, 1), 0.0)).xy * 2.0 - 1.0, f - vec2(0, 1));
    float d = dot(hash33w(vec3(i + vec2(1, 1), 0.0)).xy * 2.0 - 1.0, f - vec2(1, 1));

    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 0.5 + 0.5;
}

float fbm2D(vec2 p, int octaves) {
    float value = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < octaves; i++) {
        value += amp * gradNoise2D(p * freq);
        amp *= 0.5;
        freq *= 2.0;
    }
    return value;
}

// Worley (cellular) noise for distinct cloud placement
float worley2D(vec2 p) {
    vec2 cell = floor(p);
    vec2 frac_ = fract(p);
    float minDist = 1.0;

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 neighbor = vec2(float(x), float(y));
            vec2 point = hash22w(cell + neighbor);
            vec2 diff = neighbor + point - frac_;
            minDist = min(minDist, dot(diff, diff));
        }
    }
    return sqrt(minDist);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(256)))) return;

    // No clouds in Nether/End
    if (skyUBO.skyType != 0) {
        imageStore(uWeatherMap, texel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2 uv = (vec2(texel) + 0.5) / 256.0;

    // Wind-driven UV offset (slowly drifting weather patterns)
    vec2 windUV = uv + vec2(pc.windTime * 0.01, pc.windTime * 0.003);

    // Cellular structure: Worley noise creates distinct cloud clusters
    // Scale 2.5 gives ~4-6 cloud formations across the 1024-block coverage area
    float cellDist = worley2D(windUV * 2.5);
    // Invert: cloud centers at cell points, gaps between
    float cellMask = 1.0 - smoothstep(0.0, 0.55, cellDist);

    // Low-frequency FBM for soft variation within cells
    float coverageNoise = fbm2D(windUV * 3.0, 4);

    // --- Minecraft weather integration ---
    // rainGradient: 0=clear → 1=raining (smooth ~1s transition)
    // thunderGradient: 0=no thunder → 1=thunderstorm (smooth ~1s transition)
    // Both smoothly interpolated by Minecraft each tick.
    // Smoothstep for gradual buildup: first 50% of gradient = slow increase, last 50% = rapid
    float rain = smoothstep(0.0, 1.0, skyUBO.rainGradient);
    float thunder = smoothstep(0.0, 1.0, skyUBO.thunderGradient);

    // Coverage: clear → overcast (rain), near-total (thunder)
    float rainCoverage = mix(pc.coverage, 0.80, rain);
    float baseCoverage = mix(rainCoverage, 0.90, thunder);

    // Combine: cellular placement × FBM variation
    // Clear: cells dominate (distinct clouds). Rain: cells merge. Thunder: full overcast.
    float cellInfluence = mix(0.8, 0.2, rain);
    cellInfluence = mix(cellInfluence, 0.05, thunder); // Thunder nearly fills gaps
    float coverage = baseCoverage * mix(1.0, cellMask, cellInfluence);
    coverage += (coverageNoise - 0.5) * 0.2 * (1.0 - rain * 0.5);
    coverage = clamp(coverage, 0.0, 1.0);

    // Edge sharpness: sharp in clear, soft in rain, moderate in thunder (towering edges)
    float sharpness = mix(0.15, 0.4, rain);
    sharpness = mix(sharpness, 0.25, thunder); // Thunder has moderate sharpness (tower edges)
    coverage = smoothstep(sharpness, sharpness + 0.15, coverage);

    // Cloud type: meteorologically accurate transitions.
    // Type mapping: 0=stratus, 0.33=stratocumulus, 0.67=cumulus, 1.0=cumulonimbus
    // Clear: user-selected type (pc.cloudType, default 0.67 = cumulus)
    // Rain: stratus overcast (type = 0.0 = lowest, flattest cloud)
    // Thunder: cumulonimbus towers (type = 1.0 = full-height storm)
    float rainType = mix(pc.cloudType, 0.0, rain);      // Rain → stratus
    float type = mix(rainType, 1.0, thunder);            // Thunder → cumulonimbus

    // Precipitation intensity
    float precipitation = rain * coverage;

    imageStore(uWeatherMap, texel, vec4(coverage, type, precipitation, 1.0));
}
