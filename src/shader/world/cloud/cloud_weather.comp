#version 460
#extension GL_GOOGLE_include_directive : require

// Cloud weather map generator [Schneider15, Nubis 2017].
// Generates a 512x512 RGBA8 weather map each frame.
//
// Channels [Schneider15 slide 40, Nubis 2017 slide 56]:
//   R: coverage — multi-octave Perlin noise [Nubis 2017: "Perlin noise in the red channel"]
//   G: cloud type [0,1] — separate low-freq noise [Nubis 2017 slide 59]
//   B: precipitation (for future use)
//   A: reserved
//
// The weather map and 3D noise texture are INDEPENDENT.
// Weather map = WHERE clouds exist (2D coverage footprint).
// 3D noise = HOW clouds look (density variation within the coverage area).
// The density function combines them: coverage acts as erosion threshold on 3D noise FBM.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 5, rgba8) uniform writeonly image2D uWeatherMap;

#include "cloud_common.glsl"

// --- Noise primitives ---

vec3 hash33w(vec3 p) {
    p = vec3(dot(p, vec3(127.1, 311.7, 74.7)),
             dot(p, vec3(269.5, 183.3, 246.1)),
             dot(p, vec3(113.5, 271.9, 124.6)));
    return fract(sin(p) * 43758.5453123);
}

float gradNoise2D(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = dot(hash33w(vec3(i, 0.0)).xy * 2.0 - 1.0, f);
    float b = dot(hash33w(vec3(i + vec2(1, 0), 0.0)).xy * 2.0 - 1.0, f - vec2(1, 0));
    float c = dot(hash33w(vec3(i + vec2(0, 1), 0.0)).xy * 2.0 - 1.0, f - vec2(0, 1));
    float d = dot(hash33w(vec3(i + vec2(1, 1), 0.0)).xy * 2.0 - 1.0, f - vec2(1, 1));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 0.5 + 0.5;
}

float fbm2D(vec2 p, int octaves) {
    float value = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < octaves; i++) {
        value += amp * gradNoise2D(p * freq);
        amp *= 0.5;
        freq *= 2.0;
    }
    return value;
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(512)))) return;

    vec2 uv = (vec2(texel) + 0.5) / 512.0;

    // World position — snapped origin prevents frame drift (B5 fix)
    vec2 snappedEye = getSnappedEyeXZ();
    vec2 worldXZ = snappedEye + (uv - 0.5) * WEATHER_EXTENT;

    // Slow wind drift for weather evolution
    float evolveTime = pc.windTime * 0.0001;
    float s = sin(pc.windAngle);
    float c = cos(pc.windAngle);
    vec2 windDrift = vec2(evolveTime * c, evolveTime * s);

    // --- Minecraft weather integration ---
    float rain = smoothstep(0.0, 1.0, skyUBO.rainGradient);
    float thunder = smoothstep(0.0, 1.0, skyUBO.thunderGradient);
    float rainCoverage = mix(pc.coverage, 0.85, rain);
    float effCoverage = mix(rainCoverage, 0.95, thunder);

    // --- Coverage: multi-octave Perlin [Schneider15, Nubis 2017 slide 56] ---
    // pc.cellFrequency ("Weather Scale") controls cloud formation size.
    // 512x512 map over 4000 blocks = 7.8 blocks/texel, Nyquist = 0.064.
    // 3 octaves: max freq = baseFreq*4. Safe when baseFreq < 0.016 (cellFreq < 16).
    float baseFreq = clamp(pc.cellFrequency * 0.001, 0.002, 0.016);

    // Domain warping breaks noise regularity into organic shapes (2 octaves)
    vec2 warpOffset = vec2(
        fbm2D(worldXZ * baseFreq * 0.5 + windDrift + vec2(3.7, 11.1), 2),
        fbm2D(worldXZ * baseFreq * 0.5 + windDrift + vec2(7.3, 5.2), 2)
    );
    vec2 warpedPos = worldXZ + warpOffset * (1.0 / baseFreq) * 0.25;

    // Base coverage: large-scale cloud masses (3 octaves)
    float baseCoverage = fbm2D(warpedPos * baseFreq + windDrift, 3);

    // Detail coverage: edge complexity (2 octaves at 3x base freq)
    float detailCoverage = fbm2D(warpedPos * baseFreq * 3.0 + windDrift * 1.3 + vec2(42.7, 13.3), 2);

    // Combine: 70% base shape, 30% edge detail
    float rawCoverage = baseCoverage * 0.7 + detailCoverage * 0.3;

    // Schneider coverage remap [Nubis 2017 slide 40]:
    //   coverage = remap(noise, threshold, 1.0, 0.0, 1.0)
    // Higher effCoverage → lower threshold → more sky covered.
    float threshold = 1.0 - effCoverage;
    float coverage = clamp((rawCoverage - threshold) / max(1.0 - threshold, 0.001), 0.0, 1.0);

    // Edge fade at weather map boundary
    vec2 edgeDist = min(uv, 1.0 - uv);
    float edgeFade = smoothstep(0.0, 0.08, min(edgeDist.x, edgeDist.y));
    coverage *= edgeFade;

    coverage = clamp(coverage, 0.0, 1.0);

    // --- Cloud type [Nubis 2017 slide 59] ---
    // Separate low-frequency noise, uncorrelated with coverage.
    float typeNoise = fbm2D(worldXZ * baseFreq * 0.3 + vec2(7.31, 13.17), 2);
    float typeVariation = (typeNoise - 0.5) * 0.6;

    // Coverage-dependent bias: isolated → taller, merged → flatter
    float coverageBias = mix(0.1, -0.15, coverage);
    float clearType = clamp(pc.cloudType + typeVariation + coverageBias, 0.0, 1.0);

    // Rain → stratus, thunder → cumulonimbus
    float rainType = mix(clearType, 0.0, rain);
    float type = mix(rainType, 1.0, thunder);
    type = clamp(type, 0.0, 1.0);

    // Precipitation intensity
    float precipitation = rain * coverage;

    imageStore(uWeatherMap, texel, vec4(coverage, type, precipitation, 1.0));
}
