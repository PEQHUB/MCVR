#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Core volumetric cloud ray march. [Schneider15 §4, Hillaire16 §4.6]
// Dispatched at cloud resolution (quarter/half/full).
// Output: RGBA16F cloud color (rgb) + transmittance (a).

layout(local_size_x = 8, local_size_y = 8) in;

// Set 0: images
layout(set = 0, binding = 1, r32f)     uniform readonly image2D uLinearDepth;
layout(set = 0, binding = 3, rgba16f)  uniform writeonly image2D uCloudColor;
layout(set = 0, binding = 6)           uniform sampler3D uNoise3D;         // 128^3 RGBA8 repeat
layout(set = 0, binding = 8)           uniform sampler2D uWeatherMap;      // 256x256 RGBA8

#define CLOUD_HAS_WEATHER_SAMPLER
#include "cloud_common.glsl"
#include "cloud_density.glsl"

// March clamp: fixed geometric limit to prevent horizontal slab artifacts when
// camera is inside the cloud layer. Independent of atmospheric fade.
// Atmospheric fade: exponential extinction driven by pc.atmosphereFadeDist (default 800).
const float MARCH_CLAMP = 200.0;

// Per-pixel hash for spatial variation (no external buffer needed)
float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// Frame-varying hash jitter: golden ratio temporal + spatial hash.
// Golden ratio (φ-1 ≈ 0.618) gives optimal low-discrepancy temporal sequence.
float blueNoiseJitter(uint frame, ivec2 texel) {
    const float GOLDEN_RATIO_FRAC = 0.6180339887;
    return fract(float(frame) * GOLDEN_RATIO_FRAC + hash12(vec2(texel)));
}

// Reconstruct view ray from screen UV — matches world.rgen ray generation exactly.
// cameraProjMatInv already contains the Vulkan Y-flip (no manual negate needed).
// z=0 = near plane in Vulkan [0,1] depth range.
// cameraEffectedViewMatInv includes view bobbing/effects (same as RT rays).
vec3 getViewRay(vec2 uv) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
    vec4 viewPos = worldUBO.cameraProjMatInv * clipPos;
    viewPos.xyz /= viewPos.w;
    vec3 worldDir = (worldUBO.cameraEffectedViewMatInv * vec4(viewPos.xyz, 0.0)).xyz;
    return normalize(worldDir);
}

// Ray-slab intersection for cloud layer [cloudBase, cloudBase+thickness]
bool intersectCloudSlab(vec3 origin, vec3 dir, float thickness, out float tEnter, out float tExit) {
    float yBot = pc.cloudBase;
    float yTop = pc.cloudBase + thickness;

    if (abs(dir.y) < 1e-6) {
        // Horizontal ray — inside layer?
        if (origin.y >= yBot && origin.y <= yTop) {
            tEnter = 0.0;
            tExit = MARCH_CLAMP;
            return true;
        }
        return false;
    }

    float t0 = (yBot - origin.y) / dir.y;
    float t1 = (yTop - origin.y) / dir.y;

    if (t0 > t1) { float tmp = t0; t0 = t1; t1 = tmp; }

    tEnter = max(t0, 0.0);
    tExit = t1;

    return tExit > tEnter;
}

// Light march toward light source to compute optical depth for shadow term.
// Returns total optical depth along light ray from sample point to cloud top.
float lightMarch(vec3 pos, vec3 lightDir, uint steps, float cloudThick) {
    // Light below horizon — minimal shadow (ambient-only region)
    if (lightDir.y < 0.001) return 0.0;

    float cloudTop = pc.cloudBase + cloudThick;
    // Trace actual light ray to cloud top, capped to avoid extreme horizontal traversal
    float tMax = min((cloudTop - pos.y) / lightDir.y, 200.0);
    float stepSize = tMax / float(steps);

    float opticalDepth = 0.0;
    vec3 samplePos = pos;

    for (uint i = 0; i < steps; i++) {
        samplePos += lightDir * stepSize;

        vec3 noisePos = samplePos * NOISE_SCALE + windOffset(pc.windTime);
        vec4 noise = texture(uNoise3D, noisePos);
        vec4 weather = sampleWeather(uWeatherMap, samplePos);

        float density = cloudDensity(samplePos, weather.r, weather.g, noise,
                                      pc.cloudBase, cloudThick, pc.densityMultiplier,
                                      pc.detailStrength);
        opticalDepth += density * stepSize;

        // Early termination: fully opaque, remaining steps won't change result
        if (opticalDepth > 5.0) break;
    }

    return opticalDepth;
}

// Atmospheric perspective: exponential extinction over distance.
// Returns blend factor [0,1] — 0 = full cloud color, 1 = fully faded to horizon.
float atmosphericFade(float dist) {
    return 1.0 - exp(-dist / pc.atmosphereFadeDist);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= int(pc.cloudWidth) || texel.y >= int(pc.cloudHeight)) return;

    vec2 uv = (vec2(texel) + 0.5) / vec2(pc.cloudWidth, pc.cloudHeight);

    // Reconstruct view ray
    vec3 rayDir = getViewRay(uv);
    vec3 rayOrigin = getEyePos();

    // Thunder-boosted thickness for taller cumulonimbus towers
    float cloudThick = effectiveThickness();

    // Ray-slab intersection
    float tEnter, tExit;
    if (!intersectCloudSlab(rayOrigin, rayDir, cloudThick, tEnter, tExit)) {
        imageStore(uCloudColor, texel, vec4(0.0, 0.0, 0.0, 1.0)); // transparent
        return;
    }

    // Clamp march length — prevents horizontal slab artifacts for shallow rays.
    // Fixed at 200 blocks (proven value). Atmospheric fade is separate.
    tExit = min(tExit, tEnter + MARCH_CLAMP);

    // Check scene depth — don't render clouds behind solid geometry.
    // Linear depth stores view-space Z: -(viewMat * worldPos).z.
    // Convert to ray parametric t: t = viewZ / dot(rayDir, cameraForward).
    ivec2 depthTexel = ivec2(uv * vec2(pc.renderWidth, pc.renderHeight));
    depthTexel = clamp(depthTexel, ivec2(0), ivec2(pc.renderWidth - 1, pc.renderHeight - 1));
    float viewZ = imageLoad(uLinearDepth, depthTexel).r;
    vec3 cameraForward = normalize(worldUBO.cameraEffectedViewMatInv[2].xyz);
    float viewCos = abs(dot(rayDir, cameraForward));
    float sceneT = (viewCos > 1e-4) ? viewZ / viewCos : 1e6;

    // If scene is closer than cloud entry, skip
    if (viewZ > 0.0 && sceneT < tEnter) {
        imageStore(uCloudColor, texel, vec4(0.0, 0.0, 0.0, 1.0)); // transparent
        return;
    }

    // Clamp exit to scene depth (clouds occluded by geometry)
    if (viewZ > 0.0 && sceneT < tExit) {
        tExit = sceneT;
    }

    // --- Zero-skip: check weather at 5 points along ray before marching ---
    {
        bool anyCloud = false;
        for (int probe = 0; probe <= 4; probe++) {
            float pt = mix(tEnter, tExit, float(probe) / 4.0);
            vec3 probePos = rayOrigin + rayDir * pt;
            vec4 probeWeather = sampleWeather(uWeatherMap, probePos);
            if (probeWeather.r >= 0.01) { anyCloud = true; break; }
        }
        if (!anyCloud) {
            imageStore(uCloudColor, texel, vec4(0.0, 0.0, 0.0, 1.0)); // transparent
            return;
        }
    }

    // March parameters
    float marchLength = tExit - tEnter;
    float baseStepSize = marchLength / float(pc.marchSteps);

    // Frame-varying hash jitter (temporal golden ratio + spatial hash)
    float jitter = blueNoiseJitter(pc.frameIndex, texel);
    float t = tEnter + jitter * baseStepSize;

    // Accumulation
    vec3 scatteredLight = vec3(0.0);
    float transmittance = 1.0;
    float weightedDist = 0.0;  // Distance-weighted accumulator for atmospheric perspective
    float totalWeight = 0.0;

    // Light source selection: sun during day, moon at night [Hillaire16 §4.6]
    vec3 sunDir = normalize(skyUBO.sunDirection);
    vec3 lightDir;
    vec3 lightColor;
    if (sunDir.y > 0.0) {
        lightDir = sunDir;
        lightColor = skyUBO.sunRadiance;  // Raw value — tone mapping handles HDR
        // Only kill light below horizon
        lightColor *= smoothstep(-0.05, 0.1, sunDir.y);
        // Golden hour warm tint at low sun angles
        lightColor *= mix(vec3(1.0, 0.7, 0.4), vec3(1.0), smoothstep(0.0, 0.15, sunDir.y));
    } else {
        lightDir = normalize(skyUBO.moonDirection);
        lightColor = skyUBO.moonRadiance;
        lightColor *= smoothstep(0.0, 0.2, abs(lightDir.y));
    }
    float cosAngle = dot(rayDir, lightDir);

    // Ambient: sky colors directly (not proportional to direct light)
    vec3 skyTop = skyUBO.baseColor * 0.4;
    vec3 skyHorizon = skyUBO.horizonColor.rgb * 0.3 + vec3(0.03);

    // Adaptive stepping state
    bool inCloud = false;
    float stepSize = baseStepSize;

    for (uint i = 0; i < pc.marchSteps; i++) {
        if (t >= tExit) break;

        vec3 pos = rayOrigin + rayDir * t;

        // Wind displacement [Schneider15 §3.3]
        vec3 noisePos = pos * NOISE_SCALE + windOffset(pc.windTime);
        vec4 noise = texture(uNoise3D, noisePos);
        vec4 weather = sampleWeather(uWeatherMap, pos);

        float density = cloudDensity(pos, weather.r, weather.g, noise,
                                      pc.cloudBase, cloudThick, pc.densityMultiplier,
                                      pc.detailStrength);

        if (density > 0.001) {
            // Adaptive: backstep and resample when re-entering cloud from empty space
            if (!inCloud) {
                inCloud = true;
                // Retreat half the previous large step to refine the entry point
                t -= stepSize * 0.5;
                pos = rayOrigin + rayDir * t;
                noisePos = pos * NOISE_SCALE + windOffset(pc.windTime);
                noise = texture(uNoise3D, noisePos);
                weather = sampleWeather(uWeatherMap, pos);
                density = cloudDensity(pos, weather.r, weather.g, noise,
                                        pc.cloudBase, cloudThick, pc.densityMultiplier,
                                        pc.detailStrength);
                stepSize = baseStepSize;
                if (density <= 0.001) { t += stepSize; continue; }
            }

            // Conditional light march: skip when transmittance is already low
            // (contribution would be negligible — energy conservation)
            float lightEnergy;
            if (transmittance > 0.05) {
                float lightOD = lightMarch(pos, lightDir, pc.lightSteps, cloudThick);
                // Wrenninge multi-scatter energy [Wrenninge13 §4, Hillaire16 §4.6.3]
                lightEnergy = multiScatterEnergy(lightOD, cosAngle, pc.scatterOctaves, pc.powderStrength);
            } else {
                // Below perceptual threshold — use minimal ambient contribution
                lightEnergy = 0.02;
            }

            // Normalized height for ambient gradient
            float h = (pos.y - pc.cloudBase) / cloudThick;

            // Height-dependent ambient: sky color at top, horizon at base
            vec3 ambient = mix(skyHorizon, skyTop, h) * mix(0.5, 1.2, h);

            // Direct lighting with multi-scatter energy
            vec3 directLight = lightColor * lightEnergy;

            // Ambient occlusion from accumulated optical depth [Nubis³ p141]
            // transmittance decays 1→0 as we march deeper into the cloud.
            // ao = pow(transmittance, strength): 1.0 at surface, →0 deep inside.
            // strength=0 → no AO, strength=1 → default, strength=2 → exaggerated.
            // Applied to total luminance so it visibly darkens cloud interiors,
            // but NOT to the Beer's-law integration — preserves silver-lining energy.
            float ao = pow(transmittance, pc.ambientStrength);

            vec3 luminance = (directLight + ambient) * ao * density;

            // Accumulate with Beer's law
            float sampleTransmittance = exp(-density * stepSize);
            // Energy-conserving in-scattering integration [Hillaire16 §4.6.2]
            vec3 integScatter = luminance * (1.0 - sampleTransmittance) / max(density, 0.0001);
            scatteredLight += transmittance * integScatter;
            transmittance *= sampleTransmittance;

            // Track distance for atmospheric perspective
            float sampleWeight = (1.0 - sampleTransmittance) * transmittance;
            weightedDist += t * sampleWeight;
            totalWeight += sampleWeight;

            // Early termination — fully opaque
            if (transmittance < 0.003) {
                transmittance = 0.0;
                break;
            }
        } else {
            // Adaptive: double step size in empty space to skip gaps faster
            if (inCloud) {
                inCloud = false;
            }
            stepSize = baseStepSize * 2.0;
        }

        t += stepSize;
    }

    // --- Atmospheric perspective ---
    // Fade distant clouds toward horizon color based on average sample distance
    if (totalWeight > 0.001) {
        float avgDist = weightedDist / totalWeight;
        float fade = atmosphericFade(avgDist);
        vec3 horizonFog = skyUBO.horizonColor.rgb * 0.5;
        scatteredLight = mix(scatteredLight, horizonFog * (1.0 - transmittance), fade);
    }

    // No density found — output transparent
    if (transmittance > 0.999) {
        imageStore(uCloudColor, texel, vec4(0.0, 0.0, 0.0, 1.0)); // transparent
        return;
    }

    // Output: RGB = scattered light, A = transmittance
    imageStore(uCloudColor, texel, vec4(scatteredLight, transmittance));
}
