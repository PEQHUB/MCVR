#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Core volumetric cloud ray march (Doom TDA style).
// Dispatched at cloud resolution (quarter/half/full).
// Output: RGBA16F cloud color (rgb) + transmittance (a).

layout(local_size_x = 8, local_size_y = 8) in;

// Set 0: images
layout(set = 0, binding = 1, r32f)     uniform readonly image2D uLinearDepth;
layout(set = 0, binding = 3, rgba16f)  uniform writeonly image2D uCloudColor;
layout(set = 0, binding = 6)           uniform sampler3D uNoise3D;         // 64^3 RGBA8 repeat
layout(set = 0, binding = 8)           uniform sampler2D uWeatherMap;      // 256x256 RGBA8

#include "cloud_common.glsl"
#include "cloud_density.glsl"

// Constants
const float NOISE_SCALE = 1.0 / 256.0;  // World-space to noise UV scale
const float ATMO_FADE_DIST = 2000.0;    // Blocks at which clouds fully fade to horizon

// Per-pixel hash for spatial variation (no external buffer needed)
float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// Frame-varying hash jitter: golden ratio temporal + spatial hash
float blueNoiseJitter(uint frame, ivec2 texel) {
    return fract(float(frame) * 0.6180339887 + hash12(vec2(texel)));
}

// Reconstruct view ray from screen UV
vec3 getViewRay(vec2 uv) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    clipPos.y = -clipPos.y; // Vulkan Y-flip
    vec4 viewPos = worldUBO.cameraProjMatInv * clipPos;
    viewPos.xyz /= viewPos.w;
    vec3 worldDir = (worldUBO.cameraViewMatInv * vec4(viewPos.xyz, 0.0)).xyz;
    return normalize(worldDir);
}

// Ray-slab intersection for cloud layer [cloudBase, cloudBase+cloudThickness]
bool intersectCloudSlab(vec3 origin, vec3 dir, out float tEnter, out float tExit) {
    float yBot = pc.cloudBase;
    float yTop = pc.cloudBase + pc.cloudThickness;

    if (abs(dir.y) < 1e-6) {
        // Horizontal ray — inside layer?
        if (origin.y >= yBot && origin.y <= yTop) {
            tEnter = 0.0;
            tExit = 10000.0;
            return true;
        }
        return false;
    }

    float t0 = (yBot - origin.y) / dir.y;
    float t1 = (yTop - origin.y) / dir.y;

    if (t0 > t1) { float tmp = t0; t0 = t1; t1 = tmp; }

    tEnter = max(t0, 0.0);
    tExit = t1;

    return tExit > tEnter;
}

// Sample weather map (UV = XZ world position mapped to [0,1])
vec4 sampleWeather(vec3 worldPos) {
    vec3 eyePos = getEyePos();
    // Map world XZ to weather UV: 1024-block coverage area centered on camera
    vec2 uv = (worldPos.xz - eyePos.xz) / 1024.0 + 0.5;
    return texture(uWeatherMap, uv);
}

// Light march toward sun to compute optical depth
float lightMarch(vec3 pos, vec3 sunDir, uint steps) {
    float cloudTop = pc.cloudBase + pc.cloudThickness;
    float stepSize = max((cloudTop - pos.y) / max(sunDir.y, 0.01), 0.0) / float(steps);

    float opticalDepth = 0.0;
    vec3 samplePos = pos;

    for (uint i = 0; i < steps; i++) {
        samplePos += sunDir * stepSize;

        vec3 noisePos = samplePos * NOISE_SCALE + vec3(pc.windTime * 0.02, 0.0, pc.windTime * 0.01);
        vec4 noise = texture(uNoise3D, noisePos);
        vec4 weather = sampleWeather(samplePos);

        float density = cloudDensity(samplePos, weather.r, weather.g, noise,
                                      pc.cloudBase, pc.cloudThickness, pc.densityMultiplier);
        opticalDepth += density * stepSize;
    }

    return opticalDepth;
}

// Atmospheric perspective: compute extinction over distance through lower atmosphere
// Returns blend factor [0,1] — 0 = full cloud color, 1 = fully faded to horizon
float atmosphericFade(float dist) {
    // Exponential falloff tuned for Minecraft scale
    // At 500 blocks: ~18% faded, at 1000: ~63%, at 2000: ~98%
    return 1.0 - exp(-dist / ATMO_FADE_DIST * 2.0);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= int(pc.cloudWidth) || texel.y >= int(pc.cloudHeight)) return;

    // No clouds in Nether/End (skyType: 0=Overworld, 1=Nether, 2=End)
    if (skyUBO.skyType != 0) {
        imageStore(uCloudColor, texel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2 uv = (vec2(texel) + 0.5) / vec2(pc.cloudWidth, pc.cloudHeight);

    // Reconstruct view ray
    vec3 rayDir = getViewRay(uv);
    vec3 rayOrigin = getEyePos();

    // Ray-slab intersection
    float tEnter, tExit;
    if (!intersectCloudSlab(rayOrigin, rayDir, tEnter, tExit)) {
        imageStore(uCloudColor, texel, vec4(0.0, 0.0, 0.0, 1.0)); // Fully transparent
        return;
    }

    // Check scene depth — don't render clouds behind solid geometry
    // Map cloud texel to full-res depth texel
    ivec2 depthTexel = ivec2(uv * vec2(pc.renderWidth, pc.renderHeight));
    depthTexel = clamp(depthTexel, ivec2(0), ivec2(pc.renderWidth - 1, pc.renderHeight - 1));
    float sceneDepth = imageLoad(uLinearDepth, depthTexel).r;

    // If scene is closer than cloud entry, skip
    if (sceneDepth > 0.0 && sceneDepth < tEnter) {
        imageStore(uCloudColor, texel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    // Clamp exit to scene depth (clouds occluded by geometry)
    if (sceneDepth > 0.0 && sceneDepth < tExit) {
        tExit = sceneDepth;
    }

    // --- Zero-skip: check weather at ray midpoint before marching ---
    vec3 midPos = rayOrigin + rayDir * ((tEnter + tExit) * 0.5);
    vec4 midWeather = sampleWeather(midPos);
    if (midWeather.r < 0.01) {
        // No coverage at ray center — check entry and exit too
        vec3 enterPos = rayOrigin + rayDir * tEnter;
        vec3 exitPos = rayOrigin + rayDir * tExit;
        vec4 enterWeather = sampleWeather(enterPos);
        vec4 exitWeather = sampleWeather(exitPos);
        if (enterWeather.r < 0.01 && exitWeather.r < 0.01) {
            imageStore(uCloudColor, texel, vec4(0.0, 0.0, 0.0, 1.0));
            return;
        }
    }

    // March parameters
    float marchLength = tExit - tEnter;
    float baseStepSize = marchLength / float(pc.marchSteps);

    // Frame-varying hash jitter (temporal golden ratio + spatial hash)
    float jitter = blueNoiseJitter(pc.frameIndex, texel);
    float t = tEnter + jitter * baseStepSize;

    // Accumulation
    vec3 scatteredLight = vec3(0.0);
    float transmittance = 1.0;
    float weightedDist = 0.0;  // Distance-weighted accumulator for atmospheric perspective
    float totalWeight = 0.0;

    // Sun direction and phase function
    vec3 sunDir = normalize(skyUBO.sunDirection);
    float cosAngle = dot(rayDir, sunDir);
    // Dual-lobe HG: strong forward scatter + mild back scatter
    float phase = phaseDualHG(cosAngle, 0.8, -0.3, 0.2);

    // Sun color
    vec3 sunColor = skyUBO.sunRadiance;

    // Height-dependent sky ambient: blue at top, warm horizon color at base
    vec3 skyTop = skyUBO.baseColor * 0.4;
    vec3 skyHorizon = skyUBO.horizonColor.rgb * 0.3 + vec3(0.03);

    // Adaptive stepping state
    bool inCloud = false;
    float stepSize = baseStepSize;

    for (uint i = 0; i < pc.marchSteps; i++) {
        if (t >= tExit) break;

        vec3 pos = rayOrigin + rayDir * t;

        // Wind displacement
        vec3 noisePos = pos * NOISE_SCALE + vec3(pc.windTime * 0.02, 0.0, pc.windTime * 0.01);
        vec4 noise = texture(uNoise3D, noisePos);
        vec4 weather = sampleWeather(pos);

        float density = cloudDensity(pos, weather.r, weather.g, noise,
                                      pc.cloudBase, pc.cloudThickness, pc.densityMultiplier);

        if (density > 0.001) {
            // Adaptive: switch to fine stepping inside cloud
            if (!inCloud) {
                inCloud = true;
                stepSize = baseStepSize;
            }

            // Conditional light march: skip when transmittance is already low
            // (deep inside cloud, light contribution is negligible)
            float lightTransmittance;
            if (transmittance > 0.05) {
                float lightOD = lightMarch(pos, sunDir, pc.lightSteps);
                lightTransmittance = beerPowder(lightOD);
            } else {
                // Deep inside cloud — approximate with simple extinction
                lightTransmittance = 0.02;
            }

            // Normalized height for ambient gradient
            float h = (pos.y - pc.cloudBase) / pc.cloudThickness;

            // Height-dependent ambient: sky color at top, horizon at base
            vec3 ambient = mix(skyHorizon, skyTop, h) * mix(0.5, 1.2, h);

            // Direct sun lighting
            vec3 directLight = sunColor * lightTransmittance * phase;

            vec3 luminance = (directLight + ambient) * density;

            // Accumulate with Beer's law
            float sampleTransmittance = exp(-density * stepSize);
            // Energy-conserving in-scattering integration
            vec3 integScatter = luminance * (1.0 - sampleTransmittance) / max(density, 0.0001);
            scatteredLight += transmittance * integScatter;
            transmittance *= sampleTransmittance;

            // Track distance for atmospheric perspective
            float sampleWeight = (1.0 - sampleTransmittance) * transmittance;
            weightedDist += t * sampleWeight;
            totalWeight += sampleWeight;

            // Early termination
            if (transmittance < 0.003) {
                transmittance = 0.0;
                break;
            }
        } else {
            // Adaptive: double step size in empty space
            if (inCloud) {
                inCloud = false;
            }
            stepSize = baseStepSize * 2.0;
        }

        t += stepSize;
        stepSize = baseStepSize; // Reset for next iteration (adaptive handled above)
    }

    // --- Atmospheric perspective ---
    // Fade distant clouds toward horizon color based on average sample distance
    if (totalWeight > 0.001) {
        float avgDist = weightedDist / totalWeight;
        float fade = atmosphericFade(avgDist);
        // Blend cloud scattered light toward attenuated horizon color
        vec3 horizonFog = skyUBO.horizonColor.rgb * 0.5;
        scatteredLight = mix(scatteredLight, horizonFog * (1.0 - transmittance), fade);
    }

    // Output: RGB = scattered light, A = transmittance
    imageStore(uCloudColor, texel, vec4(scatteredLight, transmittance));
}
