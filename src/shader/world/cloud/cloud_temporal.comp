#version 460
#extension GL_GOOGLE_include_directive : require

// Cloud temporal reprojection + AABB clamping.
// Blends current cloud color with history for temporal stability.
// Motion-adaptive: aggressive blend when static, reduced during camera turns.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 3, rgba16f) uniform image2D uCloudColor;     // Current frame (read/write)
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D uCloudHistory;  // Previous frame

#include "cloud_common.glsl"

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= int(pc.cloudWidth) || texel.y >= int(pc.cloudHeight)) return;

    vec4 current = imageLoad(uCloudColor, texel);

    // Reproject: compute where this pixel was in the previous frame
    // For clouds at high altitude, approximate world position for reprojection
    vec2 uv = (vec2(texel) + 0.5) / vec2(pc.cloudWidth, pc.cloudHeight);

    // Reconstruct approximate world position at cloud mid-height
    vec4 clipPos = vec4(uv * 2.0 - 1.0, 0.5, 1.0);
    clipPos.y = -clipPos.y;
    vec4 viewPos = worldUBO.cameraProjMatInv * clipPos;
    viewPos.xyz /= viewPos.w;
    vec3 worldDir = normalize((worldUBO.cameraViewMatInv * vec4(viewPos.xyz, 0.0)).xyz);

    // Approximate cloud position at mid-layer
    vec3 eyePos = getEyePos();
    float cloudMid = pc.cloudBase + pc.cloudThickness * 0.5;
    float tCloud = max((cloudMid - eyePos.y) / max(worldDir.y, 0.001), 0.0);
    vec3 worldPos = eyePos + worldDir * tCloud;

    // Project into previous frame
    vec4 prevView = lastWorldUBO.prevCameraViewMat * vec4(worldPos, 1.0);
    vec4 prevClip = lastWorldUBO.prevCameraProjMat * prevView;
    vec2 prevUV = prevClip.xy / prevClip.w;
    prevUV.y = -prevUV.y;
    prevUV = prevUV * 0.5 + 0.5;

    // Check if reprojected UV is valid
    bool validReproject = all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)));

    if (!validReproject || pc.frameIndex == 0) {
        // No valid history — keep current sample
        return;
    }

    // Sample history at reprojected location
    ivec2 historyTexel = ivec2(prevUV * vec2(pc.cloudWidth, pc.cloudHeight));
    historyTexel = clamp(historyTexel, ivec2(0), ivec2(pc.cloudWidth - 1, pc.cloudHeight - 1));
    vec4 history = imageLoad(uCloudHistory, historyTexel);

    // Neighborhood AABB clamping (3x3)
    vec4 minVal = current;
    vec4 maxVal = current;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 neighbor = texel + ivec2(dx, dy);
            neighbor = clamp(neighbor, ivec2(0), ivec2(pc.cloudWidth - 1, pc.cloudHeight - 1));
            vec4 s = imageLoad(uCloudColor, neighbor);
            minVal = min(minVal, s);
            maxVal = max(maxVal, s);
        }
    }

    // Clamp history to neighborhood AABB (prevents ghosting)
    vec4 clampedHistory = clamp(history, minVal, maxVal);

    // --- Motion-adaptive blend factor ---
    // Compare current and previous camera forward vectors to detect rotation
    vec3 currForward = normalize(worldUBO.cameraViewMat[2].xyz);
    vec3 prevForward = normalize(lastWorldUBO.prevCameraViewMat[2].xyz);
    float rotationDelta = 1.0 - abs(dot(currForward, prevForward));

    // Also detect translation by comparing camera positions
    vec3 prevEyePos = lastWorldUBO.prevCameraViewMatInv[3].xyz;
    float translationDelta = length(eyePos - prevEyePos);

    // Motion magnitude: rotation contributes more than translation for clouds
    // (clouds are far away, so translation barely shifts them)
    float motion = rotationDelta * 50.0 + translationDelta * 0.01;
    motion = clamp(motion, 0.0, 1.0);

    // Reduce temporal blend when camera is moving (more responsive, less ghosting)
    // Static: use pc.temporalBlend (0.93-0.97). Fast motion: drop to 0.5
    float adaptiveBlend = mix(pc.temporalBlend, 0.5, motion);

    // Reprojection confidence: reduce blend near UV edges (stretched reprojection)
    vec2 uvDist = abs(prevUV - 0.5) * 2.0; // [0,1] distance from center
    float edgeFalloff = 1.0 - smoothstep(0.8, 1.0, max(uvDist.x, uvDist.y));
    adaptiveBlend *= edgeFalloff;

    // Also reduce blend when AABB clamping was aggressive (history was far from current)
    float clampDist = length(history - clampedHistory);
    float clampPenalty = smoothstep(0.0, 0.5, clampDist);
    adaptiveBlend *= (1.0 - clampPenalty * 0.5);

    vec4 result = mix(current, clampedHistory, adaptiveBlend);

    imageStore(uCloudColor, texel, result);
}
