#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Cloud noise 3D texture generator. [Schneider15 §3.2, Bridson07]
// Generates a 128^3 RGBA8 tiled noise texture at init time (once).
//
// Channel layout (matches cloudDensity() expectations in cloud_density.glsl):
//   R: Perlin-Worley blend — base cloud shape (connected yet billowy, freq 1.0)
//   G: Single-octave Worley at freq 4 — medium erosion (sharp cell edges)
//   B: Single-octave Worley at freq 8 — fine erosion
//   A: Curl noise magnitude — wispy tendrils for cloud edges [Bridson07]

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 9, rgba8) uniform writeonly image3D uNoiseTexture;

// Uses shared push constant layout from cloud_common.glsl.
// UBOs are declared but unused by this shader — only runs at init.
#include "cloud_common.glsl"

// --- Noise primitives (self-contained for init-time generation) ---

// Hash functions for procedural noise
vec3 hash33(vec3 p) {
    p = vec3(dot(p, vec3(127.1, 311.7, 74.7)),
             dot(p, vec3(269.5, 183.3, 246.1)),
             dot(p, vec3(113.5, 271.9, 124.6)));
    return fract(sin(p) * 43758.5453123);
}

float hash31(vec3 p) {
    float h = dot(p, vec3(127.1, 311.7, 74.7));
    return fract(sin(h) * 43758.5453123);
}

// 3D value noise with Hermite interpolation
float valueNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f); // Hermite smoothstep

    return mix(
        mix(mix(hash31(i + vec3(0, 0, 0)), hash31(i + vec3(1, 0, 0)), f.x),
            mix(hash31(i + vec3(0, 1, 0)), hash31(i + vec3(1, 1, 0)), f.x), f.y),
        mix(mix(hash31(i + vec3(0, 0, 1)), hash31(i + vec3(1, 0, 1)), f.x),
            mix(hash31(i + vec3(0, 1, 1)), hash31(i + vec3(1, 1, 1)), f.x), f.y),
        f.z);
}

// Worley (cellular) noise — returns F1 distance (nearest feature point)
float worleyF1(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    float minDist = 1.0;

    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                vec3 neighbor = vec3(x, y, z);
                vec3 point = hash33(i + neighbor);
                vec3 diff = neighbor + point - f;
                float dist = dot(diff, diff);
                minDist = min(minDist, dist);
            }
        }
    }
    return sqrt(minDist);
}

// Perlin-like gradient noise (3D)
float gradientNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);

    // 8 corners
    float n000 = dot(hash33(i + vec3(0, 0, 0)) * 2.0 - 1.0, f - vec3(0, 0, 0));
    float n100 = dot(hash33(i + vec3(1, 0, 0)) * 2.0 - 1.0, f - vec3(1, 0, 0));
    float n010 = dot(hash33(i + vec3(0, 1, 0)) * 2.0 - 1.0, f - vec3(0, 1, 0));
    float n110 = dot(hash33(i + vec3(1, 1, 0)) * 2.0 - 1.0, f - vec3(1, 1, 0));
    float n001 = dot(hash33(i + vec3(0, 0, 1)) * 2.0 - 1.0, f - vec3(0, 0, 1));
    float n101 = dot(hash33(i + vec3(1, 0, 1)) * 2.0 - 1.0, f - vec3(1, 0, 1));
    float n011 = dot(hash33(i + vec3(0, 1, 1)) * 2.0 - 1.0, f - vec3(0, 1, 1));
    float n111 = dot(hash33(i + vec3(1, 1, 1)) * 2.0 - 1.0, f - vec3(1, 1, 1));

    return mix(
        mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
        mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y),
        u.z) * 0.5 + 0.5;
}

// FBM (Fractional Brownian Motion) of gradient noise
float fbm(vec3 p, int octaves) {
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;
    for (int i = 0; i < octaves; i++) {
        value += amplitude * gradientNoise(p * frequency);
        amplitude *= 0.5;
        frequency *= 2.0;
    }
    return value;
}

// Worley FBM: weighted sum at 3 octaves [Schneider15 §3.2]
// Only used for R channel (base shape). G/B use single-octave Worley.
float worleyFBM3(vec3 p, float baseFreq) {
    float w0 = 1.0 - worleyF1(p * baseFreq);
    float w1 = 1.0 - worleyF1(p * baseFreq * 2.0);
    float w2 = 1.0 - worleyF1(p * baseFreq * 4.0);
    return 0.625 * w0 + 0.25 * w1 + 0.125 * w2;
}

// Curl noise magnitude [Bridson07] — generates wispy, tendril-like structures.
// Computes |∇ × A| where A = (F1, F2, F3) are independent gradient noise fields.
// Init-time only (runs once), so ALU cost is irrelevant.
float curlNoiseMag(vec3 p, float freq) {
    p *= freq;
    float e = 0.05;
    vec3 o2 = vec3(31.416, 47.853, 73.214);
    vec3 o3 = vec3(113.957, 67.432, 29.876);

    // Partial derivatives of three independent noise fields
    // ∇ × (F1, F2, F3) = (∂F3/∂y - ∂F2/∂z, ∂F1/∂z - ∂F3/∂x, ∂F2/∂x - ∂F1/∂y)
    float df1_dy = gradientNoise(p + vec3(0,e,0)) - gradientNoise(p - vec3(0,e,0));
    float df1_dz = gradientNoise(p + vec3(0,0,e)) - gradientNoise(p - vec3(0,0,e));
    float df2_dx = gradientNoise(p+o2 + vec3(e,0,0)) - gradientNoise(p+o2 - vec3(e,0,0));
    float df2_dz = gradientNoise(p+o2 + vec3(0,0,e)) - gradientNoise(p+o2 - vec3(0,0,e));
    float df3_dx = gradientNoise(p+o3 + vec3(e,0,0)) - gradientNoise(p+o3 - vec3(e,0,0));
    float df3_dy = gradientNoise(p+o3 + vec3(0,e,0)) - gradientNoise(p+o3 - vec3(0,e,0));

    vec3 curl = vec3(df3_dy - df2_dz, df1_dz - df3_dx, df2_dx - df1_dy) / (2.0 * e);
    return clamp(length(curl) * 0.3, 0.0, 1.0);
}

void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(texel, ivec3(128)))) return;

    vec3 uvw = (vec3(texel) + 0.5) / 128.0;
    vec3 p = uvw * 8.0; // Scale for good tiling frequency

    // R: Perlin-Worley blend (base cloud shape) [Schneider15 §3.2]
    // Perlin provides connectivity, Worley provides billowy cauliflower shapes.
    // Lower base frequency (1.0 vs 2.0) gives larger, more distinct cloud features.
    float perlin = fbm(p, 4);
    float worleyFbm = worleyFBM3(p, 1.0);

    // Schneider remap (not linear interpolation — creates continuous connectivity)
    float perlinWorley = perlin * 0.5 + 0.5;  // Perlin to [0,1]
    perlinWorley = max(perlinWorley - (1.0 - worleyFbm), 0.0) / max(worleyFbm, 0.001);
    perlinWorley = clamp(perlinWorley, 0.0, 1.0);

    // G: Single-octave Worley at freq 4 (sharp cell edges, no FBM blurring)
    float mediumErosion = 1.0 - worleyF1(p * 4.0);

    // B: Single-octave Worley at freq 8 (fine erosion)
    float fineErosion = 1.0 - worleyF1(p * 8.0);

    // A: Curl noise (wispy tendrils for cloud edges) [Bridson07]
    float curlDetail = curlNoiseMag(p, 4.0);

    imageStore(uNoiseTexture, texel, vec4(perlinWorley, mediumErosion, fineErosion, curlDetail));
}
