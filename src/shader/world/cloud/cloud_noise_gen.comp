#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Cloud noise 3D texture generator. [Schneider15 SIGGRAPH 2015]
// Generates a 128^3 RGBA8 tiled noise texture at init time (once).
//
// Channel layout (Schneider 2015 procedural clouds):
//   R: Perlin-Worley blend — connected large-scale cloud shape
//   G: Worley F1 at freq 2x — erosion octave 1
//   B: Worley F1 at freq 4x — erosion octave 2
//   A: Worley F1 at freq 8x — erosion octave 3
//
// R creates the base cloud shape (connected, puffy masses).
// G/B/A erode coverage edges to create realistic cloud boundaries.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 9, rgba8) uniform writeonly image3D uNoiseTexture;

// Uses shared push constant layout from cloud_common.glsl.
// UBOs are declared but unused by this shader — only runs at init.
#include "cloud_common.glsl"

// --- Noise primitives (self-contained for init-time generation) ---

// Hash function for procedural noise
vec3 hash33(vec3 p) {
    p = vec3(dot(p, vec3(127.1, 311.7, 74.7)),
             dot(p, vec3(269.5, 183.3, 246.1)),
             dot(p, vec3(113.5, 271.9, 124.6)));
    return fract(sin(p) * 43758.5453123);
}

// Worley (cellular) noise — returns F1 distance (nearest feature point)
float worleyF1(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    float minDist = 1.0;

    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                vec3 neighbor = vec3(x, y, z);
                vec3 point = hash33(i + neighbor);
                vec3 diff = neighbor + point - f;
                float dist = dot(diff, diff);
                minDist = min(minDist, dist);
            }
        }
    }
    return sqrt(minDist);
}

// Perlin-like gradient noise (3D)
float gradientNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);

    // 8 corners
    float n000 = dot(hash33(i + vec3(0, 0, 0)) * 2.0 - 1.0, f - vec3(0, 0, 0));
    float n100 = dot(hash33(i + vec3(1, 0, 0)) * 2.0 - 1.0, f - vec3(1, 0, 0));
    float n010 = dot(hash33(i + vec3(0, 1, 0)) * 2.0 - 1.0, f - vec3(0, 1, 0));
    float n110 = dot(hash33(i + vec3(1, 1, 0)) * 2.0 - 1.0, f - vec3(1, 1, 0));
    float n001 = dot(hash33(i + vec3(0, 0, 1)) * 2.0 - 1.0, f - vec3(0, 0, 1));
    float n101 = dot(hash33(i + vec3(1, 0, 1)) * 2.0 - 1.0, f - vec3(1, 0, 1));
    float n011 = dot(hash33(i + vec3(0, 1, 1)) * 2.0 - 1.0, f - vec3(0, 1, 1));
    float n111 = dot(hash33(i + vec3(1, 1, 1)) * 2.0 - 1.0, f - vec3(1, 1, 1));

    return mix(
        mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
        mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y),
        u.z) * 0.5 + 0.5;
}

void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(texel, ivec3(128)))) return;

    vec3 uvw = (vec3(texel) + 0.5) / 128.0;
    vec3 p = uvw * 4.0;  // 4 cells across the 128³ volume

    // R: Perlin-Worley blend [Schneider15] — connected large-scale shape.
    // remap(perlin, 0, 1, worley, 1) biases Perlin toward Worley in valleys,
    // creating connected, puffy masses instead of isolated blobs.
    float perlin = gradientNoise(p);
    float worley = 1.0 - worleyF1(p);
    float r = perlin + (worley - perlin) * (1.0 - perlin);  // remap(perlin, 0,1, worley, 1)

    // G/B/A: Worley F1 erosion octaves at doubling frequencies [Schneider15]
    float g = 1.0 - worleyF1(p * 2.0);   // erosion octave 1
    float b = 1.0 - worleyF1(p * 4.0);   // erosion octave 2
    float a = 1.0 - worleyF1(p * 8.0);   // erosion octave 3

    imageStore(uNoiseTexture, texel, vec4(r, g, b, a));
}
