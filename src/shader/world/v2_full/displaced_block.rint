#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../../common/mapping.hpp"
#include "../../common/shared.hpp"

layout(set = 0, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer BLASOffsets {
    uint offsets[];
}
blasOffsets;

layout(set = 1, binding = 2) readonly buffer VertexBufferAddr {
    uint64_t addrs[];
}
vertexBufferAddrs;

// Buffer reference for face data (stored as "vertex buffer" for displaced geometry)
layout(std430, buffer_reference, buffer_reference_align = 16) readonly buffer FaceDataBuffer {
    DisplacedFaceData faces[];
};

// BT.2020 luminance weights
const vec3 BT2020_LUM = vec3(0.2627, 0.6780, 0.0593);

// Face normal vectors indexed by faceAxis (0=+X, 1=-X, 2=+Y, 3=-Y, 4=+Z, 5=-Z)
const vec3 FACE_NORMALS[6] = vec3[](
    vec3(1,0,0), vec3(-1,0,0), vec3(0,1,0), vec3(0,-1,0), vec3(0,0,1), vec3(0,0,-1));

// Hit attributes: xy = texture UV at hit, z unused
hitAttributeEXT vec3 hitAttribs;

// Sample height from texture with NEAREST or BILINEAR filter
float sampleHeight(uint texID, vec2 uv, vec2 uvMin, vec2 uvMax, int filterMode,
                   int heightSource, float lumMin, float lumMax, bool invertH,
                   float remapMin, float remapMax, float contrast, float hOffset,
                   bool hasLabPBR, int normalTexID) {
    vec2 cUV = clamp(uv, uvMin, uvMax);

    // LabPBR: height is in normal texture alpha
    if (hasLabPBR && normalTexID >= 0) {
        if (filterMode == 0) {
            // NEAREST: texelFetch equivalent via high LOD bias + nearest filtering
            return textureLod(textures[nonuniformEXT(uint(normalTexID))], cUV, 0).a;
        } else {
            return textureLod(textures[nonuniformEXT(uint(normalTexID))], cUV, 0).a;
        }
    }

    // AutoPBR: derive height from albedo
    vec4 s = textureLod(textures[nonuniformEXT(texID)], cUV, 0);
    float raw;
    if (heightSource == 1) raw = s.r;
    else if (heightSource == 2) raw = s.g;
    else if (heightSource == 3) raw = s.b;
    else if (heightSource == 4) raw = s.a;
    else if (heightSource == 5) raw = max(s.r, max(s.g, s.b));
    else if (heightSource == 6) raw = min(s.r, min(s.g, s.b));
    else raw = dot(s.rgb, BT2020_LUM);

    // Height pipeline: normalize → invert → remap → contrast → offset
    float lumSpan = lumMax - lumMin;
    float h = (lumSpan > 1e-6) ? clamp((raw - lumMin) / lumSpan, 0.0, 1.0) : 0.5;
    if (invertH) h = 1.0 - h;
    h = mix(remapMin, remapMax, h);
    if (contrast != 1.0) h = pow(clamp(h, 0.001, 1.0), contrast);
    return clamp(h + hOffset, 0.0, 1.0);
}

void main() {
    uint instanceID = gl_InstanceID;
    uint geometryID = gl_GeometryIndexEXT;
    uint faceIdx = gl_PrimitiveID;

    uint blasOffset = blasOffsets.offsets[instanceID];
    uint64_t faceDataAddr = vertexBufferAddrs.addrs[blasOffset + geometryID];
    if (faceDataAddr == 0) return;

    FaceDataBuffer faceDataBuf = FaceDataBuffer(faceDataAddr);
    DisplacedFaceData face = faceDataBuf.faces[faceIdx];

    // Unpack displacement params from pomPacked0
    uint pp0 = face.pomPacked0;
    int filterMode   = int(pp0 & 0x7u);                // bits 0-2
    int heightSource = int((pp0 >> 6u) & 0x7u);        // bits 6-8
    int maxSteps     = int((pp0 >> 9u) & 0x7Fu);       // bits 9-15
    if (maxSteps < 4) maxSteps = 32; // safe default

    // Unpack height pipeline from pomPacked1/2 and flags
    float heightContrast = float((face.pomPacked1 >> 24u) & 0xFFu) / 10.0;
    float remapMin = float((face.pomPacked2 >> 0u) & 0xFFu) / 100.0;
    float remapMax = float((face.pomPacked2 >> 8u) & 0xFFu) / 100.0;
    float hOffset  = (float((face.pomPacked2 >> 16u) & 0xFFu) - 100.0) / 100.0;
    bool invertH   = ((face.flags >> 6u) & 1u) != 0u;
    bool hasLabPBR = (face.properties & TEX_PROP_HAS_HEIGHT_MAP) != 0u && face.normalTexID >= 0;
    bool isAutoPBR = (face.flags & 0x8u) != 0u;

    // Ray in object space (identity transform for chunks)
    vec3 rayOrigin = gl_ObjectRayOriginEXT;
    vec3 rayDir = gl_ObjectRayDirectionEXT;

    // Face geometry
    vec3 corner = face.corner;
    vec3 edgeU = face.edgeU;
    vec3 edgeV = face.edgeV;
    vec3 faceN = FACE_NORMALS[face.faceAxis];
    float heightScale = face.heightScale;

    // Compute ray-slab intersection for the displacement volume
    // The volume is bounded by the face plane and the plane offset by -faceN * heightScale
    float denom = dot(rayDir, faceN);
    if (abs(denom) < 1e-8) return; // Ray parallel to face

    float tSurface = dot(corner - rayOrigin, faceN) / denom;
    float tBottom  = dot((corner - faceN * heightScale) - rayOrigin, faceN) / denom;
    float tEntry = min(tSurface, tBottom);
    float tExit  = max(tSurface, tBottom);

    // Clamp to valid ray range
    tEntry = max(tEntry, gl_RayTminEXT);
    tExit  = min(tExit, gl_RayTmaxEXT);
    if (tEntry >= tExit) return;

    // Edge fade width scales with displacement depth to prevent clipping perpendicular faces
    vec2 texSize = vec2(textureSize(textures[nonuniformEXT(face.textureID)], 0));
    vec2 uvSpan = face.uvMax - face.uvMin;
    float texelsU = max(texSize.x * uvSpan.x, 1.0);
    float texelsV = max(texSize.y * uvSpan.y, 1.0);
    float edgeWidthU = min(2.0, max(1.0, heightScale * texelsU)) / texelsU;
    float edgeWidthV = min(2.0, max(1.0, heightScale * texelsV)) / texelsV;
    uint fadeMask = face.fadeEdgeMask;

    // DDA march through the displacement volume
    float dt = (tExit - tEntry) / float(maxSteps);
    float t = tEntry;
    float lenU2 = dot(edgeU, edgeU);
    float lenV2 = dot(edgeV, edgeV);

    for (int step = 0; step < maxSteps; step++) {
        vec3 p = rayOrigin + rayDir * t;

        // Project onto face to get parametric coordinates
        vec3 rel = p - corner;
        float u = dot(rel, edgeU) / lenU2;
        float v = dot(rel, edgeV) / lenV2;

        // Check if we're within the face bounds
        if (u >= 0.0 && u <= 1.0 && v >= 0.0 && v <= 1.0) {
            // Map parametric UV to texture UV
            vec2 texUV = mix(face.uvMin, face.uvMax, vec2(u, v));

            // Sample height
            float h = sampleHeight(face.textureID, texUV, face.uvMin, face.uvMax,
                                   filterMode, heightSource, face.lumMin, face.lumMax,
                                   invertH, remapMin, remapMax, heightContrast, hOffset,
                                   hasLabPBR, face.normalTexID);

            // Fade displacement to zero near face edges so adjacent faces meet
            // at the original cube boundary (prevents edge tears).
            // Only fade edges marked in fadeEdgeMask; coplanar neighbors skip fade.
            float edgeFade = 1.0;
            if ((fadeMask & 0x1u) != 0u) edgeFade *= smoothstep(0.0, edgeWidthU, u);
            if ((fadeMask & 0x2u) != 0u) edgeFade *= smoothstep(0.0, edgeWidthU, 1.0 - u);
            if ((fadeMask & 0x4u) != 0u) edgeFade *= smoothstep(0.0, edgeWidthV, v);
            if ((fadeMask & 0x8u) != 0u) edgeFade *= smoothstep(0.0, edgeWidthV, 1.0 - v);

            // Height surface: distance from face plane along negative normal
            // edgeFade=0 at edges → surfaceDepth=0 → surface at face plane (no displacement)
            float surfaceDepth = (1.0 - h) * heightScale * edgeFade;

            // Current ray depth below face plane
            float rayDepth = -dot(rel, faceN);

            // If ray is below the height surface, we have an intersection
            if (rayDepth >= surfaceDepth) {
                // Binary refinement for sub-step precision
                float tLo = t - dt;
                float tHi = t;
                for (int r = 0; r < 4; r++) {
                    float tMid = (tLo + tHi) * 0.5;
                    vec3 pMid = rayOrigin + rayDir * tMid;
                    vec3 relMid = pMid - corner;
                    float uMid = dot(relMid, edgeU) / lenU2;
                    float vMid = dot(relMid, edgeV) / lenV2;
                    vec2 uvMid = mix(face.uvMin, face.uvMax, vec2(clamp(uMid,0,1), clamp(vMid,0,1)));
                    float hMid = sampleHeight(face.textureID, uvMid, face.uvMin, face.uvMax,
                                              filterMode, heightSource, face.lumMin, face.lumMax,
                                              invertH, remapMin, remapMax, heightContrast, hOffset,
                                              hasLabPBR, face.normalTexID);
                    // Apply same edge fade during refinement
                    float uMidC = clamp(uMid, 0, 1), vMidC = clamp(vMid, 0, 1);
                    float fadeMid = 1.0;
                    if ((fadeMask & 0x1u) != 0u) fadeMid *= smoothstep(0.0, edgeWidthU, uMidC);
                    if ((fadeMask & 0x2u) != 0u) fadeMid *= smoothstep(0.0, edgeWidthU, 1.0 - uMidC);
                    if ((fadeMask & 0x4u) != 0u) fadeMid *= smoothstep(0.0, edgeWidthV, vMidC);
                    if ((fadeMask & 0x8u) != 0u) fadeMid *= smoothstep(0.0, edgeWidthV, 1.0 - vMidC);
                    float surfMid = (1.0 - hMid) * heightScale * fadeMid;
                    float depMid = -dot(relMid, faceN);
                    if (depMid >= surfMid) tHi = tMid;
                    else tLo = tMid;
                }

                // Report intersection at refined T
                float tHit = (tLo + tHi) * 0.5;
                vec3 pHit = rayOrigin + rayDir * tHit;
                vec3 relHit = pHit - corner;
                float uHit = clamp(dot(relHit, edgeU) / lenU2, 0.0, 1.0);
                float vHit = clamp(dot(relHit, edgeV) / lenV2, 0.0, 1.0);
                vec2 texUVHit = mix(face.uvMin, face.uvMax, vec2(uHit, vHit));

                hitAttribs = vec3(texUVHit, 0.0);
                reportIntersectionEXT(tHit, 0);
                return;
            }
        }

        t += dt;
    }
}
