#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// V2 PR39-prep MVP raygen.
//
// Reads camera matrices from WorldUBO (set 2 binding 0).
// Reads sky from SkyUBO (set 2 binding 2).
// Traces against TLAS (set 1 binding 0).
// Closest-hit shader fills payload with shaded color.
// Writes final color to output radiance image (set 3 binding 0).
//
// No PBR, no shadows, no GI. Just enough to prove the descriptor layout works
// end-to-end with real geometry data.

layout(set = 1, binding = 0) uniform accelerationStructureEXT tlas;

layout(set = 2, binding = 0, std140) uniform WorldUBO {
    mat4 cameraViewMat;
    mat4 cameraEffectedViewMat;
    mat4 cameraProjMat;
    mat4 cameraViewMatInv;
    mat4 cameraEffectedViewMatInv;
    mat4 cameraProjMatInv;
} world;

layout(set = 2, binding = 2, std140) uniform SkyUBO {
    vec3 baseColor;
    uint skyType;
    vec4 horizonColor;
    vec3 sunDirection;
    uint isSunRisingOrSetting;
    vec3 moonDirection;
    float moonDirPad;
} sky;

layout(set = 3, binding = 0, rgba16f) uniform writeonly image2D outImage;

// V1-compatible 160-byte push constant. Most fields ignored by MVP.
layout(push_constant, std430) uniform PushConstants {
    int  numRayBounces;
    int  flags;
    int  areaLightCount;
    float shadowSoftness;
    int  risCandidates;
    int  temporalMClamp;
    int  wClamp;
    float preExposure;
    float pomHeightScale;
    int  pomSteps;
    int  pomRefinement;
    float pomFadeDistance;
    float colorExpansion;
    uint blueNoiseFrame;
    uint64_t sharcHashEntries;
    uint64_t sharcAccumulation;
    uint64_t sharcResolved;
    float sharcCameraX;
    float sharcCameraY;
    float sharcCameraZ;
    float sharcSceneScale;
    uint sharcCapacity;
    float sharcRadianceScale;
    uint sharcFrameIndex;
    float sharcRoughnessThreshold;
    int sharcUpdateBlockSize;
    int sharcUpdateBounces;
    int offlineFlags;
    int accumFrameCount;
    float aperture;
    float focalDistance;
    uint64_t materialClassAddr;
    uint64_t displacedFaceDataAddr;
    int displacedFaceCount;
    int displacementQuality;
} pc;

// Payload: rgb = color, a = hit (0=miss, 1=hit)
layout(location = 0) rayPayloadEXT vec4 hitPayload;

void main() {
    ivec2 pos = ivec2(gl_LaunchIDEXT.xy);
    ivec2 size = ivec2(gl_LaunchSizeEXT.xy);

    vec2 uv = (vec2(pos) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    // Flip Y for Vulkan NDC
    ndc.y = -ndc.y;

    vec4 origin = world.cameraViewMatInv * vec4(0, 0, 0, 1);
    vec4 target = world.cameraProjMatInv * vec4(ndc.x, ndc.y, 1, 1);
    target /= target.w;
    vec4 direction = world.cameraViewMatInv * vec4(normalize(target.xyz), 0);

    hitPayload = vec4(0.0);

    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF,
                0, 0, 0,
                origin.xyz, 0.001,
                direction.xyz, 10000.0,
                0);

    imageStore(outImage, pos, vec4(hitPayload.rgb, 1.0));
}
