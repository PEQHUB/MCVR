#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// V2 PR38: V1-compatible 4-set descriptor layout.
// TLAS lives at set 1 binding 0 (was set 0 binding 0 in PR21-PR36).
// Output radiance at set 3 binding 0.
// Camera matrices read from WorldUBO at set 2 binding 0 (instead of push constant).
// Push constant matches V1's RayTracingPushConstant — most fields ignored by test shader.

layout(set = 1, binding = 0) uniform accelerationStructureEXT tlas;

layout(set = 2, binding = 0, std140) uniform WorldUBO {
    mat4 cameraViewMat;
    mat4 cameraEffectedViewMat;
    mat4 cameraProjMat;
    mat4 cameraViewMatInv;
    mat4 cameraEffectedViewMatInv;
    mat4 cameraProjMatInv;
    // ...rest of WorldUBO unused by test shader
} world;

// SkyUBO from PR37 phase 2 — provides real sun direction and sky colors.
// Layout matches engine::SkyUBOData in scene_resource_service.hpp.
layout(set = 2, binding = 2, std140) uniform SkyUBO {
    vec3 baseColor;
    uint skyType;
    vec4 horizonColor;
    vec3 sunDirection;
    uint isSunRisingOrSetting;
    vec3 moonDirection;
    float moonDirPad;
    // ...rest unused by test shader
} sky;

layout(set = 3, binding = 0, rgba16f) uniform writeonly image2D outImage;

// V1-compatible RayTracingPushConstant (160 bytes). Test shader doesn't read it,
// but the layout must match the C++ side or vkCmdPushConstants gets the wrong size.
layout(push_constant, std430) uniform PushConstants {
    int  numRayBounces;
    int  flags;
    int  areaLightCount;
    float shadowSoftness;
    int  risCandidates;
    int  temporalMClamp;
    int  wClamp;
    float preExposure;
    float pomHeightScale;
    int  pomSteps;
    int  pomRefinement;
    float pomFadeDistance;
    float colorExpansion;
    uint blueNoiseFrame;
    uint64_t sharcHashEntries;
    uint64_t sharcAccumulation;
    uint64_t sharcResolved;
    float sharcCameraX;
    float sharcCameraY;
    float sharcCameraZ;
    float sharcSceneScale;
    uint sharcCapacity;
    float sharcRadianceScale;
    uint sharcFrameIndex;
    float sharcRoughnessThreshold;
    int sharcUpdateBlockSize;
    int sharcUpdateBounces;
    int offlineFlags;
    int accumFrameCount;
    float aperture;
    float focalDistance;
    uint64_t materialClassAddr;
    uint64_t displacedFaceDataAddr;
    int displacedFaceCount;
    int displacementQuality;
} pc;

layout(location = 0) rayPayloadEXT vec3 hitColor;

void main() {
    ivec2 pos = ivec2(gl_LaunchIDEXT.xy);
    ivec2 size = ivec2(gl_LaunchSizeEXT.xy);

    vec2 uv = (vec2(pos) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 origin = world.cameraViewMatInv * vec4(0, 0, 0, 1);
    vec4 target = world.cameraProjMatInv * vec4(ndc.x, ndc.y, 1, 1);
    target /= target.w;
    vec4 direction = world.cameraViewMatInv * vec4(normalize(target.xyz), 0);

    // Default to sky color from SkyUBO — exercises PR37 phase 2 plumbing.
    // Vertical gradient: horizon color near horizon, base color overhead.
    vec3 dir = normalize(direction.xyz);
    float t = clamp(dir.y, 0.0, 1.0);
    hitColor = mix(sky.horizonColor.rgb, sky.baseColor, t);

    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF,
                0, 0, 0,
                origin.xyz, 0.001,
                direction.xyz, 10000.0,
                0);

    // Apply a simple Lambertian-like sun term if the closest-hit shader wrote a non-sky value.
    // (Closest-hit currently writes barycentric × distance — leave that for now.)
    imageStore(outImage, pos, vec4(hitColor, 1.0));
}
