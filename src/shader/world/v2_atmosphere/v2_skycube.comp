#version 460
#extension GL_GOOGLE_include_directive : require

// V2 sky cubemap compute shader.
// Ported from V1's atmosphere/skycube.frag — identical scattering math.
// Dispatched 6 times (one per face via push constant).
// Writes to an imageCube via imageStore(outputCube, ivec3(x, y, face), color).

#include "common/shared.hpp"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) writeonly uniform imageCube outputCube;
layout(set = 0, binding = 1) uniform sampler2D transLUT;
layout(set = 0, binding = 2) uniform SkyBlock { SkyUBO sky; };

layout(push_constant) uniform PC { int face; };

// --- Atmosphere helpers (identical to V1) ---

bool intersectSphere(vec3 ro, vec3 rd, float R, out float tNear, out float tFar) {
    float b = dot(ro, rd);
    float c = dot(ro, ro) - R * R;
    float h = b * b - c;
    if (h < 0.0) return false;
    h = sqrt(h);
    tNear = -b - h;
    tFar  = -b + h;
    return true;
}

float phaseRayleigh(float cosTheta) {
    return 3.0 / (16.0 * PI) * (1.0 + cosTheta * cosTheta);
}

float phaseMieHG(float cosTheta, float g) {
    cosTheta = clamp(cosTheta, -1.0, 1.0);
    g = clamp(g, -0.999, 0.999);
    float g2 = g * g;
    float d = 1.0 + g2 - 2.0 * g * cosTheta;
    float denom = pow(d + 1e-6, 1.5);
    return (1.0 - g2) / (4.0 * PI * denom);
}

vec2 transmittanceUv(float r, float mu) {
    float u = clamp(mu * 0.5 + 0.5, 0.0, 1.0);
    float v = clamp((r - sky.Rg) / (sky.Rt - sky.Rg), 0.0, 1.0);
    return vec2(u, v);
}

float densityExp(float h, float H) {
    return exp(-max(h, 0.0) / H);
}

vec3 sampleTransmittance(float r, float mu) {
    vec2 uv = transmittanceUv(r, mu);

    vec2 invSize = 1.0 / vec2(textureSize(transLUT, 0));
    uv = clamp(uv, 0.5 * invSize, 1.0 - 0.5 * invSize);

    return texture(transLUT, uv).rgb;
}

vec3 integrateSingleScattering(vec3 ro, vec3 rd, bool isSun) {
    float tAtm0, tAtm1;
    if (!intersectSphere(ro, rd, sky.Rt, tAtm0, tAtm1)) return vec3(0.0);
    tAtm0 = max(tAtm0, 0.0);

    // Stop at ground
    float tG0, tG1;
    if (intersectSphere(ro, rd, sky.Rg, tG0, tG1)) {
        float tHitG = (tG0 > 0.0) ? tG0 : tG1;
        if (tHitG > 0.0) tAtm1 = min(tAtm1, tHitG);
    }

    const int STEPS = 32;
    float dt = (tAtm1 - tAtm0) / float(STEPS);

    vec3 L = vec3(0.0);
    vec3 T_view = vec3(1.0);

    vec3 lightDir = normalize(isSun ? sky.sunDirection : sky.moonDirection);
    float cosTheta = dot(lightDir, rd);
    float pr = phaseRayleigh(cosTheta);
    float pm = phaseMieHG(cosTheta, sky.mieG);

    for (int i = 0; i < STEPS; i++) {
        float t = tAtm0 + (float(i) + 0.5) * dt;
        vec3 x = ro + rd * t;

        float r = length(x);
        float h = r - sky.Rg;

        float dR = densityExp(h, sky.Hr);
        float dM = densityExp(h, sky.Hm);

        vec3 sigmaS_R = sky.betaR * dR;
        vec3 sigmaS_M = sky.betaM * dM;
        vec3 sigmaT   = sigmaS_R + sigmaS_M;

        vec3 up  = x / r;
        float muS = dot(up, lightDir);
        vec3 T_sun = sampleTransmittance(r, muS);

        vec3 S = sigmaS_R * pr + sigmaS_M * pm;
        vec3 sourceRadiance = isSun
            ? (sky.sunRadiance * sky.envCelestial.z)
            : (sky.moonRadiance * sky.envCelestial.w);
        vec3 dL = T_view * (T_sun * (S * sourceRadiance)) * dt;

        L += dL;
        T_view *= exp(-sigmaT * dt);
    }

    return L;
}

vec3 cubemapDir(int f, vec2 uv01) {
    vec2 uv = uv01 * 2.0 - 1.0;
    if (f == 0) return normalize(vec3( 1, -uv.y, -uv.x)); // +X
    if (f == 1) return normalize(vec3(-1, -uv.y,  uv.x)); // -X
    if (f == 2) return normalize(vec3( uv.x,  1,  uv.y)); // +Y
    if (f == 3) return normalize(vec3( uv.x, -1, -uv.y)); // -Y
    if (f == 4) return normalize(vec3( uv.x, -uv.y,  1)); // +Z
    return              normalize(vec3(-uv.x, -uv.y, -1)); // -Z
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    int dim = imageSize(outputCube).x;
    if (gid.x >= dim || gid.y >= dim) return;

    vec2 uv = (vec2(gid) + 0.5) / float(dim);
    vec3 rd = cubemapDir(face, uv);

    // Clamp below-horizon directions to avoid ground leak
    float blend = smoothstep(-0.05, 0.02, rd.y);
    rd.y = max(rd.y, sky.minViewCos);
    rd = normalize(mix(vec3(rd.x, sky.minViewCos, rd.z), rd, blend));

    // Camera at surface level + 70m offset (matches V1)
    vec3 ro = vec3(0.0, sky.Rg + 70.0, 0.0);

    vec3 L = integrateSingleScattering(ro, rd, false)
           + integrateSingleScattering(ro, rd, true);

    imageStore(outputCube, ivec3(gid, face), vec4(L, 1.0));
}
