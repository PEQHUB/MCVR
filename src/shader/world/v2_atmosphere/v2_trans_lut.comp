#version 460
#extension GL_GOOGLE_include_directive : require

// V2 transmittance LUT compute shader.
// Ported from V1's atmosphere/trans_lut.frag — identical math, imageStore output.
// Generates a 2D LUT mapping (cosTheta, altitude) → transmittance RGB.

#include "common/shared.hpp"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) writeonly uniform image2D outputLUT;
layout(set = 0, binding = 1) uniform SkyBlock { SkyUBO sky; };

bool intersectSphere(vec3 ro, vec3 rd, float R, out float tNear, out float tFar) {
    float b = dot(ro, rd);
    float c = dot(ro, ro) - R * R;
    float h = b * b - c;
    if (h < 0.0) return false;
    h = sqrt(h);
    tNear = -b - h;
    tFar  = -b + h;
    return true;
}

float densityExp(float h, float H) {
    return exp(-max(h, 0.0) / H);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dim = imageSize(outputLUT);
    if (gid.x >= dim.x || gid.y >= dim.y) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(dim);

    float mu = uv.x * 2.0 - 1.0;                // cosine of zenith angle [-1, 1]
    float r  = mix(sky.Rg, sky.Rt, uv.y);        // radius [Rg, Rt]

    vec3 ro = vec3(0.0, r, 0.0);
    float sinTheta = sqrt(max(1.0 - mu * mu, 0.0));
    vec3 rd = normalize(vec3(sinTheta, mu, 0.0));

    float t0, t1;
    if (!intersectSphere(ro, rd, sky.Rt, t0, t1)) {
        imageStore(outputLUT, gid, vec4(1.0));
        return;
    }
    t0 = max(t0, 0.0);

    const int STEPS = 128;
    float dt = (t1 - t0) / float(STEPS);
    vec3 opticalDepth = vec3(0.0);

    for (int i = 0; i < STEPS; i++) {
        float t = t0 + (float(i) + 0.5) * dt;
        vec3 x  = ro + rd * t;
        float rr = length(x);
        float h  = rr - sky.Rg;

        float dR = densityExp(h, sky.Hr);
        float dM = densityExp(h, sky.Hm);

        vec3 sigmaT = sky.betaR * dR + sky.betaM * dM;
        opticalDepth += sigmaT * dt;
    }

    vec3 T = exp(-opticalDepth);
    imageStore(outputLUT, gid, vec4(T, 1.0));
}
