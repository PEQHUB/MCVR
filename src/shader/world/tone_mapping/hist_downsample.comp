#version 460

// Quarter-res downsample of render-res HDR for histogram metering.
// 4x4 box filter averages 16 full-res texels into 1 quarter-res texel.
// The quarter-res image (~1.0MB RGBA16F at 1080p) stays warm in L2 cache
// even after DLSS-RR trashes the L2, fixing the 6.8% L2 hit rate that
// causes 49% L1TEX stall in the ToneMapping range.

layout(set = 0, binding = 4) uniform sampler2D uHdrRenderRes;
layout(set = 0, binding = 5, rgba16f) uniform image2D uHdrQuarterRes;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec2 qCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 qSize = imageSize(uHdrQuarterRes);
    if (qCoord.x >= qSize.x || qCoord.y >= qSize.y) return;

    // Source coordinates: 4x4 block in full-res image
    ivec2 srcBase = qCoord * 4;
    ivec2 srcSize = textureSize(uHdrRenderRes, 0);

    // Box filter: average up to 16 texels (handle edges)
    vec3 acc = vec3(0.0);
    float count = 0.0;
    for (int dy = 0; dy < 4; dy++) {
        for (int dx = 0; dx < 4; dx++) {
            ivec2 s = srcBase + ivec2(dx, dy);
            if (s.x < srcSize.x && s.y < srcSize.y) {
                acc += texelFetch(uHdrRenderRes, s, 0).rgb;
                count += 1.0;
            }
        }
    }

    vec3 result = (count > 0.0) ? (acc / count) : vec3(0.0);
    imageStore(uHdrQuarterRes, qCoord, vec4(result, 1.0));
}
