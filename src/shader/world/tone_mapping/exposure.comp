#version 460
#define NUM_BINS 256

layout(set = 0, binding = 1) buffer HistogramBuffer {
    uint bins[NUM_BINS];
}
gHist;

layout(set = 0, binding = 2) buffer ExposureBuffer {
    float exposure;
    float avgLogLum;
    float tonemapMode;
    float Lwhite;
    float exposureCompensation;
    // HDR fields (appended)
    float hdrPipelineEnabled;
    float hdr10OutputEnabled;
    float peakNits;
    float paperWhiteNits;
    float saturation;
    float sdrTransferFunction;
    float capExposureSmoothed;
    float manualExposureEnabled;
    float manualExposure;
    // PsychoV tonemapper parameters
    float psychoEnabled;
    float psychoHighlights;
    float psychoShadows;
    float psychoContrast;
    float psychoPurity;
    float psychoBleaching;
    float psychoClipPoint;
    float psychoHueRestore;
    float psychoAdaptContrast;
    float psychoWhiteCurve;
    float psychoConeExponent;
    float saturationAdaptive;
    float tonemapParam0;
    float tonemapParam1;
    float tonemapParam2;
    float tonemapParam3;
    float tonemapParam4;
    float tonemapParam5;
    float tonemapParam6;
    float tonemapParam7;
    // Shader-side boot adaptation timer: only ticks when actual adaptation runs (not during loading).
    // Zeroed by GPU buffer fill on world load. Replaces CPU-side timeSinceReset.
    float bootTimer;
}
expData;

layout(push_constant) uniform PushConstant {
    float log2Min;
    float log2Max;
    float epsilon;
    float lowPercent;
    float highPercent;
    float middleGrey;
    float dt;
    float speedUp;
    float speedDown;
    float brightAdaptBoost;
    float minExposure;
    float maxExposure;
    float tonemapMode;
    float Lwhite;
    float exposureCompensation;
    float legacyExposure;
    float highlightPercent;
    float highlightProtection;
    float highlightSmoothingSpeed;
    // HDR fields
    float hdrPipelineEnabled;
    float hdr10OutputEnabled;
    float peakNits;
    float paperWhiteNits;
    float saturation;
    float sdrTransferFunction;
    float manualExposureEnabled;
    float manualExposure;
    // PsychoV tonemapper parameters
    float psychoEnabled;
    float psychoHighlights;
    float psychoShadows;
    float psychoContrast;
    float psychoPurity;
    float psychoBleaching;
    float psychoClipPoint;
    float psychoHueRestore;
    float psychoAdaptContrast;
    float psychoWhiteCurve;
    float psychoConeExponent;
    float saturationAdaptive;
    float tonemapParam0;
    float tonemapParam1;
    float tonemapParam2;
    float tonemapParam3;
    float tonemapParam4;
    float tonemapParam5;
    float tonemapParam6;
    float tonemapParam7;
}
pc;

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint total = 0u;
    for (uint i = 0u; i < NUM_BINS; ++i) total += gHist.bins[i];

    if (total == 0u) {
        expData.avgLogLum = pc.log2Min;
        if (pc.manualExposureEnabled > 0.5) {
            expData.exposure = clamp(pc.manualExposure, pc.minExposure, pc.maxExposure);
        } else if (expData.exposure > 0.0) {
            // Only clamp if we have a valid exposure; keep 0.0 from GPU buffer reset
            // so the snap-to-target logic works on the first frame with actual scene data
            expData.exposure = clamp(expData.exposure, pc.minExposure, pc.maxExposure);
        }
        // Don't advance bootTimer here — loading frames shouldn't consume grace period
        return;
    }

    float fTotal = float(total);
    uint lowCount = uint(clamp(pc.lowPercent, 0.0, 1.0) * fTotal);
    uint highCount = uint(clamp(pc.highPercent, 0.0, 1.0) * fTotal);
    if (highCount <= lowCount) highCount = lowCount + 1u;

    uint cumulative = 0u;
    double sumLog = 0.0;
    uint used = 0u;

    float binCountF = float(NUM_BINS);
    float log2Range = pc.log2Max - pc.log2Min;

    for (uint i = 0u; i < NUM_BINS; ++i) {
        uint c = gHist.bins[i];
        if (c == 0u) continue;

        uint next = cumulative + c;

        uint a = max(cumulative, lowCount);
        uint b = min(next, highCount);
        if (b > a) {
            uint take = b - a;

            float t = (float(i) + 0.5) / binCountF;
            float logLum = pc.log2Min + t * log2Range;

            sumLog += double(logLum) * double(take);
            used += take;
        }
        cumulative = next;
        if (cumulative >= highCount) break;
    }

    float avgLogLum = (used > 0u) ? float(sumLog / double(used)) : pc.log2Min;
    float avgLum = exp2(avgLogLum);

    if (pc.manualExposureEnabled > 0.5) {
        expData.avgLogLum = avgLogLum;
        expData.exposure = clamp(pc.manualExposure, pc.minExposure, pc.maxExposure);
        expData.tonemapMode = pc.tonemapMode;
        expData.Lwhite = pc.Lwhite;
        expData.exposureCompensation = pc.exposureCompensation;
        expData.hdrPipelineEnabled = pc.hdrPipelineEnabled;
        expData.hdr10OutputEnabled = pc.hdr10OutputEnabled;
        expData.peakNits = pc.peakNits;
        expData.paperWhiteNits = pc.paperWhiteNits;
        expData.saturation = pc.saturation;
        expData.sdrTransferFunction = pc.sdrTransferFunction;
        expData.manualExposureEnabled = pc.manualExposureEnabled;
        expData.manualExposure = pc.manualExposure;
        // PsychoV pass-through
        expData.psychoEnabled = pc.psychoEnabled;
        expData.psychoHighlights = pc.psychoHighlights;
        expData.psychoShadows = pc.psychoShadows;
        expData.psychoContrast = pc.psychoContrast;
        expData.psychoPurity = pc.psychoPurity;
        expData.psychoBleaching = pc.psychoBleaching;
        expData.psychoClipPoint = pc.psychoClipPoint;
        expData.psychoHueRestore = pc.psychoHueRestore;
        expData.psychoAdaptContrast = pc.psychoAdaptContrast;
        expData.psychoWhiteCurve = pc.psychoWhiteCurve;
        expData.psychoConeExponent = pc.psychoConeExponent;
        expData.saturationAdaptive = pc.saturationAdaptive;
        expData.tonemapParam0 = pc.tonemapParam0;
        expData.tonemapParam1 = pc.tonemapParam1;
        expData.tonemapParam2 = pc.tonemapParam2;
        expData.tonemapParam3 = pc.tonemapParam3;
        expData.tonemapParam4 = pc.tonemapParam4;
        expData.tonemapParam5 = pc.tonemapParam5;
        expData.tonemapParam6 = pc.tonemapParam6;
        expData.tonemapParam7 = pc.tonemapParam7;
        return;
    }

    // Legacy target: expose middle-grey to the trimmed mean.
    float targetExposure = pc.middleGrey / max(avgLum, 1e-6);
    // Work in compensated exposure space for temporal adaptation.
    float targetComp = targetExposure * exp2(pc.exposureCompensation);

    // Iris response: compute a hard exposure ceiling from bright content.
    // Applied AFTER temporal adaptation so it takes effect immediately,
    // like real pupil constriction (~0.2s) vs slow scene adaptation (~2-5s).
    float irisCap = 3.4e38; // no cap by default
    if (pc.legacyExposure < 0.5) {
        // Find 99.95th percentile luminance (top 0.05% of pixels).
        // At 1080p ~1000 pixels — catches even a distant torch.
        uint brightThresh = max(uint(fTotal * 0.0005), 1u);
        uint cumTop = 0u;
        float brightLogLum = avgLogLum;
        for (int i = int(NUM_BINS) - 1; i >= 0; --i) {
            cumTop += gHist.bins[i];
            if (cumTop >= brightThresh) {
                float tB = (float(i) + 0.5) / binCountF;
                brightLogLum = pc.log2Min + tB * log2Range;
                break;
            }
        }

        // EV contrast between bright peak and scene average.
        float evContrast = brightLogLum - avgLogLum;

        // Onset at 3 EV (8x brighter), full at 8 EV (256x).
        // 0.3 blend factor: raises effective luminance -> drops exposure ~3 EV.
        float irisStrength = smoothstep(3.0, 8.0, evContrast) * 0.3;

        float irisExposure;
        if (irisStrength > 0.0) {
            float irisLogLum = mix(avgLogLum, brightLogLum, irisStrength);
            float irisLum = exp2(irisLogLum);
            irisExposure = pc.middleGrey / max(irisLum, 1e-6) * exp2(pc.exposureCompensation);
        } else {
            irisExposure = targetComp; // no bright content -> relax cap
        }

        // Asymmetric temporal smoothing: fast constriction, slow dilation.
        // Constriction (cap dropping): ~80ms half-life (speed 8.0)
        // Dilation (cap rising):       ~700ms half-life (speed 1.0)
        float prevCap = expData.capExposureSmoothed;
        if (prevCap <= 0.0) prevCap = irisExposure;
        float prevLog = log2(max(prevCap, 1e-6));
        float rawLog  = log2(max(irisExposure, 1e-6));
        float capSpeed = (rawLog < prevLog) ? 8.0 : 1.0; // fast down, slow up
        float kSmooth = 1.0 - exp(-pc.dt * capSpeed);
        irisCap = exp2(mix(prevLog, rawLog, clamp(kSmooth, 0.0, 1.0)));
        expData.capExposureSmoothed = irisCap;
    }

    float prevComp = expData.exposure;
    if (prevComp <= 0.0) prevComp = targetComp;

    // Natural adaptation: clamp EV change per second.
    float prevEV = log2(max(prevComp, 1e-6));
    float targetEV = log2(max(targetComp, 1e-6));

    // Dead zone: ignore EV differences below threshold to prevent shimmer/breathing
    // 0.05 EV ≈ 3.5% luminance change — below perceptual threshold
    float evDiff = targetEV - prevEV;
    if (abs(evDiff) < 0.05) evDiff = 0.0;

    // Scale adaptation speed by magnitude of change: large jumps (cave entry) stay fast,
    // subtle changes (turning slightly) become very slow, reducing pumping
    float evMagnitude = abs(evDiff);
    float rateScale = smoothstep(0.0, 1.0, evMagnitude); // 0..1 EV → 0..1 scale
    rateScale = max(rateScale, 0.1); // never fully zero so it still converges

    // Fast adaptation on world load: 50x speed at t=0, smooth ramp to 1x over 8 seconds.
    // bootTimer lives in ExposureBuffer — only ticks when this adaptation path runs,
    // so loading frames (histogram empty → early return) don't consume the grace period.
    float bootMult = 1.0 + 49.0 * clamp(1.0 - expData.bootTimer / 8.0, 0.0, 1.0);
    float upRate = max(pc.speedUp, 0.0) * rateScale * bootMult;
    float downRate = max(pc.speedDown, 0.0) * rateScale * bootMult;
    if (pc.legacyExposure < 0.5 && evDiff < 0.0) {
        downRate *= max(pc.brightAdaptBoost, 1.0);
    }

    float maxUp = upRate * pc.dt;
    float maxDown = downRate * pc.dt;
    float delta = clamp(evDiff, -maxDown, +maxUp);
    float adaptedComp = exp2(prevEV + delta);

    // Apply iris cap as hard ceiling AFTER adaptation.
    // This bypasses the slow temporal adaptation, giving immediate response
    // to bright emitters entering the frame (like real pupil constriction).
    adaptedComp = min(adaptedComp, irisCap);

    expData.avgLogLum = avgLogLum;
    float effectiveMaxExposure = pc.maxExposure;
    expData.exposure = clamp(adaptedComp, pc.minExposure, effectiveMaxExposure);

    // Advance boot timer only when adaptation actually ran (not during loading early-returns)
    expData.bootTimer += pc.dt;

    expData.tonemapMode = pc.tonemapMode;
    expData.Lwhite = pc.Lwhite;
    expData.exposureCompensation = pc.exposureCompensation;
    // Pass through HDR settings to fragment shader
    expData.hdrPipelineEnabled = pc.hdrPipelineEnabled;
    expData.hdr10OutputEnabled = pc.hdr10OutputEnabled;
    expData.peakNits = pc.peakNits;
    expData.paperWhiteNits = pc.paperWhiteNits;
    expData.saturation = pc.saturation;
    expData.sdrTransferFunction = pc.sdrTransferFunction;
    expData.manualExposureEnabled = pc.manualExposureEnabled;
    expData.manualExposure = pc.manualExposure;
    // PsychoV pass-through
    expData.psychoEnabled = pc.psychoEnabled;
    expData.psychoHighlights = pc.psychoHighlights;
    expData.psychoShadows = pc.psychoShadows;
    expData.psychoContrast = pc.psychoContrast;
    expData.psychoPurity = pc.psychoPurity;
    expData.psychoBleaching = pc.psychoBleaching;
    expData.psychoClipPoint = pc.psychoClipPoint;
    expData.psychoHueRestore = pc.psychoHueRestore;
    expData.psychoAdaptContrast = pc.psychoAdaptContrast;
    expData.psychoWhiteCurve = pc.psychoWhiteCurve;
    expData.psychoConeExponent = pc.psychoConeExponent;
    expData.saturationAdaptive = pc.saturationAdaptive;
    expData.tonemapParam0 = pc.tonemapParam0;
    expData.tonemapParam1 = pc.tonemapParam1;
    expData.tonemapParam2 = pc.tonemapParam2;
    expData.tonemapParam3 = pc.tonemapParam3;
    expData.tonemapParam4 = pc.tonemapParam4;
    expData.tonemapParam5 = pc.tonemapParam5;
    expData.tonemapParam6 = pc.tonemapParam6;
    expData.tonemapParam7 = pc.tonemapParam7;
}
