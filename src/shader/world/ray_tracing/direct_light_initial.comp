#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require

#include "common/shared.hpp"

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D primarySurfaceImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D firstHitDiffuseDirectLightImage;
layout(set = 0, binding = 2, r16f) uniform readonly image2D directLightDepthImage;
layout(set = 0, binding = 3, rgba32f) uniform writeonly image2D reservoirImage;
layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D directLightOutputImage;

layout(set = 0, binding = 5) buffer DirectLightCounters {
    uint counters[];
} directLightCounters;

layout(set = 0, binding = 6, rgba32f) uniform readonly image2D positionViewSpaceImage;
layout(set = 0, binding = 7, rgba8) uniform readonly image2D diffuseAlbedoImage;
layout(set = 0, binding = 8) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 9) readonly buffer AreaLightBuffer {
    AreaLight lights[];
} areaLightBuffer;
layout(set = 0, binding = 10) readonly buffer TileLightBuffer {
    uint data[];
} tileLightBuffer;
layout(set = 0, binding = 11) uniform WorldUniform {
    WorldUBO worldUBO;
};
layout(set = 0, binding = 12) uniform SkyUniform {
    SkyUBO skyUBO;
};

layout(push_constant) uniform PushConstant {
    int width;
    int height;
    int areaLightCount;
    int maxLightsPerTile;
    float shadowSoftness;
    int maxAreaLightSamples;
} pc;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float DIRECT_LIGHT_PI = 3.14159265358979323846;
const int TILE_SIZE = 16;

float luminance(vec3 value) {
    return dot(value, vec3(0.2126, 0.7152, 0.0722));
}

uint hashPixel(ivec2 pixel) {
    uint x = uint(pixel.x) * 0x9E3779B9u;
    uint y = uint(pixel.y) * 0x85EBCA6Bu;
    uint h = x ^ y ^ worldUBO.seed;
    h ^= h >> 16;
    h *= 0x7FEB352Du;
    h ^= h >> 15;
    h *= 0x846CA68Bu;
    h ^= h >> 16;
    return h;
}

bool traceOccluded(vec3 origin, vec3 normal, vec3 direction, float tMax) {
    vec3 offsetN = dot(direction, normal) >= 0.0 ? normal : -normal;
    vec3 rayOrigin = origin + offsetN * 0.002;

    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        WORLD_MASK | PLAYER_MASK,
        rayOrigin, 0.001, direction, tMax);
    while (rayQueryProceedEXT(query)) {}
    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 directionalDirect(vec3 worldPos, vec3 normal, vec3 albedo) {
    if (skyUBO.skyType != 1u || skyUBO.hasBlindnessOrDarkness > 0u) {
        return vec3(0.0);
    }

    vec3 lightDir = normalize(skyUBO.sunDirection);
    vec3 lightRadiance = skyUBO.sunRadiance * skyUBO.envCelestial.z;
    if (lightDir.y < 0.0) {
        lightDir = normalize(skyUBO.moonDirection);
        lightRadiance = skyUBO.moonRadiance * skyUBO.envCelestial.w;
    }

    float nDotL = max(dot(normal, lightDir), 0.0);
    if (nDotL <= 0.0) {
        return vec3(0.0);
    }

    atomicAdd(directLightCounters.counters[7], 1u);
    atomicAdd(directLightCounters.counters[8], 1u);
    bool occluded = traceOccluded(worldPos, normal, lightDir, 1000.0);
    atomicAdd(directLightCounters.counters[4], 1u);
    if (occluded) {
        return vec3(0.0);
    }
    atomicAdd(directLightCounters.counters[9], 1u);

    float rainFade = clamp(skyUBO.rainGradient, 0.0, 1.0);
    return lightRadiance * (albedo / DIRECT_LIGHT_PI) * nDotL * (1.0 - rainFade);
}

vec3 areaLightDirect(ivec2 pixel, vec3 worldPos, vec3 normal, vec3 albedo) {
    if (pc.areaLightCount <= 0 || pc.maxLightsPerTile <= 0 || pc.maxAreaLightSamples <= 0) {
        return vec3(0.0);
    }

    int tilesX = (pc.width + TILE_SIZE - 1) / TILE_SIZE;
    int tileX = clamp(pixel.x / TILE_SIZE, 0, max(tilesX - 1, 0));
    int tileY = clamp(pixel.y / TILE_SIZE, 0, max((pc.height + TILE_SIZE - 1) / TILE_SIZE - 1, 0));
    int base = (tileY * tilesX + tileX) * (1 + pc.maxLightsPerTile);
    uint tileCount = min(tileLightBuffer.data[base], uint(pc.maxLightsPerTile));
    if (tileCount == 0u) {
        return vec3(0.0);
    }
    atomicAdd(directLightCounters.counters[10], 1u);

    uint seed = hashPixel(pixel);
    uint start = seed % tileCount;
    int samples = min(int(tileCount), pc.maxAreaLightSamples);
    vec3 accum = vec3(0.0);

    for (int s = 0; s < samples; ++s) {
        uint slot = (start + uint(s)) % tileCount;
        uint lightIndex = tileLightBuffer.data[base + 1 + int(slot)];
        if (lightIndex >= uint(pc.areaLightCount)) {
            continue;
        }

        AreaLight al = areaLightBuffer.lights[lightIndex];
        vec3 toLight = al.position - worldPos;
        float dist2 = dot(toLight, toLight);
        float dist = sqrt(max(dist2, 1e-6));
        vec3 lightDir = toLight / dist;
        vec3 absToLight = abs(toLight);
        float cullDist = max(absToLight.x, max(absToLight.y, absToLight.z));
        if (cullDist > al.radius || dist < 0.05) {
            continue;
        }

        float nDotL = max(dot(normal, lightDir), 0.0);
        if (nDotL <= 0.0) {
            continue;
        }

        atomicAdd(directLightCounters.counters[11], 1u);
        atomicAdd(directLightCounters.counters[12], 1u);
        bool occluded = traceOccluded(worldPos, normal, lightDir, max(dist - al.halfExtent - 0.02, 0.01));
        atomicAdd(directLightCounters.counters[4], 1u);
        if (occluded) {
            continue;
        }
        atomicAdd(directLightCounters.counters[13], 1u);

        float invDist2 = 1.0 / max(dist2, 0.01);
        float f = cullDist / max(al.radius, 0.001);
        float window = max(1.0 - f * f, 0.0);
        window *= window;
        float atten = invDist2 * window;
        if (al.halfExtent >= 0.01) {
            float side = al.halfExtent * 2.0;
            float faceArea = side * side;
            vec3 absDir = abs(lightDir);
            float cosLight = max(absDir.x, max(absDir.y, absDir.z));
            atten *= faceArea * cosLight;
        }

        accum += al.color * al.intensity * atten * (albedo / DIRECT_LIGHT_PI) * nDotL;
    }

    return accum;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }

    vec4 primary = imageLoad(primarySurfaceImage, pixel);
    float directHitT = imageLoad(directLightDepthImage, pixel).r;
    vec4 viewPos = imageLoad(positionViewSpaceImage, pixel);
    vec3 albedo = max(imageLoad(diffuseAlbedoImage, pixel).rgb, vec3(0.0));

    bool primaryValid = dot(primary.xyz, primary.xyz) > 0.25;
    if (!primaryValid || viewPos.a <= 0.5 || luminance(albedo) <= 0.000001) {
        imageStore(reservoirImage, pixel, vec4(0.0));
        imageStore(directLightOutputImage, pixel, vec4(0.0));
        imageStore(firstHitDiffuseDirectLightImage, pixel, vec4(vec3(0.0), 0.0));
        return;
    }

    vec3 normal = normalize(primary.xyz);
    vec3 worldPos = vec3(worldUBO.cameraEffectedViewMatInv * vec4(viewPos.xyz, 1.0));
    vec3 radiance = directionalDirect(worldPos, normal, albedo)
        + areaLightDirect(pixel, worldPos, normal, albedo);
    float lum = luminance(radiance);
    bool hasDirectSample = lum > 0.000001;

    float confidence = hasDirectSample ? 1.0 : 0.0;
    imageStore(reservoirImage, pixel, vec4(radiance, confidence));
    imageStore(directLightOutputImage, pixel, vec4(radiance, confidence));
    imageStore(firstHitDiffuseDirectLightImage, pixel, vec4(radiance, 1.0));

    atomicAdd(directLightCounters.counters[1], 1u);
    atomicAdd(directLightCounters.counters[14], 1u);
    if (hasDirectSample) {
        atomicAdd(directLightCounters.counters[15], 1u);
    }
    if (directHitT > 0.0 && directHitT < 65500.0 && !isnan(directHitT) && !isinf(directHitT)) {
        atomicAdd(directLightCounters.counters[5], 1u);
    }
}
