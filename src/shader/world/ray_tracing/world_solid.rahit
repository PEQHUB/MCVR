#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../util/ray_payloads.glsl"
#include "../util/util.glsl"
#include "common/shared.hpp"

#include "../util/sprite_fetch.glsl"
#include "../util/displacement.glsl"

layout(set = 1, binding = 1) readonly buffer BLASOffsets {
    uint offsets[];
}
blasOffsets;

layout(set = 1, binding = 2) readonly buffer VertexBufferAddr {
    uint64_t addrs[];
}
vertexBufferAddrs;

layout(set = 1, binding = 3) readonly buffer IndexBufferAddr {
    uint64_t addrs[];
}
indexBufferAddrs;

#include "../util/vertex_fetch.glsl"

layout(set = 2, binding = 0) uniform Uniform {
    WorldUBO ubo;
};

layout(push_constant) uniform PushConstant {
    int numRayBounces;
    int flags;
    int reservedLighting0;
    float reservedLighting1;
    int reservedLighting2;
    int reservedLighting3;
    int reservedLighting4;
    float preExposure;
    float displacementDepthScale;
    int displacementPrimarySteps;
    int displacementRefinementSteps;
    float displacementFadeDistanceBlocks;
    uint blueNoiseFrame;
    uint rtDebugFlags;
    uint handInstanceCount;
    uint reservedPc0;
    uint64_t sharcHashEntries;
    uint64_t sharcAccumulation;
    uint64_t sharcResolved;
    float sharcCameraX;
    float sharcCameraY;
    float sharcCameraZ;
    float sharcSceneScale;
    uint sharcCapacity;
    float sharcRadianceScale;
    uint sharcFrameIndex;
    float sharcRoughnessThreshold;
    int sharcUpdateBlockSize;
    int sharcUpdateBounces;
    int sharcQueryMode;
    int sharcQueryReserved;
    int offlineFlags;
    int accumFrameCount;
    float aperture;
    float focalDistance;
    uint64_t reservedAddr;
} pc;

layout(location = 0) rayPayloadInEXT PrimaryRay mainRay;
hitAttributeEXT vec2 attribs;

bool solidAuthoredDisplacementBlockHit(UnpackedVertex v0,
                                       UnpackedVertex v1,
                                       UnpackedVertex v2,
                                       vec2 textureUV,
                                       uint textureID) {
    if (pc.displacementDepthScale <= DISPLACEMENT_MIN_DEPTH ||
        pc.displacementFadeDistanceBlocks <= DISPLACEMENT_MIN_DEPTH ||
        gl_HitTEXT >= pc.displacementFadeDistanceBlocks ||
        prGetIsHand(mainRay) ||
        (v0.flags & PBR_FLAG_BLOCK_GEOMETRY) == 0u ||
        (v0.flags & PBR_FLAG_FLUID_GEOMETRY) != 0u ||
        (v0.emissiveBlockType & PBR_PACKED_THIN_CUTOUT_PLANT) != 0u ||
        (v0.flags & PBR_FLAG_USE_TEXTURE) == 0u ||
        !displacementBlockHasAuthoredHeight(textureID)) {
        return true;
    }

    uint coordinateMode = (v0.flags & PBR_FLAG_COORD_MASK) >> PBR_FLAG_COORD_SHIFT;
    if (coordinateMode != 0u) return true;

    vec3 wp0 = vec3(gl_ObjectToWorldEXT * vec4(v0.pos, 1.0));
    vec3 wp1 = vec3(gl_ObjectToWorldEXT * vec4(v1.pos, 1.0));
    vec3 wp2 = vec3(gl_ObjectToWorldEXT * vec4(v2.pos, 1.0));

    vec3 dPdu;
    vec3 dPdv;
    vec3 baseNormal;
    if (!displacementBuildBasis(wp0, wp1, wp2, v0.textureUV, v1.textureUV, v2.textureUV,
                                dPdu, dPdv, baseNormal)) {
        return true;
    }

    vec3 rayDir = gl_WorldRayDirectionEXT;
    vec3 viewDir = -rayDir;
    if (dot(baseNormal, viewDir) < 0.0) {
        baseNormal = -baseNormal;
    }

    vec2 displacementChartOffset = vec2(0.0);
    displacementBuildBlockChart(v0.postBase, dPdu, dPdv, displacementChartOffset);

    float fade = 1.0 - smoothstep(pc.displacementFadeDistanceBlocks * 0.75,
                                  pc.displacementFadeDistanceBlocks, gl_HitTEXT);
    TextureRuleEntry displacementRule = safeTextureRuleEntry(textureID);
    float materialDisplacementScale = ((displacementRule.flags & TEXTURE_RULE_ENABLED) != 0u
        && (displacementRule.flags & TEXTURE_RULE_DISPLACEMENT_SCALE) != 0u)
        ? clamp(displacementRule.displacementScale, 0.0, 4.0)
        : 1.0;

    DisplacementSource displacementSource;
    displacementInitSource(displacementSource);
    displacementSource.isBlock = true;
    displacementSource.textureID = textureID;
    displacementSource.normalTextureID = -1;
    displacementSource.animTick = ubo.animTick;
    displacementSource.uvMin = min(min(v0.textureUV, v1.textureUV), v2.textureUV) + displacementChartOffset;
    displacementSource.uvMax = max(max(v0.textureUV, v1.textureUV), v2.textureUV) + displacementChartOffset;
    displacementSource.maxDepth = max(pc.displacementDepthScale, 0.0) * fade * materialDisplacementScale;
    displacementSource.mode = DISPLACEMENT_SOURCE_AUTHORED_NORMAL_ALPHA;
    displacementSource.boundaryWalls = false;

    if (displacementSource.maxDepth <= DISPLACEMENT_MIN_DEPTH) {
        return true;
    }

    vec3 planeWorldPos = gl_WorldRayOriginEXT + rayDir * gl_HitTEXT;
    DisplacementHit displacementHit;
    return displacementTracePrimary(displacementSource, textureUV + displacementChartOffset, planeWorldPos, rayDir,
                                    viewDir, dPdu, dPdv, baseNormal,
                                    clamp(pc.displacementPrimarySteps, 1, 512),
                                    pc.displacementRefinementSteps, displacementHit);
}

void main() {
    uint instanceID = gl_InstanceCustomIndexEXT;
    uint geometryID = gl_GeometryIndexEXT;

    uint blasOffset;
    uint vertexFormat;
    UnpackedVertex v0, v1, v2;
    fetchTriangleVertices(instanceID, geometryID, gl_PrimitiveID, v0, v1, v2, blasOffset, vertexFormat);

    vec3 baryCoords = vec3(1.0 - (attribs.x + attribs.y), attribs.x, attribs.y);
    vec2 textureUV = baryCoords.x * v0.textureUV + baryCoords.y * v1.textureUV + baryCoords.z * v2.textureUV;

    if (!solidAuthoredDisplacementBlockHit(v0, v1, v2, textureUV, v0.textureID)) {
        ignoreIntersectionEXT;
    }
}
