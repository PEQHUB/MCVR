#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#ifndef RARSER_SHADER_DISPLACEMENT
#define RARSER_SHADER_DISPLACEMENT 1
#endif

#include "../util/labpbr.glsl"
#include "../util/random.glsl"
#include "../util/ray_cone.glsl"
#include "../util/ray_payloads.glsl"
#include "../util/util.glsl"
#include "common/shared.hpp"
#include "../util/colorspace.glsl"
#include "../util/texture_rules.glsl"
#include "../util/fft_water.glsl"
#include "../util/shader_pack_visual_settings.glsl"

layout(set = 0, binding = 0) uniform sampler2D textures[];

#include "../util/sprite_fetch.glsl"
#if RARSER_SHADER_DISPLACEMENT
#include "../util/displacement.glsl"
#endif

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;

layout(set = 1, binding = 1) readonly buffer BLASOffsets {
    uint offsets[];
}
blasOffsets;

layout(set = 1, binding = 2) readonly buffer VertexBufferAddr {
    uint64_t addrs[];
}
vertexBufferAddrs;

layout(set = 1, binding = 3) readonly buffer IndexBufferAddr {
    uint64_t addrs[];
}
indexBufferAddrs;

layout(set = 1, binding = 7) readonly buffer TextureMappingBuffer {
    TextureMapping mapping;
};

#include "../util/vertex_fetch.glsl"

layout(set = 2, binding = 0) uniform Uniform {
    WorldUBO ubo;
};

layout(set = 2, binding = 2) uniform SkyUniform {
    SkyUBO skyUBO;
};

// VertexBuffer and IndexBuffer declared in vertex_fetch.glsl

layout(push_constant) uniform PushConstant {
    int numRayBounces;
    int flags;
    int reservedLighting0;
    float reservedLighting1;
    int reservedLighting2;
    int reservedLighting3;
    int reservedLighting4;
    float preExposure;
    float displacementDepthScale;
    int displacementPrimarySteps;
    int displacementRefinementSteps;
    float displacementFadeDistanceBlocks;
    uint blueNoiseFrame;
    uint rtDebugFlags;
    uint handInstanceCount;
    uint reservedPc0;
    uint64_t sharcHashEntries;
    uint64_t sharcAccumulation;
    uint64_t sharcResolved;
    float sharcCameraX;
    float sharcCameraY;
    float sharcCameraZ;
    float sharcSceneScale;
    uint sharcCapacity;
    float sharcRadianceScale;
    uint sharcFrameIndex;
    float sharcRoughnessThreshold;
    int sharcUpdateBlockSize;
    int sharcUpdateBounces;
    int sharcQueryMode;
    int sharcQueryReserved;
    int offlineFlags;
    int accumFrameCount;
    float aperture;
    float focalDistance;
    uint64_t reservedAddr;
} pc;
#define SIMPLIFIED_INDIRECT ((pc.flags & 1) != 0)
#define SIMPLIFY_THIS_RAY (SIMPLIFIED_INDIRECT && shadowRay.bounceIndex > 1)
#define BEER_LAW_SHADOWS ((pc.flags & 512) != 0)

layout(location = 1) rayPayloadInEXT ShadowRay shadowRay;
hitAttributeEXT vec2 attribs;

uint thinPlantBlockTypeFromPacked(uint packedBlockType) {
    return (packedBlockType & PBR_PACKED_SHADER_BLOCK_ID_MASK) >> PBR_PACKED_SHADER_BLOCK_ID_SHIFT;
}

uint thinPlantHashInt(int v, uint salt) {
    uint x = uint(v) ^ salt;
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    return x ^ (x >> 16u);
}

ivec3 thinPlantCellFromWorldPos(vec3 cameraRelativeWorldPos) {
    return ivec3(floor(cameraRelativeWorldPos + vec3(ubo.cameraPos.xyz) + vec3(0.0001)));
}

uint thinPlantColumnHash(ivec3 cell) {
    uint h = thinPlantHashInt(cell.x, 0x9e3779b9u) ^ thinPlantHashInt(cell.z, 0x85ebca6bu);
    return h == 0u ? 1u : h;
}

uint thinPlantHitKey(ivec3 cell, uint blockType) {
    uint h = thinPlantColumnHash(cell) ^ thinPlantHashInt(cell.y, 0xc2b2ae35u) ^ (blockType * 0x27d4eb2du);
    return h == 0u ? 1u : h;
}

vec3 fluidShadowTransmission(UnpackedVertex v0, UnpackedVertex v1, UnpackedVertex v2) {
    vec3 wp0 = vec3(gl_ObjectToWorldEXT * vec4(v0.pos, 1.0));
    vec3 wp1 = vec3(gl_ObjectToWorldEXT * vec4(v1.pos, 1.0));
    vec3 wp2 = vec3(gl_ObjectToWorldEXT * vec4(v2.pos, 1.0));

    vec3 dPduWorld;
    vec3 dPdvWorld;
    computedposduDv(wp0, wp1, wp2, v0.textureUV, v1.textureUV, v2.textureUV, dPduWorld, dPdvWorld);

    vec3 worldNormal = normalize(cross(dPduWorld, dPdvWorld));
    if (dot(worldNormal, worldNormal) <= 1e-6 || abs(worldNormal.y) <= 0.75) {
        return vec3(1.0);
    }

    vec3 hitWorldPos = gl_WorldRayOriginEXT + gl_WorldRayDirectionEXT * gl_HitTEXT;
    vec3 absWorldPos = hitWorldPos + vec3(ubo.cameraPos.xyz);
    vec3 waterCoordNormal = worldNormal.y >= 0.0 ? worldNormal : -worldNormal;
    vec2 waterCoord = fftWaterSurfaceCoord(absWorldPos, dPduWorld, dPdvWorld, waterCoordNormal);
    float waterDepth = gl_HitTEXT * max(dot(normalize(gl_WorldRayDirectionEXT), waterCoordNormal), 0.01);

    vec3 waterTintBt2020 = CS_BT709_TO_BT2020 * clamp(skyUBO.envWaterTintFog.rgb, vec3(0.02), vec3(1.0));
    vec3 absorption = exp(-(vec3(1.0) - waterTintBt2020) * waterDepth * 0.22);
    float caustic = (shaderPackVisualSettings.waterSurfaceMode == 1 && shaderPackVisualSettings.waterCausticsEnabled != 0)
        ? sampleFftWaterCaustic(waterCoord, ubo.gameTime, gl_WorldRayDirectionEXT, waterDepth)
        : 1.0;
    return absorption * caustic;
}

vec3 thinPlantShadowTransmittance(vec3 tint) {
    vec3 plantTint = clamp(tint, vec3(0.0), vec3(1.0));
    float fill = 0.18;
    float shadowStrength = 1.0;
    vec3 coloredTransmission = mix(vec3(1.0), plantTint, clamp(fill * 0.55, 0.0, 0.75));
    float transmission = clamp(1.0 - shadowStrength * 0.28, 0.28, 0.95);
    return clamp(coloredTransmission * transmission, vec3(0.25), vec3(0.95));
}

#if RARSER_SHADER_DISPLACEMENT
bool shadowAuthoredDisplacementBlocksOpaqueHit(UnpackedVertex v0,
                                               UnpackedVertex v1,
                                               UnpackedVertex v2,
                                               vec2 textureUV,
                                               uint textureID,
                                               bool useTexture,
                                               bool isBlockGeometry,
                                               bool isFluidGeometry) {
    if (pc.displacementDepthScale <= DISPLACEMENT_MIN_DEPTH ||
        pc.displacementFadeDistanceBlocks <= DISPLACEMENT_MIN_DEPTH ||
        gl_HitTEXT >= pc.displacementFadeDistanceBlocks ||
        !useTexture || !isBlockGeometry || isFluidGeometry ||
        !displacementBlockHasAuthoredHeight(textureID)) {
        return true;
    }

    uint coordinateMode = (v0.flags & PBR_FLAG_COORD_MASK) >> PBR_FLAG_COORD_SHIFT;
    if (coordinateMode != 0u) return true;

    vec3 wp0 = vec3(gl_ObjectToWorldEXT * vec4(v0.pos, 1.0));
    vec3 wp1 = vec3(gl_ObjectToWorldEXT * vec4(v1.pos, 1.0));
    vec3 wp2 = vec3(gl_ObjectToWorldEXT * vec4(v2.pos, 1.0));

    vec3 dPdu;
    vec3 dPdv;
    vec3 baseNormal;
    if (!displacementBuildBasis(wp0, wp1, wp2, v0.textureUV, v1.textureUV, v2.textureUV,
                                dPdu, dPdv, baseNormal)) {
        return true;
    }

    vec3 rayDir = gl_WorldRayDirectionEXT;
    vec3 viewDir = -rayDir;
    if (dot(baseNormal, viewDir) < 0.0) {
        baseNormal = -baseNormal;
    }

    vec2 displacementChartOffset = vec2(0.0);
    displacementBuildBlockChart(v0.postBase, dPdu, dPdv, displacementChartOffset);

    float fade = 1.0 - smoothstep(pc.displacementFadeDistanceBlocks * 0.75,
                                  pc.displacementFadeDistanceBlocks, gl_HitTEXT);
    TextureRuleEntry displacementRule = safeTextureRuleEntry(textureID);
    float materialDisplacementScale = ((displacementRule.flags & TEXTURE_RULE_ENABLED) != 0u
        && (displacementRule.flags & TEXTURE_RULE_DISPLACEMENT_SCALE) != 0u)
        ? clamp(displacementRule.displacementScale, 0.0, 4.0)
        : 1.0;

    DisplacementSource displacementSource;
    displacementInitSource(displacementSource);
    displacementSource.isBlock = true;
    displacementSource.textureID = textureID;
    displacementSource.normalTextureID = -1;
    displacementSource.animTick = ubo.animTick;
    displacementSource.uvMin = min(min(v0.textureUV, v1.textureUV), v2.textureUV) + displacementChartOffset;
    displacementSource.uvMax = max(max(v0.textureUV, v1.textureUV), v2.textureUV) + displacementChartOffset;
    displacementSource.maxDepth = max(pc.displacementDepthScale, 0.0) * fade * materialDisplacementScale;
    displacementSource.mode = DISPLACEMENT_SOURCE_AUTHORED_NORMAL_ALPHA;
    displacementSource.boundaryWalls = false;

    if (displacementSource.maxDepth <= DISPLACEMENT_MIN_DEPTH) {
        return true;
    }

    vec3 planeWorldPos = gl_WorldRayOriginEXT + rayDir * gl_HitTEXT;
    DisplacementHit displacementHit;
    return displacementTracePrimary(displacementSource, textureUV + displacementChartOffset, planeWorldPos, rayDir,
                                    viewDir, dPdu, dPdv, baseNormal,
                                    clamp(pc.displacementPrimarySteps, 1, 512),
                                    pc.displacementRefinementSteps, displacementHit);
}
#endif

void main() {
    uint instanceID = gl_InstanceCustomIndexEXT;
    uint geometryID = gl_GeometryIndexEXT;

    uint blasOffset;
    uint vertexFormat;
    UnpackedVertex v0, v1, v2;
    fetchTriangleVertices(instanceID, geometryID, gl_PrimitiveID, v0, v1, v2, blasOffset, vertexFormat);

    vec3 baryCoords = vec3(1.0 - (attribs.x + attribs.y), attribs.x, attribs.y);
    vec2 uv = baryCoords.x * v0.textureUV + baryCoords.y * v1.textureUV + baryCoords.z * v2.textureUV;
    uint textureID = v0.textureID;
    uint materialRuleTextureID = textureID;
    bool isBlockGeometry = (v0.flags & PBR_FLAG_BLOCK_GEOMETRY) != 0u;
    bool isFluidGeometry = (v0.flags & PBR_FLAG_FLUID_GEOMETRY) != 0u;
    bool isWaterGeometry = (v0.flags & PBR_FLAG_WATER_GEOMETRY) != 0u;

    bool useColorLayer = (v0.flags & PBR_FLAG_USE_COLOR_LAYER) != 0u;
    vec4 colorLayer;
    if (useColorLayer) {
        colorLayer = vec4(baryCoords.x * v0.colorLayer + baryCoords.y * v1.colorLayer + baryCoords.z * v2.colorLayer, 1.0);
    } else {
        colorLayer = vec4(1.0);
    }

    bool useTexture = (v0.flags & PBR_FLAG_USE_TEXTURE) != 0u;
    vec2 textureUV;
    vec4 albedo;
    ivec4 flags;
    vec4 specular = vec4(0.0);
    vec4 normalVal = vec4(0.0);
    bool foldBlockOverlay = (v0.flags & PBR_FLAG_OVERLAY_ALPHA_MASK) != 0u;
    bool blockOverlayComposited = false;

    if (useTexture) {
        textureUV = baryCoords.x * v0.textureUV + baryCoords.y * v1.textureUV + baryCoords.z * v2.textureUV;

        if (isBlockGeometry) {
            // Block geometry: texture array sampling via SpriteRegistry
            uint spriteId = textureID;

            albedo = fetchBlockAlbedoLod(spriteId, textureUV, ubo.animTick, 0.0);

            if (!SIMPLIFY_THIS_RAY) {
                specular = fetchBlockSpecularLod(spriteId, textureUV, 0.0);
            }

            flags = fetchBlockFlagLod(spriteId, textureUV, 0.0);
            if (foldBlockOverlay) {
                blockOverlayComposited = applyBlockOverlayMaterialLod(
                    albedo, specular, normalVal, flags,
                    spriteId, textureUV, ubo.animTick, 0.0, colorLayer.rgb,
                    materialRuleTextureID);
            }
        } else {
            // Entity geometry: legacy atlas sampling via textures[]
            albedo = texture(textures[nonuniformEXT(textureID)], textureUV);

            if (!SIMPLIFY_THIS_RAY) {
                int specularTextureID = mapping.entries[textureID].specular;
                if (specularTextureID >= 0) { specular = texture(textures[nonuniformEXT(specularTextureID)], textureUV); }
            }

            int flagTextureID = mapping.entries[textureID].flag;
            if (flagTextureID >= 0) {
                vec4 floatFlagValue = textureLod(textures[nonuniformEXT(flagTextureID)], uv, 0);
                flags = ivec4(round(floatFlagValue * 255.0));
            } else {
                flags = ivec4(0);
            }
        }
    } else {
        albedo = vec4(1.0);
        flags = ivec4(0);
    }

    // if insideBoat, then ignore liquid
    if (shadowRay.insideBoat > 0 && isWaterGeometry) {
        ignoreIntersectionEXT;
        return;
    }

    vec3 tint = blockOverlayComposited ? albedo.rgb : (albedo * colorLayer).rgb;
    float alpha = (albedo * colorLayer).a;
    if (isWaterGeometry) {
        alpha = 1.0;
    }

    if (!SIMPLIFY_THIS_RAY) {
        float useGlint = float((v0.flags & PBR_FLAG_USE_GLINT) != 0u);
        uint glintTexture = v0.glintTexture;
        vec2 glintUV = baryCoords.x * v0.glintUV + baryCoords.y * v1.glintUV + baryCoords.z * v2.glintUV;
        glintUV = (ubo.textureMat * vec4(glintUV, 0.0, 1.0)).xy;
        vec3 glint = useGlint * texture(textures[nonuniformEXT(glintTexture)], glintUV).rgb;
        glint = glint * glint;

        bool useOverlay = (v0.flags & PBR_FLAG_USE_OVERLAY) != 0u;
        ivec2 overlayUV = ivec2(int(v0.overlayPacked & 0xFFFFu), int(v0.overlayPacked >> 16u));
        vec4 overlayColor = texelFetch(textures[nonuniformEXT(ubo.overlayTextureID)], overlayUV, 0);

        if (useOverlay) {
            tint = mix(overlayColor.rgb, tint, overlayColor.a) + glint;
        } else {
            tint += glint;
        }
    }

    tint = CS_BT709_TO_BT2020 * tint;  // BT.709 -> BT.2020 working space
    uint packedBlockType = v0.emissiveBlockType;

    bool thinCutoutPlant = isBlockGeometry && ((v0.emissiveBlockType & PBR_PACKED_THIN_CUTOUT_PLANT) != 0u);
    if (thinCutoutPlant) {
        if (alpha < 0.05) {
            ignoreIntersectionEXT;
            return;
        }
        uint thinBlockType = thinPlantBlockTypeFromPacked(v0.emissiveBlockType);
        vec3 hitWorldPos = gl_WorldRayOriginEXT + gl_HitTEXT * gl_WorldRayDirectionEXT;
        ivec3 hitCell = thinPlantCellFromWorldPos(hitWorldPos);
        uint hitColumnHash = thinPlantColumnHash(hitCell);
        if (shadowRay.originThinBlockType == thinBlockType &&
            shadowRay.originThinColumnHash == hitColumnHash) {
            ignoreIntersectionEXT;
            return;
        }
        uint hitKey = thinPlantHitKey(hitCell, thinBlockType);
        if (shadowRay.lastThinPlantHitKey == hitKey) {
            ignoreIntersectionEXT;
            return;
        }
        shadowRay.lastThinPlantHitKey = hitKey;
        shadowRay.throughput *= thinPlantShadowTransmittance(tint);
        ignoreIntersectionEXT;
        return;
    }

    // When simplified, skip LabPBR conversion — only transmission matters,
    // which is equivalent to alpha < (1.0 - 1e-6)
    if (isWaterGeometry) {
        shadowRay.throughput *= fluidShadowTransmission(v0, v1, v2);
        ignoreIntersectionEXT;
        return;
    }

    bool hasTransmission;
    if (SIMPLIFY_THIS_RAY) {
        hasTransmission = isWaterGeometry || alpha < 0.95 ||
            (isBlockGeometry && textureRuleHasTransmission(textureID));
    } else {
        vec4 materialAlbedo = blockOverlayComposited ? albedo : albedo * colorLayer;
        LabPBRMat mat = convertLabPBRMaterial(materialAlbedo, specular, normalVal);
        if (isBlockGeometry) {
            applyTextureRule(materialRuleTextureID, mat);
        }
        hasTransmission = mat.transmission > 0.0;
    }

    // Authored displacement is a shader-local heightfield, not closed BLAS geometry.
    // Keep opaque block shadow hits opaque; punching holes here leaks sun through relief.

    if (BEER_LAW_SHADOWS) {
        // Ground truth: Beer's Law volumetric absorption for transmissive materials
        if (alpha < 0.05) {
            ignoreIntersectionEXT;
        } else if (hasTransmission) {
            // Use gl_HitKindEXT to determine front/back face (entry/exit)
            bool frontFace = (gl_HitKindEXT == gl_HitKindFrontFacingTriangleEXT);
            if (frontFace) {
                // Entering transmissive medium — record absorption coefficients
                // sigma_a = -ln(tint) per block (tint is per-block transmission color)
                shadowRay.mediumAbsorption = -log(max(tint, vec3(0.001)));
                shadowRay.mediumEntryT = gl_HitTEXT;
            } else {
                // Exiting medium — apply Beer's Law for distance traveled
                float dist = max(gl_HitTEXT - shadowRay.mediumEntryT, 0.0);
                if (dist > 0.001) {
                    shadowRay.throughput *= exp(-shadowRay.mediumAbsorption * dist);
                }
                shadowRay.mediumAbsorption = vec3(0.0);
            }
            ignoreIntersectionEXT;
        } else if (alpha < 1.0) {
            // Semi-transparent (leaves, vines): stochastic alpha test (unbiased)
            if (rand(shadowRay.seed) > alpha) {
                ignoreIntersectionEXT;
            }
            // else: opaque hit — fall through to terminateRayEXT
        }
        // Fully opaque
        terminateRayEXT;
    }

    // Online mode: existing approximations
    if (alpha < 0.05) {
        // cut-out
        ignoreIntersectionEXT;
    } else if (hasTransmission) {
        shadowRay.throughput *= tint;
        ignoreIntersectionEXT;
    } else if (alpha < 0.95) {
        // translucent
        if (rand(shadowRay.seed) < alpha) {
            // accept the ray
            shadowRay.throughput *= tint;
            ignoreIntersectionEXT;
        } else {
            // pass through
            ignoreIntersectionEXT;
        }
    } else {
        // opaque
        terminateRayEXT;
    }
}
