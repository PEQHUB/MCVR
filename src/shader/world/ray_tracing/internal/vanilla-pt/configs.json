    "execution": {
        "global_variables": [
            {
                "VPT_TRANS_LUT_READY": false
            },
            {
                "VPT_VOLUMETRIC_CLOUD_HISTORY_PING_INPUT": true
            },
            {
                "VPT_VOLUMETRIC_CLOUD_HISTORY_READY": false
            }
        ],
        "commands": [
            {
                "if_else": {
                    "condition": "!VPT_TRANS_LUT_READY",
                    "then": [
                        {
                            "pass": "trans_lut"
                        },
                        {
                            "assign": {
                                "VPT_TRANS_LUT_READY": true
                            }
                        }
                    ],
                    "else": []
                }
            },
            {
                "pass": "sky_cube"
            },
            {
                "pass": "world"
            },
            {
                "if_else": {
                    "condition": "VPT_CLOUD_MODE == 2",
                    "then": [
                        {
                            "if_else": {
                                "condition": "VPT_ENABLE_VOLUMETRIC_CLOUD_TEMPORAL",
                                "then": [
                                    {
                                        "pass": "volumetric_cloud_temporal"
                                    },
                                    {
                                        "pass": "volumetric_cloud_apply"
                                    },
                                    {
                                        "assign": {
                                            "VPT_VOLUMETRIC_CLOUD_HISTORY_PING_INPUT": "!VPT_VOLUMETRIC_CLOUD_HISTORY_PING_INPUT"
                                        }
                                    },
                                    {
                                        "assign": {
                                            "VPT_VOLUMETRIC_CLOUD_HISTORY_READY": true
                                        }
                                    }
                                ],
                                "else": [
                                    {
                                        "assign": {
                                            "VPT_VOLUMETRIC_CLOUD_HISTORY_READY": false
                                        }
                                    }
                                ]
                            }
                        }
                    ],
                    "else": [
                        {
                            "assign": {
                                "VPT_VOLUMETRIC_CLOUD_HISTORY_READY": false
                            }
                        }
                    ]
                }
            }
        ]
    },
    "execution_post": {
        "global_variables": [
            {
                "VPT_POST_DOF_FOCUS_PING_INPUT": true
            },
            {
                "VPT_POST_DOF_FOCUS_HISTORY_READY": false
            }
        ],
        "commands": [
            {
                "pass": "post_render_particle"
            },
            {
                "pass": "post_render_weather"
            },
            {
                "pass": "post_render_text"
            },
            {
                "pass": "post_render_name_tag"
            },
            {
                "pass": "post_render_star"
            },
            {
                "if_else": {
                    "condition": "VPT_POST_ENABLE_MOTION_BLUR != 0",
                    "then": [
                        {
                            "pass": "post_motion_blur"
                        }
                    ]
                }
            },
            {
                "if_else": {
                    "condition": "VPT_POST_ENABLE_MOTION_BLUR != 0",
                    "then": [
                        {
                            "pass": "post_copy_post_motion_to_ldr"
                        }
                    ]
                }
            }
        ]
    },
