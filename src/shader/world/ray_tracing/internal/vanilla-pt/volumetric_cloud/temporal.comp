#version 460
#extension GL_GOOGLE_include_directive : require

#ifndef VPT_VOLUMETRIC_CLOUD_HISTORY_PING_INPUT
#    define VPT_VOLUMETRIC_CLOUD_HISTORY_PING_INPUT true
#endif
#ifndef VPT_VOLUMETRIC_CLOUD_HISTORY_READY
#    define VPT_VOLUMETRIC_CLOUD_HISTORY_READY false
#endif

#include "common/shared.hpp"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 3, binding = 4, rg32f) uniform readonly image2D motionVectorImage;
layout(set = 3, binding = 11, rgba16f) uniform readonly image2D firstHitClearImage;
layout(set = 5, binding = 32, r16f) uniform readonly image2D postStarCloudTransmittanceImage;
layout(set = 5, binding = 34, rgba16f) uniform image2D volumetricCloudTemporalImage;
layout(set = 5, binding = 35, rgba16f) uniform image2DArray volumetricCloudHistoryImage;

bool finiteFloat(float value) {
    return !isnan(value) && !isinf(value);
}

bool finiteVec3(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

float cloudTemporalLuminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

bool currentSkyPixel(ivec2 pixel) {
    return imageLoad(firstHitClearImage, pixel).a > 0.0;
}

float loadCloudTransmittance(ivec2 pixel) {
    float transmittance = imageLoad(postStarCloudTransmittanceImage, pixel).r;
    return finiteFloat(transmittance) ? clamp(transmittance, 0.0, 1.0) : 1.0;
}

vec4 loadVolumetricCloudHistory(ivec2 pixel, int layer) {
    return imageLoad(volumetricCloudHistoryImage, ivec3(pixel, layer));
}

void storeVolumetricCloudHistory(ivec2 pixel, int layer, vec4 value) {
    imageStore(volumetricCloudHistoryImage, ivec3(pixel, layer), value);
}

bool validCloudHistory(vec4 history) {
    return history.a >= 0.0 && finiteVec3(history.rgb) && finiteFloat(history.a);
}

void accumulateCloudHistorySample(inout vec4 weightedHistory, inout float totalWeight, vec4 history, float weight) {
    if (weight <= 0.0 || !validCloudHistory(history)) { return; }
    weightedHistory += vec4(max(history.rgb, vec3(0.0)), clamp(history.a, 0.0, 1.0)) * weight;
    totalWeight += weight;
}

bool sampleCloudHistoryBilinear(vec2 samplePixel, ivec2 resolution, int historyReadLayer, out vec4 history) {
    if (samplePixel.x < 0.0 || samplePixel.y < 0.0 || samplePixel.x > float(resolution.x - 1) ||
        samplePixel.y > float(resolution.y - 1)) {
        history = vec4(0.0, 0.0, 0.0, -1.0);
        return false;
    }

    vec2 baseCoord = floor(samplePixel);
    ivec2 p00 = ivec2(baseCoord);
    ivec2 p10 = min(p00 + ivec2(1, 0), resolution - ivec2(1));
    ivec2 p01 = min(p00 + ivec2(0, 1), resolution - ivec2(1));
    ivec2 p11 = min(p00 + ivec2(1, 1), resolution - ivec2(1));
    vec2 frac = samplePixel - baseCoord;

    vec4 weightedHistory = vec4(0.0);
    float totalWeight = 0.0;
    accumulateCloudHistorySample(
        weightedHistory, totalWeight, loadVolumetricCloudHistory(p00, historyReadLayer), (1.0 - frac.x) * (1.0 - frac.y));
    accumulateCloudHistorySample(
        weightedHistory, totalWeight, loadVolumetricCloudHistory(p10, historyReadLayer), frac.x * (1.0 - frac.y));
    accumulateCloudHistorySample(
        weightedHistory, totalWeight, loadVolumetricCloudHistory(p01, historyReadLayer), (1.0 - frac.x) * frac.y);
    accumulateCloudHistorySample(
        weightedHistory, totalWeight, loadVolumetricCloudHistory(p11, historyReadLayer), frac.x * frac.y);

    if (totalWeight <= 1e-5) {
        history = vec4(0.0, 0.0, 0.0, -1.0);
        return false;
    }

    history = weightedHistory / totalWeight;
    return true;
}

void skyNeighborhoodBounds(ivec2 pixel,
                           ivec2 resolution,
                           float centerTransmittance,
                           out vec3 minValue,
                           out vec3 maxValue,
                           out float minTransmittance,
                           out float maxTransmittance) {
    vec3 centerValue = max(imageLoad(firstHitClearImage, pixel).rgb, vec3(0.0));
    minValue = centerValue;
    maxValue = centerValue;
    minTransmittance = centerTransmittance;
    maxTransmittance = centerTransmittance;
    bool foundSkySample = false;

    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            ivec2 samplePixel = clamp(pixel + ivec2(x, y), ivec2(0), resolution - ivec2(1));
            if (!currentSkyPixel(samplePixel)) { continue; }

            vec3 sampleValue = imageLoad(firstHitClearImage, samplePixel).rgb;
            if (!finiteVec3(sampleValue)) { continue; }

            float sampleTransmittance = loadCloudTransmittance(samplePixel);
            sampleValue = max(sampleValue, vec3(0.0));
            if (!foundSkySample) {
                minValue = sampleValue;
                maxValue = sampleValue;
                minTransmittance = sampleTransmittance;
                maxTransmittance = sampleTransmittance;
                foundSkySample = true;
            } else {
                minValue = min(minValue, sampleValue);
                maxValue = max(maxValue, sampleValue);
                minTransmittance = min(minTransmittance, sampleTransmittance);
                maxTransmittance = max(maxTransmittance, sampleTransmittance);
            }
        }
    }
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 resolution = imageSize(firstHitClearImage);
    if (any(greaterThanEqual(pixel, resolution))) { return; }

    vec3 currentRadiance = imageLoad(firstHitClearImage, pixel).rgb;
    currentRadiance = finiteVec3(currentRadiance) ? max(currentRadiance, vec3(0.0)) : vec3(0.0);

    float currentCloudTransmittance = loadCloudTransmittance(pixel);
    bool hitSky = currentSkyPixel(pixel);
    int historyReadLayer = VPT_VOLUMETRIC_CLOUD_HISTORY_PING_INPUT ? 0 : 1;
    int historyWriteLayer = VPT_VOLUMETRIC_CLOUD_HISTORY_PING_INPUT ? 1 : 0;

    if (!hitSky) {
        imageStore(volumetricCloudTemporalImage, pixel, vec4(currentRadiance, -1.0));
        storeVolumetricCloudHistory(pixel, historyWriteLayer, vec4(0.0, 0.0, 0.0, -1.0));
        return;
    }

    vec3 accumulatedRadiance = currentRadiance;
    float accumulatedCloudTransmittance = currentCloudTransmittance;

    vec2 motion = imageLoad(motionVectorImage, pixel).xy;
    vec2 prevPixel = vec2(pixel) + motion;

    if (VPT_VOLUMETRIC_CLOUD_HISTORY_READY) {
        vec4 history;
        if (sampleCloudHistoryBilinear(prevPixel, resolution, historyReadLayer, history)) {
            vec3 neighborhoodMin;
            vec3 neighborhoodMax;
            float neighborhoodTransmittanceMin;
            float neighborhoodTransmittanceMax;
            skyNeighborhoodBounds(pixel, resolution, currentCloudTransmittance, neighborhoodMin, neighborhoodMax,
                                  neighborhoodTransmittanceMin, neighborhoodTransmittanceMax);

            vec3 clampPadding = max(vec3(0.05), (neighborhoodMax - neighborhoodMin) * 0.35);
            vec3 clampedHistory =
                clamp(max(history.rgb, vec3(0.0)), neighborhoodMin - clampPadding, neighborhoodMax + clampPadding);

            float motionLength = length(motion);
            float historyCloudTransmittance = clamp(history.a, 0.0, 1.0);
            float transmittanceDelta = abs(historyCloudTransmittance - currentCloudTransmittance);
            float currentLuminance = cloudTemporalLuminance(currentRadiance);
            float historyLuminance = cloudTemporalLuminance(clampedHistory);
            float luminanceDelta =
                abs(historyLuminance - currentLuminance) / max(max(historyLuminance, currentLuminance), 1e-3);
            float neighborhoodMinLuminance = cloudTemporalLuminance(neighborhoodMin);
            float neighborhoodMaxLuminance = cloudTemporalLuminance(neighborhoodMax);
            float transmittanceRange = max(neighborhoodTransmittanceMax - neighborhoodTransmittanceMin, 0.0);
            float luminanceRange =
                max(neighborhoodMaxLuminance - neighborhoodMinLuminance, 0.0) / max(neighborhoodMaxLuminance, 1e-3);
            float edgeStrength = smoothstep(0.025, 0.18, transmittanceRange);
            edgeStrength =
                max(edgeStrength, smoothstep(0.16, 0.75, luminanceRange) * smoothstep(0.02, 0.10, transmittanceRange));

            float historyWeight = mix(0.985, 0.84, smoothstep(0.0, 28.0, motionLength));
            historyWeight *= 1.0 - smoothstep(0.08, 0.35, transmittanceDelta);
            historyWeight *= 1.0 - smoothstep(0.20, 1.25, luminanceDelta);
            historyWeight *= mix(1.0, 0.60, edgeStrength);
            historyWeight = clamp(historyWeight, mix(0.55, 0.10, edgeStrength), mix(0.992, 0.90, edgeStrength));

            accumulatedRadiance = mix(currentRadiance, clampedHistory, historyWeight);
            accumulatedCloudTransmittance = mix(currentCloudTransmittance, historyCloudTransmittance, historyWeight);
        }
    }

    if (!finiteVec3(accumulatedRadiance)) { accumulatedRadiance = currentRadiance; }
    if (!finiteFloat(accumulatedCloudTransmittance)) { accumulatedCloudTransmittance = currentCloudTransmittance; }

    vec4 accumulated = vec4(accumulatedRadiance, clamp(accumulatedCloudTransmittance, 0.0, 1.0));
    imageStore(volumetricCloudTemporalImage, pixel, accumulated);
    storeVolumetricCloudHistory(pixel, historyWriteLayer, accumulated);
}
