#version 460
#extension GL_GOOGLE_include_directive : require

#include "common/shared.hpp"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 3, binding = 0, rgba16f) uniform image2D outputImage;
layout(set = 3, binding = 11, rgba16f) uniform image2D firstHitClearImage;
layout(set = 3, binding = 13, rgba16f) uniform readonly image2D fogImage;
layout(set = 5, binding = 32, r16f) uniform image2D postStarCloudTransmittanceImage;
layout(set = 5, binding = 34, rgba16f) uniform readonly image2D volumetricCloudTemporalImage;

bool finiteFloat(float value) {
    return !isnan(value) && !isinf(value);
}

bool finiteVec3(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 resolution = imageSize(outputImage);
    if (any(greaterThanEqual(pixel, resolution))) { return; }

    vec4 temporalCloud = imageLoad(volumetricCloudTemporalImage, pixel);
    if (temporalCloud.a < 0.0 || !finiteVec3(temporalCloud.rgb) || !finiteFloat(temporalCloud.a)) { return; }

    vec3 temporalRadiance = max(temporalCloud.rgb, vec3(0.0));
    vec4 fogData = imageLoad(fogImage, pixel);
    bool useFogCompose = finiteFloat(fogData.a) && fogData.a >= 0.0;
    float fogTransmittance = useFogCompose ? clamp(fogData.a, 0.0, 1.0) : 1.0;
    vec3 fogAdditive = useFogCompose && finiteVec3(fogData.rgb) ? max(fogData.rgb, vec3(0.0)) : vec3(0.0);
    vec3 composedRadiance = temporalRadiance * fogTransmittance + fogAdditive;

    imageStore(firstHitClearImage, pixel, vec4(temporalRadiance, 1.0));
    imageStore(outputImage, pixel, vec4(composedRadiance, 1.0));
    imageStore(postStarCloudTransmittanceImage, pixel, vec4(clamp(temporalCloud.a, 0.0, 1.0)));
}
