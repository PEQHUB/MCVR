#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "util/alpha_mode.glsl"
#include "common/fft_water.glsl"
#include "util/labpbr.glsl"
#include "util/random.glsl"
#include "util/ray.glsl"
#include "util/ray_cone.glsl"
#include "util/util.glsl"
#include "common/shared.hpp"
#include "common/raytrace_transforms.glsl"

layout(set = 0, binding = 0) uniform sampler2D textures[];

#include "util/texture_rules.glsl"
#include "util/sprite_fetch.glsl"
#include "util/displacement.glsl"

layout(set = 1, binding = 1) readonly buffer BLASOffsets {
    uint offsets[];
}
blasOffsets;

layout(set = 1, binding = 7) readonly buffer TextureMappingBuffer {
    TextureMapping mapping;
};

layout(set = 2, binding = 0) uniform Uniform {
    WorldUBO ubo;
};

layout(push_constant) uniform PushConstant {
    uint currentFrame;
    float sunAngularRadiusDeg;
    float focalLength;
    float apertureDiameter;
    float sensorWidth;
    float _padCamera0;
    float _padCamera1;
    float _padCamera2;
    int flags;
    float atmosphereBlend;
    float atmosphereRayleighScale;
    float atmosphereMieScale;
    float atmosphereOzoneScale;
    float atmosphereExposure;
    float atmosphereSunIntensity;
    float atmosphereMultiScatter;
    float atmosphereGroundAlbedo;
    float atmospherePlanetRadius;
    float atmosphereHeight;
    float atmosphereMieAnisotropy;
    uint rtDebugFlags;
    float displacementDepthScale;
    int displacementPrimarySteps;
    int displacementRefinementSteps;
    float displacementFadeDistanceBlocks;
} pc;

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer IndexBuffer {
    uint indices[];
}
indexBuffer;

#include "util/vertex.glsl"

layout(location = 1) rayPayloadInEXT ShadowRay shadowRay;
hitAttributeEXT vec2 attribs;

void main() {
    uint instanceID = gl_InstanceCustomIndexEXT;
    uint geometryID = gl_GeometryIndexEXT;
    uint geometryBufferIndex = getGeometryBufferIndex(instanceID, geometryID);

    uint i0, i1, i2;
    PositionVertex p0, p1, p2;
    MaterialVertex m0, m1, m2;
    loadTriangle(geometryBufferIndex, gl_PrimitiveID, i0, i1, i2, p0, p1, p2, m0, m1, m2);
    vec3 baryCoords = vec3(1.0 - (attribs.x + attribs.y), attribs.x, attribs.y);
    uint packedData = m0.packedData;
    uint textureID = m0.textureID;
    uint materialRuleTextureID = textureID;
    bool isBlockGeometry = (packedData & PBR_FLAG_BLOCK_GEOMETRY) != 0u;
    bool foldBlockOverlay = isBlockGeometry && ((packedData & PBR_FLAG_OVERLAY_ALPHA_MASK) != 0u);
    bool isFluidGeometry = (packedData & PBR_FLAG_FLUID_GEOMETRY) != 0u;
    bool isWaterGeometry = (packedData & PBR_FLAG_WATER_GEOMETRY) != 0u;
    bool isLavaGeometry = isFluidGeometry && ((m0.emissiveBlockType & 255u) == 0u);
    uint alphaMode = getAlphaMode(packedData);

    vec4 colorLayer =
        hasColorLayer(packedData) ?
            (baryCoords.x * m0.colorLayer + baryCoords.y * m1.colorLayer + baryCoords.z * m2.colorLayer) :
            vec4(1.0);

    vec4 albedo = vec4(1.0);
    vec2 textureUV = vec2(0.0);

    if (hasTexture(packedData)) {
        textureUV = baryCoords.x * m0.textureUV + baryCoords.y * m1.textureUV + baryCoords.z * m2.textureUV;
        albedo = isBlockGeometry ?
                     fetchBlockAlbedoLod(textureID, textureUV, ubo.animTick, 0.0) :
                     sampleTexture(textures[nonuniformEXT(textureID)], textureUV, false);
    }
    ivec4 flags = ivec4(0);
    bool isWaterMaterial = false;
    bool useRealisticWaterSurface = VPT_WATER_SURFACE_MODE == 1u;
    if (hasTexture(packedData)) {
        bool labPbrWaterFlag = false;
        bool transmissiveWaterRule = false;
        if (isBlockGeometry) {
            flags = fetchBlockFlagLod(textureID, textureUV, 0.0);
            labPbrWaterFlag = (flags.r & 0x1) > 0;
            transmissiveWaterRule = textureRuleHasTransmission(textureID);
        } else {
            int flagTextureID = mapping.entries[textureID].flag;
            if (flagTextureID >= 0) {
                flags = ivec4(round(sampleTexture(textures[nonuniformEXT(flagTextureID)], textureUV, 0.0, false) * 255.0));
                labPbrWaterFlag = (flags.r & 0x1) > 0;
            }
        }
        isWaterMaterial = isWaterGeometry || (isFluidGeometry && !isLavaGeometry && (labPbrWaterFlag || transmissiveWaterRule));
    }
    vec4 shadedAlbedo = albedo * colorLayer;
    float alpha = resolveSurfaceAlpha(shadedAlbedo.a, alphaMode);
    if (alpha < 0.05) {
        ignoreIntersectionEXT;
        return;
    }

    if (shadowRay.insideBoat > 0u && hasTexture(packedData)) {
        if (isWaterMaterial) {
            ignoreIntersectionEXT;
            return;
        }
    }

    if (!isWaterMaterial && alphaMode != ALPHA_MODE_TRANSPARENT) {
        if (hasTexture(packedData) && isBlockGeometry && !isFluidGeometry) {
            vec3 wp0 = vptObjectToWorldPoint(p0.pos);
            vec3 wp1 = vptObjectToWorldPoint(p1.pos);
            vec3 wp2 = vptObjectToWorldPoint(p2.pos);
            vec3 rayDir = gl_WorldRayDirectionEXT;
            vec3 viewDir = -rayDir;
            DisplacementSource displacementSource;
            vec3 dPdu;
            vec3 dPdv;
            vec3 baseNormal;
            vec2 displacementChartOffset;
            if (displacementPrepareAuthoredBlockSource(packedData, m0.emissiveBlockType, textureID,
                                                       wp0, wp1, wp2,
                                                       m0.textureUV, m1.textureUV, m2.textureUV,
                                                       m0.postBase, ubo.animTick, gl_HitTEXT,
                                                       pc.displacementDepthScale,
                                                       pc.displacementFadeDistanceBlocks, viewDir,
                                                       true, false,
                                                       displacementSource, dPdu, dPdv, baseNormal,
                                                       displacementChartOffset)) {
                vec3 planeWorldPos = gl_WorldRayOriginEXT + rayDir * gl_HitTEXT;
                DisplacementHit displacementHit;
                if (!displacementTracePrimary(displacementSource, textureUV + displacementChartOffset,
                                              planeWorldPos, rayDir, viewDir, dPdu, dPdv,
                                              baseNormal, clamp(pc.displacementPrimarySteps, 1, 512),
                                              pc.displacementRefinementSteps, displacementHit)) {
                    ignoreIntersectionEXT;
                    return;
                }
            }
        }

        shadowRay.hitT = min(shadowRay.hitT, gl_HitTEXT);
        terminateRayEXT;
        return;
    }

    vec4 specular = vec4(0.0);
    vec4 normalValue = vec4(0.0);
    bool blockOverlayComposited = false;
    if (hasTexture(packedData)) {
        if (isBlockGeometry) {
            specular = fetchBlockSpecularLod(textureID, textureUV, 0.0);
        } else {
            int specularTextureID = mapping.entries[textureID].specular;
            if (specularTextureID >= 0) {
                specular = sampleTexture(textures[nonuniformEXT(specularTextureID)], textureUV, false);
            }
        }
    }
    if (foldBlockOverlay) {
        blockOverlayComposited = applyBlockOverlayMaterialLod(
            albedo, specular, normalValue, flags,
            textureID, textureUV, ubo.animTick, 0.0, colorLayer.rgb,
            materialRuleTextureID);
        shadedAlbedo = blockOverlayComposited ? albedo : albedo * colorLayer;
    }

    vec2 glintUV = baryCoords.x * m0.glintUV + baryCoords.y * m1.glintUV + baryCoords.z * m2.glintUV;
    glintUV = (ubo.textureMat * vec4(glintUV, 0.0, 1.0)).xy;
    vec3 glint = hasGlint(packedData) ? sampleTexture(textures[nonuniformEXT(m0.glintTexture)], glintUV, false).rgb :
                                          vec3(0.0);
    glint *= glint;

    vec3 tint = shadedAlbedo.rgb;
    if (isBlockGeometry) {
        tint += glint;
    } else if (hasOverlay(packedData)) {
        vec4 overlayColor = sampleTexture(textures[nonuniformEXT(ubo.overlayTextureID)], m0.overlayUV, 0, false);
        tint = mix(overlayColor.rgb, tint, overlayColor.a) + glint;
    } else {
        tint += glint;
    }
    shadedAlbedo.a = alpha;

    LabPBRMat mat = convertLabPBRMaterial(shadedAlbedo, specular, normalValue);
    if (isBlockGeometry) { applyTextureRule(materialRuleTextureID, mat); }

    if (isWaterMaterial || mat.transmission > 0.0 || alpha < 0.95) {
        vec3 shadowTransmission =
            isWaterMaterial ? vec3(1.0) : clamp(mix(vec3(1.0), tint, alpha), vec3(0.0), vec3(1.0));
        if (isWaterMaterial && VPT_WATER_SURFACE_MODE == 1u) {
            vec3 dposdu;
            vec3 dposdv;
            computedposduDv(p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV, dposdu, dposdv);
            vec3 dPduWorld = vptObjectToWorldVector(dposdu);
            vec3 dPdvWorld = vptObjectToWorldVector(dposdv);
            vec3 worldNormal =
                normalize(cross(dPduWorld, dPdvWorld));
            if (abs(worldNormal.y) > 0.75) {
                vec3 hitWorldPos = gl_WorldRayOriginEXT + gl_WorldRayDirectionEXT * gl_HitTEXT;
                vec3 absWorldPos = hitWorldPos + vec3(ubo.cameraPos.xyz);
                vec3 waterCoordNormal = worldNormal.y >= 0.0 ? worldNormal : -worldNormal;
                vec2 waterCoord = fftWaterSurfaceCoord(absWorldPos, dPduWorld, dPdvWorld, waterCoordNormal);
                float waterDepth = gl_HitTEXT * max(dot(normalize(gl_WorldRayDirectionEXT), waterCoordNormal), 0.01);
                vec3 waterTint = vec3(0.0, 0.48, 0.65);
                vec3 absorption = exp(-(vec3(1.0) - waterTint) * waterDepth * 0.22);
                float caustic = VPT_WATER_CAUSTICS_ENABLED != 0
                    ? sampleFftWaterCaustic(waterCoord, ubo.gameTime, gl_WorldRayDirectionEXT, waterDepth)
                    : 1.0;
                shadowTransmission = min(absorption * caustic, vec3(1.0));
            }
        }
        shadowRay.throughput *= shadowTransmission;
        ignoreIntersectionEXT;
    } else {
        shadowRay.hitT = min(shadowRay.hitT, gl_HitTEXT);
        terminateRayEXT;
    }
}
