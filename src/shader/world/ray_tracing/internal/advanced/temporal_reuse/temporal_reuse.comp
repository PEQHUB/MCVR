void clearSurfaceHistory(ivec2 pixel) {
    storeRestirTemporalHistoryLayer(pixel, ADV_RESERVOIR_PING_INPUT, 0, vec4(0.0));
    storeRestirTemporalHistoryLayer(pixel, ADV_RESERVOIR_PING_INPUT, 1, vec4(0.0));
}

vec3 stableTemporalHistoryWorldPos(PrimarySurfaceCache cache) {
    return cache.planeHitWorldPos + vec3(worldUBO.cameraPos.xyz);
}

vec3 stableTemporalHistoryNormal(PrimarySurfaceCache cache) {
    return cache.baseGeoNormal;
}

bool previousFramePixelMatches(ivec2 pixel,
                               ivec2 resolution,
                               vec3 currentWorldPos,
                               vec3 currentNormal,
                               float motionLength) {
    if (!all(greaterThanEqual(pixel, ivec2(0))) || !all(lessThan(pixel, resolution))) { return false; }

    vec4 prevSurface0 = loadRestirTemporalHistoryLayer(pixel, !ADV_RESERVOIR_PING_INPUT, 0);
    if (!(prevSurface0.w > 0.5)) { return false; }

    vec4 prevSurface1 = loadRestirTemporalHistoryLayer(pixel, !ADV_RESERVOIR_PING_INPUT, 1);
    vec3 prevWorldPos = prevSurface0.xyz;
    vec3 prevNormal = normalizeF(prevSurface1.xyz, vec3(0.0, 1.0, 0.0));

    vec3 worldPosDelta = prevWorldPos - currentWorldPos;
    float planeDistance = abs(dot(worldPosDelta, currentNormal));
    float motionFactor = clamp(motionLength, 0.0, 2.0);
    float planeTolerance = ADV_TEMPORAL_REUSE_PLANE_DISTANCE_TOLERANCE + motionFactor * ADV_TEMPORAL_REUSE_PLANE_DISTANCE_MOTION_SCALE;
    if (planeDistance > planeTolerance) { return false; }

    vec3 tangentDelta = worldPosDelta - currentNormal * dot(worldPosDelta, currentNormal);
    float tangentDistance = length(tangentDelta);
    float viewDistance = distance(currentWorldPos, vec3(worldUBO.cameraPos.xyz));
    float worldPerPixel = directLightWorldPerPixel(viewDistance, resolution);
    float tangentTolerance =
        max(ADV_TEMPORAL_REUSE_MIN_TANGENT_TOLERANCE + motionFactor * ADV_TEMPORAL_REUSE_MIN_TANGENT_MOTION_SCALE,
            worldPerPixel *
                (ADV_TEMPORAL_REUSE_TANGENT_PIXEL_FOOTPRINT_SCALE + motionFactor * ADV_TEMPORAL_REUSE_TANGENT_PIXEL_FOOTPRINT_MOTION_SCALE));
    if (tangentDistance > tangentTolerance) { return false; }

    return dot(prevNormal, currentNormal) > ADV_TEMPORAL_REUSE_NORMAL_THRESHOLD;
}

bool tryLoadPreviousFrameReservoir(ivec2 pixel,
                                   ivec2 resolution,
                                   PrimarySurfaceCache cacheQ,
                                   out AreaLightReservoir reservoir) {
    reservoir = makeEmptyAreaLightReservoir();
    if (!ADV_RESERVOIR_HISTORY_READY) { return false; }

    vec3 currentWorldPos = stableTemporalHistoryWorldPos(cacheQ);
    vec3 currentNormal = stableTemporalHistoryNormal(cacheQ);
    vec2 motion = imageLoad(motionVectorImage, pixel).xy;
    vec2 prevPixelF = vec2(pixel) + motion;
    ivec2 prevPixel = ivec2(round(prevPixelF));
    if (!previousFramePixelMatches(prevPixel, resolution, currentWorldPos, currentNormal, length(motion))) {
        return false;
    }

    reservoir = decodeAreaLightReservoir(loadRestirLightReservoirLayer(prevPixel, !ADV_RESERVOIR_PING_INPUT, 0),
                                         loadRestirLightReservoirLayer(prevPixel, !ADV_RESERVOIR_PING_INPUT, 1),
                                         loadRestirLightReservoirLayer(prevPixel, !ADV_RESERVOIR_PING_INPUT, 2),
                                         loadRestirLightReservoirSource(prevPixel, !ADV_RESERVOIR_PING_INPUT));
    if (!(reservoir.valid > 0.5) || !areaLightReservoirSourceExists(reservoir)) {
        reservoir = makeEmptyAreaLightReservoir();
        return false;
    }
    return true;
}

DirectLightCameraRay buildDirectLightCameraRay(ivec2 pixel, vec2 resolution) {
    DirectLightCameraRay cameraRay = buildPrimaryViewDirectLightCameraRay(pixel, resolution);

    vec4 secondaryOriginState = loadSecondaryRayStateLayer(pixel, 0);
    vec4 secondaryDirectionState = loadSecondaryRayStateLayer(pixel, 1);
    return buildStoredDirectLightCameraRay(secondaryOriginState.xyz, secondaryDirectionState.xyz, cameraRay.coneSpread);
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    ivec2 resolution = imageSize(secondaryRayStateImage).xy;
    if (any(greaterThanEqual(q, resolution))) { return; }

    PrimarySurfaceCache cacheQ = loadSecondarySurfaceCache(q);
    if (!cacheQ.valid) {
        clearSurfaceHistory(q);
        storeAreaLightReservoir(q, makeEmptyAreaLightReservoir());
        return;
    }

    DirectLightCameraRay cameraRay = buildDirectLightCameraRay(q, vec2(resolution));
    DirectLightPreparedSurface prepared;
    prepareDirectLightSurface(cacheQ, cameraRay, prepared);
    DirectLightReuseQuery queryQ = buildDirectLightReuseQuery(prepared, cameraRay.viewDir);

    if (!queryQ.valid) {
        clearSurfaceHistory(q);
        storeAreaLightReservoir(q, makeEmptyAreaLightReservoir());
        return;
    }

    storeRestirTemporalHistoryLayer(q, ADV_RESERVOIR_PING_INPUT, 0, vec4(stableTemporalHistoryWorldPos(cacheQ), 1.0));
    storeRestirTemporalHistoryLayer(q, ADV_RESERVOIR_PING_INPUT, 1, vec4(stableTemporalHistoryNormal(cacheQ), 0.0));

    AreaLightReservoir cur = loadAreaLightReservoir(q);
    AreaLightReservoir prev;
    bool hasPrev = tryLoadPreviousFrameReservoir(q, resolution, cacheQ, prev);

    float curTarget = evaluateReservoirTargetAtQuery(cur, queryQ, cacheQ);
    float prevTarget = hasPrev ? evaluateReservoirTargetAtQuery(prev, queryQ, cacheQ) : 0.0;
    float temporalSampleCountCap = max(float(ADV_TEMPORAL_CONFIDENCE_CAP), 0.0);
    float temporalHistoryCarryCap = max(0.25 * temporalSampleCountCap, 1.0);
    float curConfidence = cur.contributionWeight > 1e-8 ? areaLightReservoirSampleCount(cur) : 0.0;
    float prevConfidence = prev.contributionWeight > 1e-8 ? areaLightReservoirSampleCount(prev) : 0.0;
    float curMergeCount = curConfidence;
    float prevMergeCount = min(prevConfidence, temporalHistoryCarryCap);
    float sampleCountSum = curMergeCount + prevMergeCount;
    if (temporalSampleCountCap > 1e-8 && sampleCountSum > temporalSampleCountCap) {
        float countScale = temporalSampleCountCap / sampleCountSum;
        curMergeCount *= countScale;
        prevMergeCount *= countScale;
        sampleCountSum = temporalSampleCountCap;
    }

    AreaLightRisState r = makeAreaLightRisState();
    if (!(sampleCountSum > 1e-8)) {
        storeAreaLightReservoir(q, makeEmptyAreaLightReservoir());
        return;
    }

    uint seed = xxhash32(uvec3(uint(q.x), uint(q.y), worldUBO.seed ^ 0x19A5E2C7u));

    if (curMergeCount > 1e-8 && curTarget > 1e-8) {
        float w = curMergeCount * curTarget * cur.contributionWeight;
        areaLightRisAddSample(r, areaLightSampleFromReservoir(cur, curTarget), w, seed);
    }

    if (prevMergeCount > 1e-8 && prevTarget > 1e-8) {
        float w = prevMergeCount * prevTarget * prev.contributionWeight;
        areaLightRisAddSample(r, areaLightSampleFromReservoir(prev, prevTarget), w, seed);
    }

    AreaLightReservoir temporalReused = areaLightReservoirFromRis(r, sampleCountSum, sampleCountSum);
    storeAreaLightReservoir(q, temporalReused);
}
