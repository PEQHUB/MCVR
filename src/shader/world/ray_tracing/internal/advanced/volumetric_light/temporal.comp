#version 460
#extension GL_GOOGLE_include_directive : require

#include "common/shared.hpp"
#include "common/runtime_texture_arrays.glsl"
#include "util/random.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#ifndef ADV_VOLUMETRIC_LIGHT_DOWNSAMPLE_FACTOR
#    define ADV_VOLUMETRIC_LIGHT_DOWNSAMPLE_FACTOR 2
#endif

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};

layout(set = 3, binding = 4, rg16f) uniform readonly image2D motionVectorImage;
layout(set = 5, binding = 18, rgba16f) uniform readonly image2D volumetricLightRawImage;
layout(set = 5, binding = 29, rgba16f) uniform image2D volumetricLightTemporalImage;

bool finiteFloat(float value) {
    return !isnan(value) && !isinf(value);
}

bool finiteVec3(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

float depthCompatibility(float centerDepth, float sampleDepth) {
    bool centerSky = centerDepth >= INF_DISTANCE * 0.5;
    bool sampleSky = sampleDepth >= INF_DISTANCE * 0.5;
    if (centerSky || sampleSky) { return centerSky == sampleSky ? 1.0 : 0.0; }
    if (sampleDepth <= 0.0) { return 0.0; }
    float depthSigma = max(centerDepth * 0.12, 2.0);
    return exp(-abs(sampleDepth - centerDepth) / depthSigma);
}

void neighborhoodBounds(ivec2 pixel, ivec2 resolution, float centerDepth, out vec3 minValue, out vec3 maxValue) {
    vec3 centerValue = max(imageLoad(volumetricLightRawImage, pixel).rgb, vec3(0.0));
    minValue = centerValue;
    maxValue = centerValue;

    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 samplePixel = clamp(pixel + ivec2(x, y), ivec2(0), resolution - ivec2(1));
            vec4 sampleValue = imageLoad(volumetricLightRawImage, samplePixel);
            if (depthCompatibility(centerDepth, sampleValue.a) <= 0.1) { continue; }

            vec3 radiance = max(sampleValue.rgb, vec3(0.0));
            minValue = min(minValue, radiance);
            maxValue = max(maxValue, radiance);
        }
    }
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 resolution = imageSize(volumetricLightTemporalImage);
    if (any(greaterThanEqual(pixel, resolution))) { return; }

    vec4 current = imageLoad(volumetricLightRawImage, pixel);
    float currentDepth = current.a;
    if (!finiteFloat(currentDepth) || currentDepth <= 0.0) {
        imageStore(volumetricLightTemporalImage, pixel, vec4(0.0));
        imageStore(volumetricLightHistoryImage, rtArrayCoord(pixel, ADV_VOLUMETRIC_LIGHT_HISTORY_PING_INPUT ? 1 : 0),
                   vec4(0.0));
        return;
    }

    vec3 currentRadiance = finiteVec3(current.rgb) ? max(current.rgb, vec3(0.0)) : vec3(0.0);
    vec3 accumulatedRadiance = currentRadiance;

    ivec2 fullResolution = imageSize(motionVectorImage);
    int downsampleFactor = max(int(ADV_VOLUMETRIC_LIGHT_DOWNSAMPLE_FACTOR), 1);
    ivec2 baseFullPixel = pixel * downsampleFactor;
    uint offsetSeed = xxhash32(uvec3(uint(pixel.x), uint(pixel.y), worldUBO.seed ^ 0x6A09E667u));
    uint downsampleFactorU = uint(max(downsampleFactor, 1));
    ivec2 selectedOffset = ivec2(int(offsetSeed % downsampleFactorU), int((offsetSeed / downsampleFactorU) % downsampleFactorU));
    ivec2 fullPixel = clamp(baseFullPixel + selectedOffset, ivec2(0), fullResolution - ivec2(1));
    vec2 motion = imageLoad(motionVectorImage, fullPixel).xy;
    vec2 prevFullPixel = vec2(fullPixel) + vec2(0.5) + motion;
    vec2 prevLowPixelF = prevFullPixel / float(downsampleFactor) - vec2(0.5);
    ivec2 prevLowPixel = ivec2(round(prevLowPixelF));

    if (ADV_VOLUMETRIC_LIGHT_HISTORY_READY && all(greaterThanEqual(prevLowPixel, ivec2(0))) &&
        all(lessThan(prevLowPixel, resolution))) {
        vec4 history =
            imageLoad(volumetricLightHistoryImage, rtArrayCoord(prevLowPixel, ADV_VOLUMETRIC_LIGHT_HISTORY_PING_INPUT ? 0 : 1));
        float historyDepth = history.a;
        float historyDepthWeight = depthCompatibility(currentDepth, historyDepth);
        if (historyDepthWeight > 0.1 && finiteVec3(history.rgb)) {
            vec3 neighborhoodMin;
            vec3 neighborhoodMax;
            neighborhoodBounds(pixel, resolution, currentDepth, neighborhoodMin, neighborhoodMax);

            vec3 clampPadding = max(vec3(0.02), (neighborhoodMax - neighborhoodMin) * 0.10);
            vec3 clampedHistory = clamp(history.rgb, neighborhoodMin - clampPadding, neighborhoodMax + clampPadding);

            float motionLength = length(motion) / float(max(downsampleFactor, 1));
            float historyWeight = mix(0.95, 0.72, smoothstep(0.0, 4.0, motionLength));
            historyWeight *= historyDepthWeight;
            accumulatedRadiance = mix(currentRadiance, max(clampedHistory, vec3(0.0)), clamp(historyWeight, 0.0, 0.97));
        }
    }

    if (!finiteVec3(accumulatedRadiance)) { accumulatedRadiance = currentRadiance; }
    imageStore(volumetricLightTemporalImage, pixel, vec4(accumulatedRadiance, currentDepth));
    imageStore(volumetricLightHistoryImage, rtArrayCoord(pixel, ADV_VOLUMETRIC_LIGHT_HISTORY_PING_INPUT ? 1 : 0),
               vec4(accumulatedRadiance, currentDepth));
}
