#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#ifndef ADV_VOL_BLUR_HORIZONTAL
#    define ADV_VOL_BLUR_HORIZONTAL 1
#endif
#ifndef ADV_VOL_BLUR_INPUT_BINDING
#    define ADV_VOL_BLUR_INPUT_BINDING 18
#endif
#ifndef ADV_VOL_BLUR_OUTPUT_BINDING
#    define ADV_VOL_BLUR_OUTPUT_BINDING 19
#endif

layout(set = 5, binding = ADV_VOL_BLUR_INPUT_BINDING, rgba16f) uniform readonly image2D inputImage;
layout(set = 5, binding = ADV_VOL_BLUR_OUTPUT_BINDING, rgba16f) uniform image2D outputImage;

bool finiteVec3(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

float depthCompatibility(float centerDepth, float sampleDepth) {
    bool centerSky = centerDepth >= 32752.0;
    bool sampleSky = sampleDepth >= 32752.0;
    if (centerSky || sampleSky) { return centerSky == sampleSky ? 1.0 : 0.0; }
    float depthSigma = max(centerDepth * 0.10, 2.0);
    return exp(-abs(sampleDepth - centerDepth) / depthSigma);
}

float gaussianWeight(int offset) {
    int a = abs(offset);
    if (a == 0) { return 0.22702703; }
    if (a == 1) { return 0.19459459; }
    if (a == 2) { return 0.12162162; }
    if (a == 3) { return 0.05405405; }
    return 0.01621622;
}

vec4 loadClamped(ivec2 pixel, ivec2 resolution) {
    return imageLoad(inputImage, clamp(pixel, ivec2(0), resolution - ivec2(1)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 resolution = imageSize(outputImage);
    if (any(greaterThanEqual(pixel, resolution))) { return; }

    vec4 center = imageLoad(inputImage, pixel);
    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    ivec2 axis = ADV_VOL_BLUR_HORIZONTAL != 0 ? ivec2(1, 0) : ivec2(0, 1);
    float centerDepth = center.a;

    for (int i = -4; i <= 4; ++i) {
        vec4 sampleValue = loadClamped(pixel + axis * i, resolution);
        float depthWeight = depthCompatibility(centerDepth, sampleValue.a);
        float weight = gaussianWeight(i) * depthWeight;
        sum += sampleValue.rgb * weight;
        weightSum += weight;
    }

    vec3 radiance = weightSum > 1e-6 ? sum / weightSum : center.rgb;
    if (!finiteVec3(radiance)) { radiance = vec3(0.0); }
    imageStore(outputImage, pixel, vec4(max(radiance, vec3(0.0)), centerDepth));
}
