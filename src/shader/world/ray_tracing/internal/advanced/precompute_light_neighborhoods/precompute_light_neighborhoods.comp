#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common/shared.hpp"
#include "common/light.glsl"
#include "common/light_neighborhood.glsl"
#include "common/constants.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};

void clearChunkNeighborhood(uint chunkIndex) {
    chunkLightNeighborhoods[chunkIndex].header = uvec4(0u);
    for (int i = 0; i < ADV_CHUNK_NEIGHBORHOOD_CAPACITY; ++i) {
        chunkLightNeighborhoods[chunkIndex].entries[i] =
            ChunkLightNeighborhoodEntry(0u, 0u, 0.0, 0.0);
    }
}

void buildLocalAliasTable(int count,
                          const float weights[ADV_CHUNK_NEIGHBORHOOD_CAPACITY],
                          out float probs[ADV_CHUNK_NEIGHBORHOOD_CAPACITY],
                          out uint aliases[ADV_CHUNK_NEIGHBORHOOD_CAPACITY]) {
    for (int i = 0; i < ADV_CHUNK_NEIGHBORHOOD_CAPACITY; ++i) {
        probs[i] = 1.0;
        aliases[i] = uint(i);
    }
    if (count <= 0) { return; }

    float totalWeight = 0.0;
    for (int i = 0; i < count; ++i) {
        totalWeight += weights[i];
    }
    if (totalWeight <= 1e-8) { return; }

    float scaledWeights[ADV_CHUNK_NEIGHBORHOOD_CAPACITY];
    int smallStack[ADV_CHUNK_NEIGHBORHOOD_CAPACITY];
    int largeStack[ADV_CHUNK_NEIGHBORHOOD_CAPACITY];
    int smallCount = 0;
    int largeCount = 0;

    for (int i = 0; i < count; ++i) {
        scaledWeights[i] = weights[i] * float(count) / totalWeight;
        if (scaledWeights[i] < 1.0) {
            smallStack[smallCount++] = i;
        } else {
            largeStack[largeCount++] = i;
        }
    }

    while (smallCount > 0 && largeCount > 0) {
        int less = smallStack[--smallCount];
        int more = largeStack[--largeCount];

        probs[less] = clamp(scaledWeights[less], 0.0, 1.0);
        aliases[less] = uint(more);
        scaledWeights[more] = (scaledWeights[more] + scaledWeights[less]) - 1.0;

        if (scaledWeights[more] < 1.0) {
            smallStack[smallCount++] = more;
        } else {
            largeStack[largeCount++] = more;
        }
    }

    while (largeCount > 0) {
        int index = largeStack[--largeCount];
        probs[index] = 1.0;
        aliases[index] = uint(index);
    }

    while (smallCount > 0) {
        int index = smallStack[--smallCount];
        probs[index] = 1.0;
        aliases[index] = uint(index);
    }
}

void main() {
    uint chunkCount = uint(max(worldUBO.chunkGridInfo.x * worldUBO.chunkGridInfo.y * worldUBO.chunkGridInfo.z, 0));
    uint chunkIndex = gl_GlobalInvocationID.x;
    if (chunkIndex >= chunkCount) { return; }

    ChunkLightData centerChunk = chunkPackedData[chunkIndex];
    ivec3 centerOrigin = ivec3(centerChunk.x, centerChunk.y, centerChunk.z);
    ivec3 centerSectionCoord = centerOrigin / 16;

    if (centerChunk.geometryCount == 0u || any(notEqual(getSectionOriginFromSectionCoordinate(centerSectionCoord), centerOrigin))) {
        clearChunkNeighborhood(chunkIndex);
        return;
    }

    int resolvedChunkIndex = -1;
    ivec3 resolvedChunkOrigin = ivec3(0);
    if (!tryGetChunkIndexFromSectionCoordinate(centerSectionCoord, worldUBO, resolvedChunkIndex, resolvedChunkOrigin) ||
        resolvedChunkIndex != int(chunkIndex) || any(notEqual(resolvedChunkOrigin, centerOrigin))) {
        clearChunkNeighborhood(chunkIndex);
        return;
    }

    int neighborChunkIndices[ADV_CHUNK_NEIGHBORHOOD_CAPACITY];
    float neighborWeights[ADV_CHUNK_NEIGHBORHOOD_CAPACITY];
    float neighborAliasProb[ADV_CHUNK_NEIGHBORHOOD_CAPACITY];
    uint neighborAliasIndex[ADV_CHUNK_NEIGHBORHOOD_CAPACITY];
    int neighborCount = 0;
    float neighborTotalWeight = 0.0;

    for (int dz = -ADV_EMISSION_RADIUS_XZ; dz <= ADV_EMISSION_RADIUS_XZ; ++dz) {
        for (int dy = -ADV_EMISSION_RADIUS_Y; dy <= ADV_EMISSION_RADIUS_Y; ++dy) {
            for (int dx = -ADV_EMISSION_RADIUS_XZ; dx <= ADV_EMISSION_RADIUS_XZ; ++dx) {
                ivec3 neighborSectionCoord = centerSectionCoord + ivec3(dx, dy, dz);
                int neighborChunkIndex = -1;
                ivec3 neighborChunkOrigin = ivec3(0);
                if (!tryGetChunkIndexFromSectionCoordinate(neighborSectionCoord, worldUBO, neighborChunkIndex,
                                                           neighborChunkOrigin)) {
                    continue;
                }

                ChunkLightData neighborChunk = chunkPackedData[neighborChunkIndex];
                if (!chunkPackedDataMatchesOrigin(neighborChunk, neighborChunkOrigin)) { continue; }
                if (!chunkPackedDataHasLights(neighborChunk)) { continue; }

                neighborChunkIndices[neighborCount] = neighborChunkIndex;
                neighborWeights[neighborCount] = float(neighborChunk.lightCount);
                neighborTotalWeight += neighborWeights[neighborCount];
                neighborCount++;
            }
        }
    }

    clearChunkNeighborhood(chunkIndex);
    if (neighborCount <= 0 || neighborTotalWeight <= 1e-8) { return; }

    buildLocalAliasTable(neighborCount, neighborWeights, neighborAliasProb, neighborAliasIndex);

    chunkLightNeighborhoods[chunkIndex].header = uvec4(uint(neighborCount), 0u, 0u, 0u);
    for (int i = 0; i < ADV_CHUNK_NEIGHBORHOOD_CAPACITY; ++i) {
        if (i < neighborCount) {
            chunkLightNeighborhoods[chunkIndex].entries[i] =
                ChunkLightNeighborhoodEntry(uint(neighborChunkIndices[i]), neighborAliasIndex[i],
                                            neighborWeights[i] / neighborTotalWeight, neighborAliasProb[i]);
        } else {
            chunkLightNeighborhoods[chunkIndex].entries[i] = ChunkLightNeighborhoodEntry(0u, 0u, 0.0, 0.0);
        }
    }
}
