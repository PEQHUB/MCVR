#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common/shared.hpp"
#include "common/chunk_lookup.glsl"
#include "common/light.glsl"
#include "util/disney.glsl"
#include "util/alpha_mode.glsl"
#include "common/fft_water.glsl"
#include "util/height_map.glsl"
#include "util/random.glsl"
#include "util/ray.glsl"
#include "util/ray_cone.glsl"
#include "util/util.glsl"
#include "common/first_hit_state.glsl"
#define ADV_RUNTIME_PRIMARY_SECONDARY_READONLY 1
#include "common/runtime_primary_secondary_arrays.glsl"
#undef ADV_RUNTIME_PRIMARY_SECONDARY_READONLY
#include "common/runtime_texture_arrays.glsl"

layout(set = 0, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;

layout(set = 1, binding = 7) readonly buffer TextureMappingBuffer {
    TextureMapping mapping;
};

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};

#define AREA_LIGHT_RESERVOIR_LOAD_RAW0(pixel) loadRestirLightReservoirLayer(pixel, ADV_RESERVOIR_PING_INPUT, 0)
#define AREA_LIGHT_RESERVOIR_LOAD_RAW1(pixel) loadRestirLightReservoirLayer(pixel, ADV_RESERVOIR_PING_INPUT, 1)
#define AREA_LIGHT_RESERVOIR_LOAD_RAW2(pixel) loadRestirLightReservoirLayer(pixel, ADV_RESERVOIR_PING_INPUT, 2)
#define AREA_LIGHT_RESERVOIR_STORE_RAW0(pixel, value) storeRestirLightReservoirLayer(pixel, ADV_RESERVOIR_PING_INPUT, 0, value)
#define AREA_LIGHT_RESERVOIR_STORE_RAW1(pixel, value) storeRestirLightReservoirLayer(pixel, ADV_RESERVOIR_PING_INPUT, 1, value)
#define AREA_LIGHT_RESERVOIR_STORE_RAW2(pixel, value) storeRestirLightReservoirLayer(pixel, ADV_RESERVOIR_PING_INPUT, 2, value)
#define AREA_LIGHT_RESERVOIR_LOAD_SOURCE_RAW(pixel) loadRestirLightReservoirSource(pixel, ADV_RESERVOIR_PING_INPUT)
#define AREA_LIGHT_RESERVOIR_STORE_SOURCE_RAW(pixel, value) storeRestirLightReservoirSource(pixel, ADV_RESERVOIR_PING_INPUT, value)

layout(location = 1) rayPayloadEXT ShadowRay shadowRay;

#define CONST_ONLY
#include "util/vertex.glsl"

#include "common/surface_eval.glsl"
#define ADV_DIRECT_LIGHT_SURFACE_HAS_SECONDARY_CACHE 1
#define ADV_EVALUATE_HEIGHT_MAP 1
#include "common/direct_light_surface.glsl"
#include "common/direct_light_reservoir.glsl"
#include "common/direct_light_visibility.glsl"

DirectLightCameraRay buildDirectLightCameraRay(ivec2 pixel, vec2 resolution) {
    DirectLightCameraRay cameraRay = buildPrimaryViewDirectLightCameraRay(pixel, resolution);

    vec4 secondaryOriginState = loadSecondaryRayStateLayer(pixel, 0);
    vec4 secondaryDirectionState = loadSecondaryRayStateLayer(pixel, 1);
    return buildStoredDirectLightCameraRay(secondaryOriginState.xyz, secondaryDirectionState.xyz, cameraRay.coneSpread);
}

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);

    vec4 throughputState = loadSecondaryRayStateLayer(pixel, 2);
    uint flags = decodeFirstHitFlags(throughputState.w);
    if (hasFirstHitFlag(flags, ADV_FIRST_HIT_FLAG_HIT_SKY) || !hasFirstHitFlag(flags, ADV_FIRST_HIT_FLAG_NOISY)) { return; }

    PrimarySurfaceCache cache = loadSecondarySurfaceCache(pixel);
    AreaLightReservoir reservoir = loadAreaLightReservoir(pixel);
    if (!cache.valid || !(reservoir.valid > 0.5)) { return; }

    DirectLightCameraRay cameraRay = buildDirectLightCameraRay(pixel, vec2(gl_LaunchSizeEXT.xy));
    DirectLightPreparedSurface prepared;
    prepareDirectLightSurface(cache, cameraRay, prepared);
    if (!directLightPreparedSurfaceEligible(prepared)) {
        storeAreaLightReservoir(pixel, makeEmptyAreaLightReservoir());
        return;
    }

    vec3 transmission = traceAreaLightReservoirTransmission(
        prepared.surface, prepared.referenceUv, prepared.referenceWorldPos, prepared.atlasUvMin, prepared.atlasUvMax,
        prepared.dPduWorld, prepared.dPdvWorld, prepared.baseGeoNormal, prepared.traceLocalHeight,
        prepared.normalTextureID, prepared.maxDepthWorld, reservoir.point, reservoir.normal,
        hasFirstHitFlag(flags, ADV_FIRST_HIT_FLAG_INSIDE_BOAT));
    float visibility = max(max(transmission.x, transmission.y), transmission.z);
    if (visibility <= 1e-8) {
        storeAreaLightReservoir(pixel, makeEmptyAreaLightReservoir());
        return;
    }
    storeAreaLightReservoir(pixel, reservoir);
}
