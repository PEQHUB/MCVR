#include "util/random.glsl"
#include "util/ray_cone.glsl"
#include "util/ray.glsl"
#include "util/sampling_helpers.glsl"
#include "util/util.glsl"
#include "common/first_hit_state.glsl"
#define ADV_RUNTIME_PRIMARY_SECONDARY_READONLY 1
#include "common/runtime_primary_secondary_arrays.glsl"
#undef ADV_RUNTIME_PRIMARY_SECONDARY_READONLY
#include "common/runtime_texture_arrays.glsl"

layout(set = 0, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;

layout(set = 1, binding = 7) readonly buffer TextureMappingBuffer {
    TextureMapping mapping;
};

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};

layout(set = 2, binding = 2) uniform SkyUniform {
    SkyUBO skyUBO;
};

layout(set = 3, binding = 8, rgba16f) uniform image2D firstHitDiffuseDirectLightImage;
layout(set = 5, binding = 0) uniform sampler2D transLUT;
layout(set = 5, binding = 2) uniform samplerCube skyFull;

#define AREA_LIGHT_RESERVOIR_LOAD_RAW0(pixel) loadRestirLightReservoirLayer(pixel, !ADV_RESERVOIR_PING_INPUT, 0)
#define AREA_LIGHT_RESERVOIR_LOAD_RAW1(pixel) loadRestirLightReservoirLayer(pixel, !ADV_RESERVOIR_PING_INPUT, 1)
#define AREA_LIGHT_RESERVOIR_LOAD_RAW2(pixel) loadRestirLightReservoirLayer(pixel, !ADV_RESERVOIR_PING_INPUT, 2)
#define AREA_LIGHT_RESERVOIR_STORE_RAW0(pixel, value) storeRestirLightReservoirLayer(pixel, !ADV_RESERVOIR_PING_INPUT, 0, value)
#define AREA_LIGHT_RESERVOIR_STORE_RAW1(pixel, value) storeRestirLightReservoirLayer(pixel, !ADV_RESERVOIR_PING_INPUT, 1, value)
#define AREA_LIGHT_RESERVOIR_STORE_RAW2(pixel, value) storeRestirLightReservoirLayer(pixel, !ADV_RESERVOIR_PING_INPUT, 2, value)
#define AREA_LIGHT_RESERVOIR_LOAD_SOURCE_RAW(pixel) loadRestirLightReservoirSource(pixel, !ADV_RESERVOIR_PING_INPUT)
#define AREA_LIGHT_RESERVOIR_STORE_SOURCE_RAW(pixel, value) storeRestirLightReservoirSource(pixel, !ADV_RESERVOIR_PING_INPUT, value)

layout(location = 0) rayPayloadEXT MainRay mainRay;
layout(location = 1) rayPayloadEXT ShadowRay shadowRay;

#define CONST_ONLY
#include "util/vertex.glsl"

#include "common/surface_eval.glsl"
#define ADV_DIRECT_LIGHT_SURFACE_HAS_SECONDARY_CACHE 1
#define ADV_EVALUATE_HEIGHT_MAP 1
#include "common/direct_light_surface.glsl"
#include "common/direct_light_reservoir.glsl"
#include "common/direct_light_visibility.glsl"
#include "common/volumetric_cloud.glsl"
#include "common/direct_light_eval.glsl"

vec3 computeWaterDepthTransmittance(float waterDistance) {
    if (waterDistance <= 1e-4) { return vec3(1.0); }

    const vec3 waterTint = vec3(0.0, 0.48, 0.65);
    return exp(-(vec3(1.0) - waterTint) * waterDistance * 0.22);
}

DirectLightCameraRay buildDirectLightCameraRay(ivec2 pixel, vec2 resolution) {
    DirectLightCameraRay cameraRay = buildPrimaryViewDirectLightCameraRay(pixel, resolution);

    vec4 secondaryOriginState = loadSecondaryRayStateLayer(pixel, 0);
    vec4 secondaryDirectionState = loadSecondaryRayStateLayer(pixel, 1);
    return buildStoredDirectLightCameraRay(secondaryOriginState.xyz, secondaryDirectionState.xyz, cameraRay.coneSpread);
}

vec3 directLightViewTransmittance(ivec2 pixel,
                                  DirectLightCameraRay cameraRay,
                                  DirectLightPreparedSurface prepared,
                                  vec3 pathThroughput) {
    vec3 transmittance = pathThroughput;
    if (ADV_WATER_SURFACE_MODE != 1u) { return transmittance; }

    vec4 secondaryDirectionState = loadSecondaryRayStateLayer(pixel, 1);
    uint firstHitLobeType = uint(max(secondaryDirectionState.w + 0.5, 0.0));
    if (firstHitLobeType != 2u) { return transmittance; }

    vec4 secondaryAuxState = loadSecondaryRayStateLayer(pixel, 3);
    bool isWaterSurface = secondaryAuxState.y > 0.5;
    if (!isWaterSurface) { return transmittance; }

    float waterDistance = distance(prepared.surface.worldPos, cameraRay.origin);
    return transmittance * computeWaterDepthTransmittance(waterDistance);
}

void initDirectLightRay(vec3 origin, vec3 direction, uint seed, float coneSpread, bool insideBoat) {
    mainRay.origin = origin;
    mainRay.hitT = 0.0;
    mainRay.direction = direction;
    mainRay.seed = xxhash32(uvec3(gl_LaunchIDEXT.x, gl_LaunchIDEXT.y, seed));
    mainRay.radiance = vec3(0.0);
    mainRay.coneWidth = 0.0;
    mainRay.throughput = vec3(1.0);
    mainRay.coneSpread = coneSpread;
    mainRay.stateBits = 0u;
    raySetBounce(mainRay, 0u);
    raySetInsideBoat(mainRay, insideBoat);
    raySetStop(mainRay, false);
    raySetContinue(mainRay, false);
    raySetNoisy(mainRay, true);
    raySetSkipFog(mainRay, false);
    raySetLobeType(mainRay, 0u);
    mainRay.prevScenePos = vec3(0.0);
    mainRay.hasPrevScenePos = 0u;
    mainRay.normal = vec3(0.0);
    mainRay.directLightRadiance = vec3(0.0);
    mainRay.pad0 = 0u;
}

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);

    vec4 throughputState = loadSecondaryRayStateLayer(pixel, 2);
    uint flags = decodeFirstHitFlags(throughputState.w);
    if (hasFirstHitFlag(flags, ADV_FIRST_HIT_FLAG_HIT_SKY) || !hasFirstHitFlag(flags, ADV_FIRST_HIT_FLAG_NOISY)) {
        imageStore(firstHitDiffuseDirectLightImage, pixel, vec4(vec3(0.0), 0.0));
        return;
    }

    PrimarySurfaceCache cache = loadSecondarySurfaceCache(pixel);
    if (!cache.valid) {
        imageStore(firstHitDiffuseDirectLightImage, pixel, vec4(vec3(0.0), 0.0));
        return;
    }

    vec2 resolution = vec2(gl_LaunchSizeEXT.xy);
    DirectLightCameraRay cameraRay = buildDirectLightCameraRay(pixel, resolution);

    initDirectLightRay(cameraRay.origin, cameraRay.direction, worldUBO.seed ^ 0xA511E9B3u, cameraRay.coneSpread,
                       hasFirstHitFlag(flags, ADV_FIRST_HIT_FLAG_INSIDE_BOAT));
    vec4 secondaryAuxState = loadSecondaryRayStateLayer(pixel, 3);
    rayStoreAux(mainRay, secondaryAuxState.xy);
    DirectLightPreparedSurface prepared;
    prepareDirectLightSurface(cache, cameraRay, prepared);
    if (!directLightPreparedSurfaceEligible(prepared)) {
        imageStore(firstHitDiffuseDirectLightImage, pixel, vec4(vec3(0.0), 0.0));
        return;
    }

    vec3 areaLight = vec3(0.0);
    if (ADV_ENABLE_RESTIR != 0) {
        AreaLightReservoir reservoir = loadAreaLightReservoir(pixel);
        areaLight = shadeStoredAreaLightReservoir(
            prepared.surface, cameraRay.viewDir, prepared.referenceUv, prepared.referenceWorldPos,
            prepared.atlasUvMin, prepared.atlasUvMax, prepared.dPduWorld, prepared.dPdvWorld,
            prepared.baseGeoNormal, prepared.traceLocalHeight, prepared.normalTextureID, prepared.maxDepthWorld,
            reservoir);
    }
    vec3 directionalLight = sampleSurfaceDirectionalLight(
        prepared.surface, cameraRay.viewDir, prepared.referenceUv, prepared.referenceWorldPos, prepared.atlasUvMin,
        prepared.atlasUvMax, prepared.dPduWorld, prepared.dPdvWorld, prepared.baseGeoNormal, prepared.traceLocalHeight,
        prepared.normalTextureID, prepared.maxDepthWorld, prepared.isFftWaterSurface);
    vec3 directRadiance = areaLight + directionalLight;
    directRadiance *= directLightViewTransmittance(pixel, cameraRay, prepared, throughputState.rgb);
    if (any(isnan(directRadiance)) || any(isinf(directRadiance))) { directRadiance = vec3(0.0); }

    imageStore(firstHitDiffuseDirectLightImage, pixel, vec4(max(directRadiance, 0.0), 1.0));
}
