#version 460

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D inputReservoirImage;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D outputReservoirImage;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D directLightOutputImage;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D firstHitDiffuseDirectLightImage;

layout(set = 0, binding = 3) buffer DirectLightCounters {
    uint counters[];
} directLightCounters;

layout(push_constant) uniform PushConstant {
    int width;
    int height;
    int mode;
    int _pad0;
} pc;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

vec4 loadReservoirClamped(ivec2 pixel) {
    ivec2 p = clamp(pixel, ivec2(0), ivec2(pc.width - 1, pc.height - 1));
    return imageLoad(inputReservoirImage, p);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }

    vec4 center = imageLoad(inputReservoirImage, pixel);
    bool valid = center.a > 0.0;
    vec4 result = center;

    if (pc.mode == 1) {
        if (valid) {
            atomicAdd(directLightCounters.counters[2], 1u);
        }
    } else if (pc.mode == 2) {
        vec3 sum = valid ? center.rgb : vec3(0.0);
        float weight = valid ? 1.0 : 0.0;
        int taps = 0;

        const ivec2 offsets[4] = ivec2[4](
            ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
        for (int i = 0; i < 4; ++i) {
            vec4 sampleReservoir = loadReservoirClamped(pixel + offsets[i]);
            if (sampleReservoir.a > 0.0) {
                sum += sampleReservoir.rgb;
                weight += 1.0;
                taps++;
            }
        }

        if (weight > 0.0) {
            result = vec4(sum / weight, 1.0);
            atomicAdd(directLightCounters.counters[3], uint(taps));
        } else {
            result = vec4(0.0);
        }
    } else if (pc.mode == 3) {
        if (valid) {
            atomicAdd(directLightCounters.counters[4], 1u);
        }
    } else if (pc.mode == 4) {
        if (valid) {
            atomicAdd(directLightCounters.counters[6], 1u);
        }
        imageStore(directLightOutputImage, pixel, result);
        imageStore(firstHitDiffuseDirectLightImage, pixel, vec4(max(result.rgb, vec3(0.0)), valid ? 1.0 : 0.0));
    }

    imageStore(outputReservoirImage, pixel, result);
}
